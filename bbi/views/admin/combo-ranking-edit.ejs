<%- include('layout-top') %>

<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px">
  <div>
    <a href="/admin/pages" style="color:#666;font-size:14px;text-decoration:none"><i class="ti ti-arrow-left"></i> Back to Pages & SEO</a>
  </div>
  <a href="/rankings/<%= city.slug %>/<%= cat.slug %>" target="_blank" class="btn btn-outline"><i class="ti ti-external-link"></i> View Live Page</a>
</div>

<% if(flash.success && flash.success.length) { %><div class="alert alert-success"><%= flash.success %></div><% } %>
<% if(flash.error && flash.error.length) { %><div class="alert alert-error"><%= flash.error %></div><% } %>

<div class="form-card" style="margin-bottom:24px">
  <h3>Override AI Rankings for <%= cat.name %> in <%= city.name %></h3>
  <p style="font-size:13px;color:#666">
    By default, businesses are ranked by their final AI score. If you assign a <strong>strict rank</strong> (e.g. 1, 2, 3) to a business, it will be forcefully pinned to that position. Businesses without a strict rank will be sorted by their score below the pinned businesses. Leave empty to remove override.
  </p>
</div>

<div class="table-wrap">
  <table>
    <thead><tr><th>AI Rank Pos.</th><th>Strict Rank</th><th>Business</th><th>AI Score</th><th>Boost</th><th>Action</th></tr></thead>
    <tbody>
      <% businesses.forEach((b, index) => { %>
      <tr style="<%= b.strict_rank !== null ? 'background:#f0fdf4' : '' %>">
        <td style="color:#666">#<%= index + 1 %></td>
        <td>
          <form method="POST" action="/admin/combo-rankings/<%= city.id %>/<%= cat.id %>/update" style="display:flex;gap:8px">
            <input type="hidden" name="business_id" value="<%= b.id %>">
            <input type="number" name="strict_rank" value="<%= b.strict_rank !== null ? b.strict_rank : '' %>" placeholder="Auto" style="width:70px;padding:4px 8px;border:1px solid #ccc;border-radius:4px" min="1">
            <button type="submit" class="btn btn-outline btn-sm">Save</button>
          </form>
        </td>
        <td><strong><%= b.name %></strong></td>
        <td><%= b.final_score ? Math.round(b.final_score) : 'N/A' %></td>
        <td><span class="badge <%= b.manual_boost ? 'badge-gold' : 'badge-gray' %>">+<%= b.manual_boost || 0 %></span></td>
        <td>
          <a href="/admin/businesses/<%= b.id %>/edit" class="btn btn-sm btn-outline"><i class="ti ti-edit"></i> Edit Business</a>
        </td>
      </tr>
      <% }) %>
      <% if(businesses.length === 0) { %>
      <tr><td colspan="6" style="text-align:center;padding:24px;color:#666">No active businesses found for this category and city.</td></tr>
      <% } %>
    </tbody>
  </table>
</div>

<%- include('layout-bottom') %>
