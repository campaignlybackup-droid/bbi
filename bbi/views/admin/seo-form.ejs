<%- include('layout-top') %>

<% if(flash.error) { %><div class="alert alert-error"><%= flash.error %></div><% } %>

<form method="POST" action="/admin/seo/<%= combo ? `combo/${combo.cityId}/${combo.catId}` : `${type}/${entity.id}` %>">
  <div style="display:grid;grid-template-columns:2fr 1fr;gap:16px">

    <div>
      <div class="form-card">
        <h3>SEO Meta Data</h3>
        <div class="form-group">
          <label>Page Title</label>
          <input type="text" name="title" id="seoTitle" value="<%= seoContent.title %>" required>
        </div>
        <div class="form-group">
          <label>Meta Description</label>
          <textarea name="meta_description" id="seoMeta" rows="2" style="resize:vertical"><%= seoContent.meta_description %></textarea>
        </div>
      </div>

      <div class="form-card">
        <h3>Page Content</h3>
        <div class="form-group">
          <label>Editorial Content (HTML allowed)</label>
          <textarea name="editorial_content" id="seoEditorial" rows="6" style="resize:vertical"><%= seoContent.editorial_content %></textarea>
          <div style="font-size:11px;color:var(--text-muted);margin-top:4px">Appears at the top of the page. Use this for highly optimized, manual introductions.</div>
        </div>
        <div class="form-group">
          <label>AI Summary</label>
          <textarea name="ai_summary" id="seoAiSummary" rows="4" style="resize:vertical"><%= seoContent.ai_summary %></textarea>
        </div>
        <div class="form-group">
          <label>FAQ JSON Array</label>
          <textarea name="faq_json" id="seoFaq" rows="4" style="font-family:monospace;resize:vertical"><%= seoContent.faq_json %></textarea>
        </div>
      </div>
    </div>

    <div>
      <div class="ai-panel" style="margin-bottom:var(--space-4)">
        <h3><i class="ti ti-wand"></i> AI SEO Assistant</h3>
        <p style="font-size:11px;color:var(--text-muted);margin-bottom:12px;line-height:1.4">Auto-generate highly optimized content for this page using AI.</p>
        
        <input type="hidden" id="entityName" value="<%= entity.name %>">
        <input type="hidden" id="entityType" value="<%= type %>">

        <button type="button" class="ai-btn" id="aiSeoTagsBtn" onclick="generateSeoTags()">
          <i class="ti ti-tags"></i> Generate Title & Meta
        </button>
        <button type="button" class="ai-btn" id="aiEditorialBtn" onclick="generateEditorial()">
          <i class="ti ti-file-text"></i> Write Editorial Content
        </button>
      </div>

      <div style="display:flex;gap:8px">
        <button type="submit" class="btn btn-primary" style="flex:1;justify-content:center">Save SEO Content</button>
        <a href="/admin/seo" class="btn btn-outline">Cancel</a>
      </div>
    </div>

  </div>
</form>

<script>
async function runAiRequest(btnId, type, promptData) {
  const btn = document.getElementById(btnId);
  btn.classList.add('loading');
  try {
    const res = await fetch('/admin/api/ai/generate', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ type, businessInfo: promptData })
    });
    const data = await res.json();
    if(data.success && data.data) {
      return data.data;
    } else {
      alert('Failed: ' + (data.error || 'Unknown error'));
      return null;
    }
  } catch(e) {
    alert('Error: ' + e.message);
    return null;
  } finally {
    btn.classList.remove('loading');
  }
}

async function generateSeoTags() {
  const eName = document.getElementById('entityName').value;
  const eType = document.getElementById('entityType').value; // 'city' or 'category'
  
  const result = await runAiRequest('aiSeoTagsBtn', 'seo_tags', { name: eName, type: eType });
  if(result) {
    document.getElementById('seoTitle').value = result.title || '';
    document.getElementById('seoMeta').value = result.meta_description || '';
  }
}

async function generateEditorial() {
  const eName = document.getElementById('entityName').value;
  const eType = document.getElementById('entityType').value;
  
  const result = await runAiRequest('aiEditorialBtn', 'seo_editorial', { name: eName, type: eType });
  if(result) {
    document.getElementById('seoEditorial').value = result.content || '';
  }
}
</script>

<%- include('layout-bottom') %>
