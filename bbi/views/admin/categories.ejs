<%- include('layout-top') %>

<% if(flash.success) { %><div class="alert alert-success"><%= flash.success %></div><% } %>

<div style="display:grid;grid-template-columns:1fr 1fr;gap:16px">

  <div>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Category</th><th>Slug</th><th>Icon</th><th>Businesses</th></tr></thead>
        <tbody>
          <% categories.forEach(c => { %>
          <tr>
            <td><strong><%= c.name %></strong></td>
            <td style="font-size:12px;color:#4A5568"><%= c.slug %></td>
            <td><i class="ti <%= c.icon %>" style="color:#0D2E5E"></i></td>
            <td><%= c.biz_count %></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="form-card">
    <h3>Add Category</h3>
    <form method="POST" action="/admin/categories">
      <div class="form-group"><label>Category Name</label><input type="text" name="name" required></div>
      <div class="form-group">
        <label>Icon class (Tabler Icons)</label>
        <input type="text" name="icon" placeholder="ti-building-store">
        <div style="font-size:11px;color:#4A5568;margin-top:4px">Browse icons at <a href="https://tabler.io/icons" target="_blank" style="color:#0D2E5E">tabler.io/icons</a></div>
      </div>
      <button type="submit" class="btn btn-primary">Add Category</button>
    </form>
  </div>

</div>

<%- include('layout-bottom') %>
