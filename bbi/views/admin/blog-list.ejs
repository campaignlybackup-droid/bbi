<%- include('layout-top') %>

<div class="header">
  <h2>Blog Posts</h2>
  <a href="/admin/blog/new" class="btn btn-primary"><i class="ti ti-plus"></i> New Post</a>
</div>

<div class="card">
  <table class="table">
    <thead>
      <tr>
        <th>Title</th>
        <th>Category</th>
        <th>Status</th>
        <th>Published</th>
        <th class="text-right">Actions</th>
      </tr>
    </thead>
    <tbody>
      <% posts.forEach(post => { %>
        <tr>
          <td>
            <strong><%= post.title %></strong>
            <div style="font-size:12px;color:var(--text-muted)"><%= post.slug %></div>
          </td>
          <td><%= post.category || '—' %></td>
          <td>
            <span class="badge <%= post.status === 'published' ? 'badge-success' : 'badge-warning' %>">
              <%= post.status %>
            </span>
          </td>
          <td>
            <%= post.published_at ? new Date(post.published_at).toLocaleDateString() : '—' %>
          </td>
          <td class="text-right">
            <a href="/admin/blog/<%= post.id %>/edit" class="btn btn-sm btn-outline"><i class="ti ti-edit"></i> Edit</a>
            
            <% if (post.status === 'draft') { %>
              <form action="/admin/blog/<%= post.id %>/publish" method="POST" style="display:inline">
                <button class="btn btn-sm btn-success"><i class="ti ti-check"></i> Publish</button>
              </form>
            <% } else { %>
              <form action="/admin/blog/<%= post.id %>/unpublish" method="POST" style="display:inline">
                <button class="btn btn-sm btn-warning"><i class="ti ti-x"></i> Unpublish</button>
              </form>
            <% } %>

            <form action="/admin/blog/<%= post.id %>/delete" method="POST" style="display:inline" onsubmit="return confirm('Delete this post?');">
              <button class="btn btn-sm btn-danger"><i class="ti ti-trash"></i></button>
            </form>
          </td>
        </tr>
      <% }) %>
      <% if (posts.length === 0) { %>
        <tr><td colspan="5" class="text-center">No posts found.</td></tr>
      <% } %>
    </tbody>
  </table>
</div>

<%- include('layout-bottom') %>
