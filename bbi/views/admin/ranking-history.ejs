<%- include('layout-top') %>

<div style="margin-bottom:14px">
  <a href="/admin/rankings" class="btn btn-outline btn-sm"><i class="ti ti-arrow-left"></i> Back to Rankings</a>
</div>

<div class="table-wrap">
  <table>
    <thead>
      <tr><th>Date</th><th>Business</th><th>City</th><th>Category</th><th>Rank</th><th>Score</th><th>Auto</th><th>Boost</th></tr>
    </thead>
    <tbody>
      <% history.forEach(h => { %>
      <tr>
        <td style="font-size:12px;color:#4A5568"><%= h.ranking_date %></td>
        <td><strong><%= h.biz_name %></strong></td>
        <td style="font-size:13px"><%= h.city_name %></td>
        <td style="font-size:13px"><%= h.cat_name %></td>
        <td style="font-size:15px;font-weight:700;color:#0D2E5E">#<%= h.rank_position %></td>
        <td style="font-weight:600"><%= Math.round(h.final_score) %></td>
        <td style="color:#4A5568;font-size:12px"><%= Math.round(h.auto_score) %></td>
        <td style="color:#4A5568;font-size:12px"><%= h.manual_boost || 0 %></td>
      </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<%- include('layout-bottom') %>
