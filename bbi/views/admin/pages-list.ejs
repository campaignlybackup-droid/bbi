<%- include('layout-top') %>

<% if(flash.success) { %><div class="alert alert-success"><%= flash.success %></div><% } %>
<% if(flash.error) { %><div class="alert alert-error"><%= flash.error %></div><% } %>

<div style="display:grid;grid-template-columns:1fr;gap:24px">

  <!-- CUSTOM RANKING PAGES -->
  <div class="form-card" style="padding:0;overflow:hidden">
    <div style="padding:16px 20px;border-bottom:1px solid var(--border);background:#fafbfc;display:flex;justify-content:space-between;align-items:center">
      <div>
        <h3 style="margin:0;font-size:16px"><i class="ti ti-medal" style="color:var(--navy);margin-right:8px"></i> Custom Ranking Pages</h3>
        <p style="font-size:12px;color:var(--text-muted);margin-top:4px">Independent ranking pages like "Best PPF in India".</p>
      </div>
    </div>
    
    <div style="padding:20px">
      <div class="table-wrap">
        <table>
          <thead><tr><th>Title</th><th>Slug</th><th>Items</th><th>Status</th><th>Actions</th></tr></thead>
          <tbody>
            <% customPages.forEach(p => { %>
            <tr>
              <td><strong><%= p.title %></strong></td>
              <td style="font-size:12px;color:#4A5568">/best/<%= p.slug %></td>
              <td><%= p.item_count %></td>
              <td><span style="font-size:11px;padding:2px 8px;border-radius:10px;<%= p.active ? 'background:#f0fdf4;color:#166534' : 'background:#f5f5f5;color:#666' %>"><%= p.active ? 'Active' : 'Inactive' %></span></td>
              <td style="display:flex;gap:4px">
                <a href="/admin/seo/custom/<%= p.id %>" class="btn btn-outline btn-sm"><i class="ti ti-sparkles"></i> Edit SEO</a>
                <a href="/admin/custom-rankings/<%= p.id %>" class="btn btn-outline btn-sm"><i class="ti ti-list-numbers"></i> Edit Ranks</a>
              </td>
            </tr>
            <% }) %>
            <% if(customPages.length === 0) { %>
            <tr><td colspan="5" style="text-align:center;padding:24px;color:#666">No custom ranking pages yet.</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>

      <div style="margin-top:16px;background:#f8fafc;padding:16px;border-radius:8px;border:1px solid var(--border)">
        <h4 style="margin-top:0">Create New Custom Page</h4>
        <form method="POST" action="/admin/custom-rankings" style="display:flex;gap:12px;align-items:flex-end">
          <div class="form-group" style="flex:1;margin-bottom:0"><label>Title</label><input type="text" name="title" required placeholder="e.g. Best Dentists in India"></div>
          <button type="submit" class="btn btn-primary">Create</button>
        </form>
      </div>
    </div>
  </div>

  <!-- STANDARD CITY + CATEGORY PAGES -->
  <div class="form-card" style="padding:0;overflow:hidden">
    <div style="padding:16px 20px;border-bottom:1px solid var(--border);background:#fafbfc">
      <h3 style="margin:0;font-size:16px"><i class="ti ti-sitemap" style="color:var(--navy);margin-right:8px"></i> Standard Ranking Pages</h3>
      <p style="font-size:12px;color:var(--text-muted);margin-top:4px">Automated City & Category combos. You can override these ranks manually.</p>
    </div>
    
    <div style="padding:20px">
      <% cities.forEach(city => { %>
        <div style="margin-bottom:24px;border:1px solid var(--border);border-radius:8px;overflow:hidden">
          
          <!-- City Header -->
          <div style="display:flex;justify-content:space-between;align-items:center;padding:12px 16px;background:#f8fafc;border-bottom:1px solid var(--border)">
            <div>
              <strong><%= city.name %></strong> 
              <span style="font-size:11px;color:var(--text-muted);margin-left:8px">/city/<%= city.slug %></span>
            </div>
            <a href="/admin/seo/city/<%= city.id %>" class="btn btn-sm btn-outline"><i class="ti ti-sparkles"></i> Edit City SEO</a>
          </div>

          <!-- Categories inside City -->
          <div style="padding:8px 16px">
            <table class="table-responsive" style="width:100%;margin:0;box-shadow:none">
              <tbody>
                <% categories.forEach(cat => { %>
                <tr style="border-bottom:1px solid #f1f5f9">
                  <td style="padding:8px 0;border:none">
                    <span style="color:var(--text-muted);margin-right:8px">↳</span> 
                    <%= cat.name %>
                    <span style="font-size:11px;color:var(--text-muted);margin-left:8px">/rankings/<%= city.slug %>/<%= cat.slug %></span>
                  </td>
                  <td style="text-align:right;padding:8px 0;border:none;display:flex;justify-content:flex-end;gap:8px">
                    <a href="/admin/seo/combo/<%= city.id %>/<%= cat.id %>" class="btn btn-sm btn-outline" style="border-color:transparent;color:var(--navy)"><i class="ti ti-sparkles"></i> Edit SEO</a>
                    <a href="/admin/combo-rankings/<%= city.id %>/<%= cat.id %>" class="btn btn-sm btn-outline" style="border-color:transparent;color:var(--navy)"><i class="ti ti-list-numbers"></i> Override Ranks</a>
                  </td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
          
        </div>
      <% }) %>
    </div>
  </div>

</div>

<%- include('layout-bottom') %>
