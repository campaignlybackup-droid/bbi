<%- include('layout-top') %>

<div class="header">
  <h2><%= title %></h2>
  <a href="/admin/blog" class="btn btn-outline"><i class="ti ti-arrow-left"></i> Back to Blog</a>
</div>

<div class="card">
  <form action="<%= post ? '/admin/blog/'+post.id : '/admin/blog' %>" method="POST">
    <div class="form-group">
      <label>Title *</label>
      <input type="text" name="title" value="<%= post ? post.title : '' %>" required>
    </div>
    
    <div class="form-row">
      <div class="form-group">
        <label>Category</label>
        <input type="text" name="category" value="<%= post ? post.category : '' %>" placeholder="e.g. SEO, Business Tips">
      </div>
      <div class="form-group">
        <label>Tags (comma separated)</label>
        <input type="text" name="tags" value="<%= post ? post.tags : '' %>">
      </div>
    </div>

    <div class="form-group">
      <label>Featured Image URL</label>
      <input type="url" name="featured_image" value="<%= post ? post.featured_image : '' %>" placeholder="https://...">
    </div>

    <div class="form-group">
      <label>Meta Description (SEO)</label>
      <textarea name="meta_description" rows="2"><%= post ? post.meta_description : '' %></textarea>
    </div>

    <div class="form-group">
      <label>Excerpt</label>
      <textarea name="excerpt" rows="3"><%= post ? post.excerpt : '' %></textarea>
    </div>

    <div class="form-group">
      <label>Content (HTML) *</label>
      <textarea name="content" rows="15" required style="font-family:monospace"><%= post ? post.content : '' %></textarea>
    </div>

    <button type="submit" class="btn btn-primary">Save Post</button>
  </form>
</div>

<%- include('layout-bottom') %>
