<%- include('layout-top') %>

<% if(flash.success && flash.success.length) { %><div class="alert alert-success"><%= flash.success %></div><% } %>
<% if(flash.error && flash.error.length) { %><div class="alert alert-error"><%= flash.error %></div><% } %>

<div style="display:grid;grid-template-columns:1fr 1fr;gap:16px">

  <div>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Title</th><th>Slug</th><th>Items</th><th>Status</th><th></th></tr></thead>
        <tbody>
          <% pages.forEach(p => { %>
          <tr>
            <td><strong><%= p.title %></strong></td>
            <td style="font-size:12px;color:#4A5568"><%= p.slug %></td>
            <td><%= p.item_count %></td>
            <td><span style="font-size:11px;padding:2px 8px;border-radius:10px;<%= p.active ? 'background:#f0fdf4;color:#166534' : 'background:#f5f5f5;color:#666' %>"><%= p.active ? 'Active' : 'Inactive' %></span></td>
            <td style="display:flex;gap:4px">
              <a href="/admin/custom-rankings/<%= p.id %>" class="btn btn-outline btn-sm">Edit</a>
              <form method="POST" action="/admin/custom-rankings/<%= p.id %>/delete" onsubmit="return confirm('WARNING: This will delete the custom page. Are you sure?');">
                <button type="submit" class="btn btn-outline btn-sm" style="color:var(--red);border-color:var(--red)"><i class="ti ti-trash"></i></button>
              </form>
            </td>
          </tr>
          <% }) %>
          <% if(pages.length === 0) { %>
          <tr><td colspan="5" style="text-align:center;padding:24px;color:#666">No custom ranking pages yet.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="form-card">
    <h3>Create Custom Ranking Page</h3>
    <form method="POST" action="/admin/custom-rankings">
      <div class="form-group"><label>Title (e.g. Best PPF & Detailing in India)</label><input type="text" name="title" required></div>
      <div class="form-group"><label>Description</label><textarea name="description" rows="3"></textarea></div>
      <div class="form-group"><label>Meta Description</label><input type="text" name="meta_description"></div>
      <button type="submit" class="btn btn-primary">Create Page</button>
    </form>
  </div>

</div>

<%- include('layout-bottom') %>
