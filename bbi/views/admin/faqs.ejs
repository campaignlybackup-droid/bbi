<%- include('layout-top') %>

<div class="header">
  <h2>Manage FAQs</h2>
</div>

<div class="row">
  <div class="col-4">
    <div class="card">
      <h3>Add New FAQ</h3>
      <form action="/admin/faqs" method="POST">
        <div class="form-group">
          <label>Question *</label>
          <input type="text" name="question" required>
        </div>
        <div class="form-group">
          <label>Answer *</label>
          <textarea name="answer" rows="3" required></textarea>
        </div>
        <div class="form-group">
          <label>Page Type *</label>
          <select name="page_type" required>
            <option value="homepage">Homepage</option>
            <option value="city">City Page</option>
            <option value="category">Category Page</option>
            <option value="ranking">Ranking Page</option>
            <option value="business">Business Page</option>
          </select>
        </div>
        <div class="form-group">
          <label>Entity ID (Optional)</label>
          <input type="number" name="entity_id" placeholder="City ID, Category ID, or Business ID">
          <small class="text-muted">Leave blank to apply to all pages of this type.</small>
        </div>
        <div class="form-group">
          <label>Sort Order</label>
          <input type="number" name="sort_order" value="0">
        </div>
        <button class="btn btn-primary btn-block">Add FAQ</button>
      </form>
    </div>
  </div>

  <div class="col-8">
    <div class="card">
      <table class="table">
        <thead>
          <tr>
            <th>Question</th>
            <th>Location</th>
            <th>Sort</th>
            <th class="text-right">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% faqs.forEach(faq => { %>
            <tr>
              <td>
                <strong><%= faq.question %></strong>
                <div style="font-size:12px;color:var(--text-muted);margin-top:4px"><%= faq.answer.substring(0, 50) %>...</div>
              </td>
              <td>
                <span class="badge badge-outline"><%= faq.page_type %></span>
                <% if(faq.entity_id) { %>
                  <span class="badge">ID: <%= faq.entity_id %></span>
                <% } else { %>
                  <span class="badge badge-warning">Global</span>
                <% } %>
              </td>
              <td><%= faq.sort_order %></td>
              <td class="text-right">
                <form action="/admin/faqs/<%= faq.id %>/delete" method="POST" style="display:inline" onsubmit="return confirm('Delete this FAQ?');">
                  <button class="btn btn-sm btn-danger"><i class="ti ti-trash"></i></button>
                </form>
              </td>
            </tr>
          <% }) %>
          <% if (faqs.length === 0) { %>
            <tr><td colspan="4" class="text-center">No FAQs found.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('layout-bottom') %>
