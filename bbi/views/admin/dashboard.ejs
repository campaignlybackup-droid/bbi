<%- include('layout-top') %>

<% if(flash.success) { %><div class="alert alert-success"><%= flash.success %></div><% } %>

<div class="stat-grid">
  <div class="stat-card">
    <div class="stat-num"><%= stats.businesses %></div>
    <div class="stat-label">Total Businesses</div>
  </div>
  <div class="stat-card">
    <div class="stat-num"><%= stats.verified %></div>
    <div class="stat-label">Verified Businesses</div>
  </div>
  <div class="stat-card">
    <div class="stat-num"><%= stats.rankings %></div>
    <div class="stat-label">Ranking Records</div>
  </div>
  <div class="stat-card">
    <div class="stat-num"><%= stats.cities %></div>
    <div class="stat-label">Active Cities</div>
  </div>
  <div class="stat-card">
    <div class="stat-num"><%= stats.categories %></div>
    <div class="stat-label">Categories</div>
  </div>
  <div class="stat-card">
    <div class="stat-num"><%= stats.sponsored %></div>
    <div class="stat-label">Sponsored Listings</div>
  </div>
</div>

<div style="margin-bottom:8px;display:flex;align-items:center;justify-content:space-between">
  <div style="font-size:14px;font-weight:600;color:#1A1A2E">Recently Added Businesses</div>
  <a href="/admin/businesses/new" class="btn btn-primary btn-sm"><i class="ti ti-plus"></i> Add Business</a>
</div>

<div class="table-wrap">
  <table>
    <thead>
      <tr><th>Name</th><th>City</th><th>Category</th><th>Added</th><th></th></tr>
    </thead>
    <tbody>
      <% recent.forEach(b => { %>
      <tr>
        <td><strong><%= b.name %></strong></td>
        <td><%= b.city %></td>
        <td><%= b.category %></td>
        <td style="color:#4A5568;font-size:12px"><%= b.created_at.slice(0,10) %></td>
        <td><a href="/admin/businesses" class="btn btn-outline btn-sm">View</a></td>
      </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<%- include('layout-bottom') %>
