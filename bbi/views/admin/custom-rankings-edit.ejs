<%- include('layout-top') %>

<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px">
  <div>
    <a href="/admin/custom-rankings" style="color:#666;font-size:14px;text-decoration:none"><i class="ti ti-arrow-left"></i> Back to Custom Rankings</a>
  </div>
  <a href="/best/<%= page.slug %>" target="_blank" class="btn btn-outline"><i class="ti ti-external-link"></i> View Page</a>
</div>

<% if(flash.success && flash.success.length) { %><div class="alert alert-success"><%= flash.success %></div><% } %>
<% if(flash.error && flash.error.length) { %><div class="alert alert-error"><%= flash.error %></div><% } %>

<div style="display:grid;grid-template-columns:1fr 2fr;gap:24px">

  <div class="form-card">
    <h3>Edit Page Details</h3>
    <form method="POST" action="/admin/custom-rankings/<%= page.id %>">
      <div class="form-group"><label>Title</label><input type="text" name="title" value="<%= page.title %>" required></div>
      <div class="form-group"><label>Description</label><textarea name="description" rows="3"><%= page.description %></textarea></div>
      <div class="form-group"><label>Meta Description</label><input type="text" name="meta_description" value="<%= page.meta_description %>"></div>
      <div class="form-group">
        <label>Status</label>
        <select name="active">
          <option value="1" <%= page.active ? 'selected' : '' %>>Active</option>
          <option value="0" <%= !page.active ? 'selected' : '' %>>Inactive</option>
        </select>
      </div>
      <button type="submit" class="btn btn-primary" style="width:100%;justify-content:center">Save Changes</button>
    </form>
  </div>

  <div>
    <div class="form-card" style="margin-bottom:24px">
      <h3>Add Business to Ranking</h3>
      <form method="POST" action="/admin/custom-rankings/<%= page.id %>/items" style="display:flex;gap:12px;align-items:flex-end">
        <div class="form-group" style="flex:1;margin-bottom:0">
          <label>Select Business</label>
          <select name="business_id" required>
            <option value="">-- Select a business --</option>
            <% businesses.forEach(b => { %>
            <option value="<%= b.id %>"><%= b.name %></option>
            <% }) %>
          </select>
        </div>
        <div class="form-group" style="width:100px;margin-bottom:0">
          <label>Rank (e.g. 1)</label>
          <input type="number" name="manual_rank" required min="1">
        </div>
        <button type="submit" class="btn btn-primary">Add</button>
      </form>
    </div>

    <div class="table-wrap">
      <table>
        <thead><tr><th>Rank</th><th>Business</th><th>Location</th><th>Update</th><th>Remove</th></tr></thead>
        <tbody>
          <% items.forEach(item => { %>
          <tr>
            <td><strong>#<%= item.manual_rank %></strong></td>
            <td><%= item.biz_name %><br><span style="font-size:12px;color:#666"><%= item.cat_name %></span></td>
            <td><span style="font-size:12px"><%= item.city_name %></span></td>
            <td>
              <form method="POST" action="/admin/custom-rankings/<%= page.id %>/items/<%= item.id %>/update" style="display:flex;gap:8px">
                <input type="number" name="manual_rank" value="<%= item.manual_rank %>" style="width:60px;padding:4px 8px;border:1px solid #ccc;border-radius:4px" min="1">
                <button type="submit" class="btn btn-outline btn-sm">Save</button>
              </form>
            </td>
            <td>
              <form method="POST" action="/admin/custom-rankings/<%= page.id %>/items/<%= item.id %>/delete">
                <button type="submit" class="btn btn-outline btn-sm" style="color:var(--red);border-color:var(--red)"><i class="ti ti-trash"></i></button>
              </form>
            </td>
          </tr>
          <% }) %>
          <% if(items.length === 0) { %>
          <tr><td colspan="5" style="text-align:center;padding:24px;color:#666">No businesses added to this ranking yet.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

</div>

<%- include('layout-bottom') %>
