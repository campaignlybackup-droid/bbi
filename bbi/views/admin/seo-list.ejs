<%- include('layout-top') %>

<% if(flash.success) { %><div class="alert alert-success"><%= flash.success %></div><% } %>

<div style="display:grid;grid-template-columns:1fr 1fr;gap:24px">
  <div>
    <div class="form-card" style="padding:0;overflow:hidden">
      <div style="padding:16px 20px;border-bottom:1px solid var(--border);background:#fafbfc">
        <h3 style="margin:0;font-size:16px"><i class="ti ti-map-pin" style="color:var(--navy);margin-right:8px"></i> City Pages</h3>
      </div>
      <table class="table-responsive" style="width:100%">
        <thead>
          <tr>
            <th>City Name</th>
            <th style="width:100px;text-align:right">Action</th>
          </tr>
        </thead>
        <tbody>
          <% cities.forEach(c => { %>
          <tr>
            <td><strong><%= c.name %></strong> <span style="color:var(--text-muted);font-size:11px">/city/<%= c.slug %></span></td>
            <td style="text-align:right">
              <a href="/admin/seo/city/<%= c.id %>" class="btn btn-sm btn-outline"><i class="ti ti-edit"></i> Edit SEO</a>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

  <div>
    <div class="form-card" style="padding:0;overflow:hidden">
      <div style="padding:16px 20px;border-bottom:1px solid var(--border);background:#fafbfc">
        <h3 style="margin:0;font-size:16px"><i class="ti ti-category" style="color:var(--navy);margin-right:8px"></i> Category Pages</h3>
      </div>
      <table class="table-responsive" style="width:100%">
        <thead>
          <tr>
            <th>Category Name</th>
            <th style="width:100px;text-align:right">Action</th>
          </tr>
        </thead>
        <tbody>
          <% categories.forEach(c => { %>
          <tr>
            <td><strong><%= c.name %></strong> <span style="color:var(--text-muted);font-size:11px">/category/<%= c.slug %></span></td>
            <td style="text-align:right">
              <a href="/admin/seo/category/<%= c.id %>" class="btn btn-sm btn-outline"><i class="ti ti-edit"></i> Edit SEO</a>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('layout-bottom') %>
