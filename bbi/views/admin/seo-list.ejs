<%- include('layout-top') %>

<% if(flash.success) { %><div class="alert alert-success"><%= flash.success %></div><% } %>

<div class="form-card" style="padding:0;overflow:hidden">
  <div style="padding:16px 20px;border-bottom:1px solid var(--border);background:#fafbfc">
    <h3 style="margin:0;font-size:16px"><i class="ti ti-sitemap" style="color:var(--navy);margin-right:8px"></i> SEO Hierarchy Tree</h3>
    <p style="font-size:12px;color:var(--text-muted);margin-top:4px">Manage the global SEO for cities, and specific Category niches within those cities.</p>
  </div>
  
  <div style="padding:20px">
    <% cities.forEach(city => { %>
      <div style="margin-bottom:24px;border:1px solid var(--border);border-radius:8px;overflow:hidden">
        
        <!-- City Header -->
        <div style="display:flex;justify-content:space-between;align-items:center;padding:12px 16px;background:#f8fafc;border-bottom:1px solid var(--border)">
          <div>
            <strong><%= city.name %></strong> 
            <span style="font-size:11px;color:var(--text-muted);margin-left:8px">/city/<%= city.slug %></span>
          </div>
          <a href="/admin/seo/city/<%= city.id %>" class="btn btn-sm btn-outline"><i class="ti ti-edit"></i> Edit City SEO</a>
        </div>

        <!-- Categories inside City -->
        <div style="padding:8px 16px">
          <table class="table-responsive" style="width:100%;margin:0;box-shadow:none">
            <tbody>
              <% categories.forEach(cat => { %>
              <tr style="border-bottom:1px solid #f1f5f9">
                <td style="padding:8px 0;border:none">
                  <span style="color:var(--text-muted);margin-right:8px">↳</span> 
                  <%= cat.name %>
                  <span style="font-size:11px;color:var(--text-muted);margin-left:8px">/rankings/<%= city.slug %>/<%= cat.slug %></span>
                </td>
                <td style="text-align:right;padding:8px 0;border:none">
                  <a href="/admin/seo/combo/<%= city.id %>/<%= cat.id %>" class="btn btn-sm btn-outline" style="border-color:transparent;color:var(--navy)"><i class="ti ti-edit"></i> Edit Combo SEO</a>
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
        
      </div>
    <% }) %>
  </div>
</div>

<%- include('layout-bottom') %>
