<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>BBI — India's Trusted Business Rankings</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css">
</head>
<body>

<nav class="nav">
  <div class="nav-logo">BBI <span>·</span> Bharat Business Index</div>
  <div class="nav-links">
    <a href="/rankings/jaipur/ppf-detailing">Rankings</a>
    <a href="/methodology">Methodology</a>
    <a href="/admin" class="nav-cta">Admin</a>
  </div>
</nav>

<div class="hero">
  <h1>India's trusted business rankings</h1>
  <p>Independent, transparent rankings updated every month.</p>
  <form class="search-bar" action="/search" method="GET">
    <input type="text" name="q" placeholder="Search businesses, categories, or cities…">
    <button type="submit">Search</button>
  </form>
</div>

<div class="section">
  <div class="section-label">Featured rankings</div>
  <div class="section-title">Top PPF Installers — Jaipur</div>
  <div class="section-sub">June 2026 · Based on verified reviews</div>

  <div class="rank-grid">
    <% featured.forEach(b => { %>
    <div class="rcard">
      <div class="rcard-top">
        <div class="rank-num">#<%= b.rank_position %></div>
        <span class="move move-<%= b.movement.direction %>"><%= b.movement.label %></span>
      </div>
      <a href="/business/<%= b.slug %>">
        <div class="biz-name"><%= b.name %></div>
      </a>
      <div class="biz-loc"><%= b.city_name %></div>
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:5px">
        <span class="score-label">Ranking score</span>
        <span class="score-val"><%= Math.round(b.final_score) %> / 100</span>
      </div>
      <div class="score-track"><div class="score-fill" style="width:<%= b.final_score %>%"></div></div>
      <div class="badges">
        <% if(b.badge) { %><span class="badge badge-gold"><%= b.badge %></span><% } %>
        <% if(b.verified) { %><span class="badge badge-navy">BBI Verified</span><% } %>
      </div>
    </div>
    <% }) %>
  </div>
</div>

<hr class="divider">

<div class="section">
  <div class="section-label">Browse by category</div>
  <div class="section-title" style="margin-bottom:20px">What are you looking for?</div>

  <div class="cat-grid">
    <% categories.forEach(cat => { %>
    <a href="/rankings/jaipur/<%= cat.slug %>" class="cat-card">
      <div class="cat-icon"><i class="ti <%= cat.icon %>"></i></div>
      <div class="cat-name"><%= cat.name %></div>
    </a>
    <% }) %>
  </div>
</div>

<hr class="divider">

<div class="section">
  <div class="section-label">Browse by city</div>
  <div class="section-title" style="margin-bottom:16px">Top cities</div>
  <div class="city-row">
    <% cities.forEach(city => { %>
    <a href="/rankings/<%= city.name.toLowerCase().replace(/ /g,'-') %>/restaurants" class="city-pill"><%= city.name %></a>
    <% }) %>
  </div>
</div>

<footer>
  <div class="logo">BBI <span>·</span> Bharat Business Index</div>
  <div class="footer-links">
    <a href="/methodology">Methodology</a>
    <a href="/admin">For Businesses</a>
    <a href="#">Contact</a>
  </div>
  <div class="footer-copy">© 2026 BBI. Rankings are independent.</div>
</footer>

</body>
</html>
