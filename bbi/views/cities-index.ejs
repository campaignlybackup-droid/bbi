<%- include('partials/header') %>

<div class="page-header">
  <h1>Explore Cities</h1>
  <p>Browse business rankings across India's major cities.</p>
</div>

<div class="section">

  <% if(cities.length) { %>
  <div class="section-label">All cities</div>
  <div class="section-title" style="margin-bottom:var(--space-5)"><%= cities.length %> cities with ranked businesses</div>
  <div class="city-grid">
    <% cities.forEach(c => { %>
    <a href="/city/<%= c.slug || c.name.toLowerCase().replace(/ /g,'-') %>" class="city-card">
      <div class="city-card-name"><%= c.name %></div>
      <div class="city-card-state"><%= c.state %></div>
      <div class="city-card-count"><%= c.biz_count %> business<%= c.biz_count !== 1 ? 'es' : '' %> ranked</div>
    </a>
    <% }) %>
  </div>
  <% } else { %>
  <div class="rankings-empty">
    <i class="ti ti-map-pin-off"></i>
    <h3 style="font-weight:700;color:var(--text-primary);margin-bottom:var(--space-2)">No cities yet</h3>
    <p style="font-size:var(--font-size-sm)">Cities will appear here as businesses are added.</p>
  </div>
  <% } %>

</div>

<%- include('partials/footer') %>
