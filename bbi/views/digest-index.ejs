<%- include('partials/header') %>

<div class="page-header" style="background:var(--card-bg);padding:var(--space-8) var(--space-4);text-align:center;border-bottom:1px solid var(--border-light)">
  <h1 style="margin:0 0 var(--space-2) 0;font-size:36px;color:var(--text-primary)">Monthly Rankings Digest</h1>
  <p style="margin:0;color:var(--text-muted);font-size:var(--font-size-lg)">Catch up on the biggest movers, new entrants, and ranking shifts across India.</p>
</div>

<div class="section" style="max-width:800px;margin:0 auto">
  <% if (digests.length === 0) { %>
    <div style="text-align:center;padding:var(--space-8);color:var(--text-muted);background:var(--card-bg);border-radius:var(--radius-lg)">
      <i class="ti ti-calendar-stats" style="font-size:48px;margin-bottom:var(--space-4);opacity:0.5"></i>
      <h3>No digests available yet.</h3>
      <p>Check back after the first of the month!</p>
    </div>
  <% } else { %>
    <div style="display:flex;flex-direction:column;gap:var(--space-6)">
      <% digests.forEach(digest => { %>
        <a href="/digest/<%= digest.month_year %>" class="card" style="text-decoration:none;color:inherit;display:flex;align-items:center;padding:var(--space-6);transition:transform 0.2s;box-shadow:var(--shadow-sm)">
          <div style="width:80px;height:80px;background:var(--accent-light);color:var(--accent-color);border-radius:var(--radius-md);display:flex;align-items:center;justify-content:center;margin-right:var(--space-6);flex-shrink:0">
            <i class="ti ti-calendar" style="font-size:32px"></i>
          </div>
          <div style="flex:1">
            <h2 style="margin:0 0 var(--space-2) 0;font-size:24px;color:var(--text-primary)"><%= digest.month_display %></h2>
            <p style="margin:0;color:var(--text-secondary)"><%= digest.summary %></p>
          </div>
          <div style="color:var(--accent-color);margin-left:var(--space-4)">
            <i class="ti ti-chevron-right" style="font-size:24px"></i>
          </div>
        </a>
      <% }) %>
    </div>
  <% } %>
</div>

<script>
document.querySelectorAll('.card').forEach(card => {
  card.addEventListener('mouseenter', () => {
    card.style.transform = 'translateY(-4px)';
    card.style.boxShadow = 'var(--shadow-md)';
  });
  card.addEventListener('mouseleave', () => {
    card.style.transform = 'none';
    card.style.boxShadow = 'var(--shadow-sm)';
  });
});
</script>

<%- include('partials/footer') %>
