<%- include('partials/header') %>
<script type="application/ld+json"><%- JSON.stringify(breadcrumbSchema) %></script>
<% if(typeof faqSchema !== 'undefined' && faqSchema) { %><script type="application/ld+json"><%- JSON.stringify(faqSchema) %></script><% } %>

<div class="page-header">
  <div class="breadcrumb"><a href="/">Home</a> <span>/</span> Methodology</div>
  <h1>How We Rank Businesses</h1>
  <p>Transparent, independent, updated monthly</p>
</div>

<div class="section" style="max-width:760px">
  <!-- Score weights table -->
  <div class="profile-card" style="margin-bottom:var(--space-6)">
    <div class="profile-card-title">Scoring Breakdown</div>
    <div style="overflow-x:auto;-webkit-overflow-scrolling:touch">
    <table style="width:100%;min-width:320px">
      <thead>
        <tr><th>Factor</th><th>Max Points</th><th>Weight</th></tr>
      </thead>
      <tbody>
        <tr><td><strong>Customer Reviews</strong></td><td>35</td><td>35%</td></tr>
        <tr><td><strong>Review Volume</strong></td><td>25</td><td>25%</td></tr>
        <tr><td><strong>Website & Online Presence</strong></td><td>15</td><td>15%</td></tr>
        <tr><td><strong>Verification Status</strong></td><td>10</td><td>10%</td></tr>
        <tr><td><strong>Profile Completeness</strong></td><td>10</td><td>10%</td></tr>
        <tr><td><strong>Editorial Assessment</strong></td><td>15</td><td>15%</td></tr>
      </tbody>
    </table>
    </div>
    <div style="font-size:var(--font-size-xs);color:var(--text-muted);margin-top:var(--space-3)">
      Auto score maximum: 85 points. Editorial adds up to 15 points. Total: 100.
    </div>
  </div>

  <!-- Steps -->
  <% const steps = [
    ['Data Collection','Review counts, ratings, website presence, and social signals collected from verified public sources every month.'],
    ['Automatic Scoring','Each factor is scored against defined thresholds. Scores are weighted and combined into a final score out of 100.'],
    ['Editorial Review','Our team manually reviews top businesses and may apply a quality score based on service standards.'],
    ['Monthly Recalculation','Rankings are fully recalculated on the 1st of every month. All history is preserved — nothing is ever deleted.'],
    ['Sponsored Integrity','Sponsored placements are clearly labeled and kept entirely separate from editorial rankings.'],
    ['How to Improve','Businesses can improve their rank by growing reviews, completing their profile, and maintaining quality.']
  ] %>
  <% steps.forEach(([title, text], i) => { %>
  <div style="display:flex;gap:var(--space-4);padding:var(--space-4) 0;border-bottom:1px solid var(--border-light)">
    <div style="width:36px;height:36px;border-radius:50%;background:var(--navy);color:#fff;font-size:var(--font-size-sm);font-weight:800;display:flex;align-items:center;justify-content:center;flex-shrink:0"><%= i+1 %></div>
    <div>
      <div style="font-size:var(--font-size-sm);font-weight:700;color:var(--text-primary);margin-bottom:3px"><%= title %></div>
      <div style="font-size:var(--font-size-sm);color:var(--text-secondary);line-height:1.7"><%= text %></div>
    </div>
  </div>
  <% }) %>

  <div style="background:var(--warn-bg);border:1px solid var(--warn-border);border-radius:var(--radius-md);padding:14px 18px;font-size:var(--font-size-sm);color:var(--warn-text);margin-top:var(--space-5);display:flex;gap:10px;align-items:center">
    <i class="ti ti-shield-check" style="font-size:20px;flex-shrink:0"></i>
    BBI's credibility depends on ranking integrity. Sponsored businesses can never automatically reach #1.
  </div>
</div>

<%- include('partials/footer') %>
