<%- include('partials/header') %>

<div class="page-header">
  <h1><% if(query) { %>Results for "<%= query %>"<% } else { %>Search<% } %></h1>
  <p>Find businesses, categories, and cities across India</p>
</div>

<div class="section">
  <form action="/search" method="GET" class="search-filters" style="margin-bottom:var(--space-6)">
    <input type="text" name="q" value="<%= query %>" placeholder="Search businesses…" style="flex:1;min-width:200px" aria-label="Search query">
    <select name="city" aria-label="City filter">
      <option value="">All Cities</option>
      <% cities.forEach(c => { %><option value="<%= c.id %>" <%= selectedCity == c.id ? 'selected' : '' %>><%= c.name %></option><% }) %>
    </select>
    <select name="category" aria-label="Category filter">
      <option value="">All Categories</option>
      <% categories.forEach(c => { %><option value="<%= c.id %>" <%= selectedCategory == c.id ? 'selected' : '' %>><%= c.name %></option><% }) %>
    </select>
    <button type="submit" class="btn btn-primary">Search</button>
  </form>

  <% if(query) { %>
  <div class="search-results-count"><%= total %> result<%= total !== 1 ? 's' : '' %> found</div>

  <% if(typeof matchedCategories !== 'undefined' && matchedCategories && matchedCategories.filter(c => c.name).length && matchedCategories.some(c => c.slug)) { %>
  <div style="display:flex;flex-wrap:wrap;gap:var(--space-2);margin-bottom:var(--space-4)">
    <% matchedCategories.filter(c => c.slug).forEach(c => { %>
    <a href="/category/<%= c.slug %>" class="badge badge-navy"><i class="ti ti-category" style="font-size:12px"></i> <%= c.name %></a>
    <% }) %>
  </div>
  <% } %>

  <% results.forEach(r => { %>
  <a href="/business/<%= r.slug %>" class="search-result-item" style="display:block" onclick="logSearchClick('<%= query %>', <%= r.id %>, 'business')">
    <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:var(--space-2)">
      <div>
        <div class="biz-name"><%= r.name %></div>
        <div class="biz-loc"><%= r.cat_name %> · <%= r.city_name %></div>
      </div>
      <div style="text-align:right">
        <% if(r.current_rank) { %><div class="rank-num" style="font-size:18px">#<%= r.current_rank %></div><% } %>
        <% if(r.final_score) { %><div class="score-val"><%= Math.round(r.final_score) %>/100</div><% } %>
      </div>
    </div>
    <% if(r.description) { %>
    <div class="biz-desc"><%= r.description %></div>
    <% } %>
    <% if(r.google_rating) { %>
    <div style="font-size:var(--font-size-xs);color:var(--text-secondary)">
      <i class="ti ti-star-filled" style="color:var(--gold)"></i> <%= r.google_rating %> · <%= r.google_review_count %> reviews
    </div>
    <% } %>
  </a>
  <% }) %>

  <% if(!results.length) { %>
  <div class="profile-card text-center" style="padding:var(--space-10)">
    <i class="ti ti-search-off" style="font-size:36px;color:var(--text-muted)"></i>
    <div style="font-size:var(--font-size-base);font-weight:600;color:var(--text-primary);margin-top:var(--space-3)">No results found</div>
    <div style="font-size:var(--font-size-sm);color:var(--text-secondary);margin-top:var(--space-1)">Try different keywords or browse by category.</div>
  </div>
  <% } %>

  <% } else { %>
  <!-- No query — show trending -->
  <% if(trending.length) { %>
  <div style="margin-bottom:var(--space-6)">
    <div class="section-label">Trending searches</div>
    <div class="trending-tags" style="margin-top:var(--space-3)">
      <% trending.forEach(t => { %>
      <a href="/search?q=<%= encodeURIComponent(t.query) %>" class="trending-tag"><%= t.query %></a>
      <% }) %>
    </div>
  </div>
  <% } %>

  <% if(typeof recentSearches !== 'undefined' && recentSearches.length) { %>
  <div style="margin-bottom:var(--space-6)">
    <div class="section-label">Recent searches</div>
    <div class="trending-tags" style="margin-top:var(--space-3)">
      <% recentSearches.forEach(t => { %>
      <a href="/search?q=<%= encodeURIComponent(t.query) %>" class="trending-tag" style="background:var(--bg-color);border:1px solid var(--border-light)"><%= t.query %></a>
      <% }) %>
    </div>
  </div>
  <% } %>

  <% } %>
</div>

<script>
function logSearchClick(query, resultId, resultType) {
  fetch('/api/search/click', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ query, resultId, resultType })
  }).catch(e => console.error('Error logging click:', e));
}
</script>

<%- include('partials/footer') %>
