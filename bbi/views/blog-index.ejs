<%- include('partials/header') %>

<div class="page-header" style="background:var(--card-bg);padding:var(--space-8) var(--space-4);text-align:center;border-bottom:1px solid var(--border-light)">
  <h1 style="margin:0 0 var(--space-2) 0;font-size:36px;color:var(--text-primary)">BBI Blog</h1>
  <p style="margin:0;color:var(--text-muted);font-size:var(--font-size-lg)">Insights, updates, and resources for businesses and consumers.</p>
</div>

<div class="section" style="display:flex;gap:var(--space-8);align-items:flex-start">
  
  <div style="flex:1">
    <% if (posts.length === 0) { %>
      <div style="text-align:center;padding:var(--space-8);color:var(--text-muted);background:var(--card-bg);border-radius:var(--radius-lg)">
        <i class="ti ti-notes" style="font-size:48px;margin-bottom:var(--space-4);opacity:0.5"></i>
        <h3>No posts found.</h3>
        <p>Check back later for new content.</p>
      </div>
    <% } %>

    <div style="display:flex;flex-direction:column;gap:var(--space-6)">
      <% posts.forEach(post => { %>
        <article class="card" style="display:flex;gap:var(--space-6);padding:var(--space-4);transition:transform 0.2s">
          <% if (post.featured_image) { %>
            <div style="width:240px;height:160px;flex-shrink:0;border-radius:var(--radius-md);overflow:hidden;background:var(--bg-color)">
              <img src="<%= post.featured_image %>" alt="<%= post.title %>" style="width:100%;height:100%;object-fit:cover">
            </div>
          <% } %>
          <div style="display:flex;flex-direction:column;justify-content:center;flex:1">
            <div style="font-size:var(--font-size-sm);color:var(--accent-color);font-weight:600;margin-bottom:var(--space-2)">
              <%= post.category || 'Uncategorized' %> &bull; <%= new Date(post.published_at).toLocaleDateString('en-US', { month:'short', day:'numeric', year:'numeric' }) %>
            </div>
            <h2 style="margin:0 0 var(--space-2) 0;font-size:var(--font-size-xl)">
              <a href="/blog/<%= post.slug %>" style="color:var(--text-primary);text-decoration:none"><%= post.title %></a>
            </h2>
            <p style="margin:0 0 var(--space-4) 0;color:var(--text-secondary);line-height:1.5">
              <%= post.excerpt %>
            </p>
            <div style="margin-top:auto">
              <a href="/blog/<%= post.slug %>" style="color:var(--accent-color);font-weight:600;text-decoration:none;display:inline-flex;align-items:center;gap:4px">
                Read Article <i class="ti ti-arrow-right"></i>
              </a>
            </div>
          </div>
        </article>
      <% }) %>
    </div>

    <% if (totalPages > 1) { %>
      <div style="display:flex;justify-content:center;gap:var(--space-2);margin-top:var(--space-8)">
        <% for(let i=1; i<=totalPages; i++) { %>
          <a href="/blog?page=<%= i %><%= currentCategory ? '&category='+currentCategory : '' %>" 
             style="display:flex;align-items:center;justify-content:center;width:36px;height:36px;border-radius:var(--radius-sm);background:<%= page === i ? 'var(--accent-color)' : 'var(--card-bg)' %>;color:<%= page === i ? '#fff' : 'var(--text-primary)' %>;text-decoration:none;border:1px solid <%= page === i ? 'var(--accent-color)' : 'var(--border-light)' %>;font-weight:600">
            <%= i %>
          </a>
        <% } %>
      </div>
    <% } %>
  </div>

  <aside style="width:300px;flex-shrink:0;display:flex;flex-direction:column;gap:var(--space-6)">
    <div class="card">
      <h3 style="margin-top:0;margin-bottom:var(--space-4);font-size:var(--font-size-lg);border-bottom:2px solid var(--accent-color);padding-bottom:var(--space-2);display:inline-block">Categories</h3>
      <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:var(--space-2)">
        <li>
          <a href="/blog" style="display:flex;justify-content:space-between;color:var(--text-secondary);text-decoration:none;padding:var(--space-2);border-radius:var(--radius-sm);background:<%= !currentCategory ? 'var(--bg-color)' : 'transparent' %>;font-weight:<%= !currentCategory ? '600' : '400' %>">
            <span>All Posts</span>
          </a>
        </li>
        <% categories.forEach(cat => { %>
          <li>
            <a href="/blog?category=<%= encodeURIComponent(cat.category) %>" style="display:flex;justify-content:space-between;color:var(--text-secondary);text-decoration:none;padding:var(--space-2);border-radius:var(--radius-sm);background:<%= currentCategory === cat.category ? 'var(--bg-color)' : 'transparent' %>;font-weight:<%= currentCategory === cat.category ? '600' : '400' %>;transition:background 0.2s">
              <span><%= cat.category %></span>
              <span style="background:var(--border-light);padding:2px 8px;border-radius:12px;font-size:12px"><%= cat.count %></span>
            </a>
          </li>
        <% }) %>
      </ul>
    </div>
  </aside>

</div>

<script>
document.querySelectorAll('article.card').forEach(card => {
  card.addEventListener('mouseenter', () => {
    card.style.transform = 'translateY(-4px)';
    card.style.boxShadow = 'var(--shadow-md)';
  });
  card.addEventListener('mouseleave', () => {
    card.style.transform = 'none';
    card.style.boxShadow = 'var(--shadow-sm)';
  });
});
</script>

<%- include('partials/footer') %>
