<%# BBI — Shared Header Partial %>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title><%= typeof title !== 'undefined' ? title : 'BBI — Bharat Business Index' %></title>
  <% if(typeof metaDescription !== 'undefined') { %><meta name="description" content="<%= metaDescription %>"><% } %>
  <% if(typeof canonicalUrl !== 'undefined') { %><link rel="canonical" href="<%= canonicalUrl %>"><% } %>

  <!-- Open Graph -->
  <meta property="og:title" content="<%= typeof title !== 'undefined' ? title : 'BBI' %>">
  <% if(typeof metaDescription !== 'undefined') { %><meta property="og:description" content="<%= metaDescription %>"><% } %>
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Bharat Business Index">

  <!-- Preconnect -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preconnect" href="https://cdn.jsdelivr.net">

  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css">
</head>
<body>

<nav class="nav">
  <a href="/" class="nav-logo">BBI <span>·</span> Bharat Business Index</a>
  <button class="nav-toggle" id="nav-toggle-btn" aria-label="Menu" aria-expanded="false" aria-controls="nav-links">
    <i class="ti ti-menu-2" id="nav-toggle-icon"></i>
  </button>
  <div class="nav-links" id="nav-links" role="navigation">
    <a href="/search" <%= typeof currentPath !== 'undefined' && currentPath.startsWith('/search') ? 'aria-current="page"' : '' %>>Search</a>
    <a href="/methodology" <%= typeof currentPath !== 'undefined' && currentPath === '/methodology' ? 'aria-current="page"' : '' %>>Methodology</a>
    <a href="/get-listed" class="nav-cta" <%= typeof currentPath !== 'undefined' && currentPath === '/get-listed' ? 'aria-current="page"' : '' %>>Get Listed</a>
  </div>
</nav>

<script>
  (function() {
    var btn = document.getElementById('nav-toggle-btn');
    var links = document.getElementById('nav-links');
    var icon = document.getElementById('nav-toggle-icon');
    if (!btn || !links) return;

    btn.addEventListener('click', function(e) {
      e.stopPropagation();
      var isOpen = links.classList.toggle('open');
      btn.setAttribute('aria-expanded', isOpen);
      icon.className = isOpen ? 'ti ti-x' : 'ti ti-menu-2';
    });

    // Close when clicking outside
    document.addEventListener('click', function(e) {
      if (!links.contains(e.target) && e.target !== btn) {
        links.classList.remove('open');
        btn.setAttribute('aria-expanded', 'false');
        icon.className = 'ti ti-menu-2';
      }
    });

    // Close on Escape key
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && links.classList.contains('open')) {
        links.classList.remove('open');
        btn.setAttribute('aria-expanded', 'false');
        icon.className = 'ti ti-menu-2';
        btn.focus();
      }
    });
  })();
</script>

