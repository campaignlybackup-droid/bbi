<%- include('partials/header') %>

<div style="text-align:center;padding:var(--space-16) var(--space-4)">
  <div style="font-size:64px;font-weight:800;color:var(--navy);margin-bottom:var(--space-3)">404</div>
  <div style="font-size:var(--font-size-lg);font-weight:700;color:var(--text-primary);margin-bottom:var(--space-2)">Page not found</div>
  <div style="font-size:var(--font-size-sm);color:var(--text-secondary);margin-bottom:var(--space-6);max-width:400px;margin-left:auto;margin-right:auto">The page you're looking for doesn't exist or has been moved.</div>
  <form action="/search" method="GET" class="search-bar" style="max-width:400px;margin:0 auto var(--space-6)">
    <input type="text" name="q" placeholder="Search businesses…" aria-label="Search">
    <button type="submit">Search</button>
  </form>
  <a href="/" class="btn btn-primary"><i class="ti ti-home"></i> Go Home</a>
</div>

<%- include('partials/footer') %>
