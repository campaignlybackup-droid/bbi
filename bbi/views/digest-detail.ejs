<%- include('partials/header') %>

<div class="page-header" style="background:var(--card-bg);padding:var(--space-8) var(--space-4);text-align:center;border-bottom:1px solid var(--border-light)">
  <div style="font-size:var(--font-size-sm);color:var(--accent-color);font-weight:600;margin-bottom:var(--space-2);text-transform:uppercase;letter-spacing:1px">
    <a href="/digest" style="color:inherit;text-decoration:none">Monthly Digest</a>
  </div>
  <h1 style="margin:0 0 var(--space-4) 0;font-size:42px;color:var(--text-primary)"><%= digest.month_display %></h1>
  <p style="margin:0;color:var(--text-secondary);font-size:var(--font-size-lg);max-width:600px;margin:0 auto">
    <%= digest.summary %>
  </p>
</div>

<div class="section" style="max-width:800px;margin:0 auto">

  <% const sections = JSON.parse(digest.content_json); %>

  <% if (sections.biggestMovers && sections.biggestMovers.length > 0) { %>
    <div style="margin-bottom:var(--space-10)">
      <h2 style="font-size:28px;color:var(--text-primary);border-bottom:2px solid var(--accent-color);padding-bottom:var(--space-2);display:inline-block;margin-bottom:var(--space-6)">🚀 Biggest Movers</h2>
      <div class="grid">
        <% sections.biggestMovers.forEach(biz => { %>
          <a href="/business/<%= biz.slug %>" class="card" style="text-decoration:none;display:block;padding:var(--space-4);transition:transform 0.2s;box-shadow:var(--shadow-sm)">
            <div style="font-size:12px;color:var(--text-muted);margin-bottom:var(--space-1)"><%= biz.cat_name %> &bull; <%= biz.city_name %></div>
            <h3 style="margin:0 0 var(--space-2) 0;color:var(--text-primary);font-size:18px"><%= biz.name %></h3>
            <div style="display:flex;justify-content:space-between;align-items:center;margin-top:var(--space-4)">
              <span style="font-size:14px;color:var(--text-secondary)">Rank #<%= biz.current_rank %></span>
              <span class="badge badge-success" style="font-size:14px;padding:4px 8px">
                <i class="ti ti-arrow-up"></i> <%= biz.diff %> spots
              </span>
            </div>
          </a>
        <% }) %>
      </div>
    </div>
  <% } %>

  <% if (sections.newEntrants && sections.newEntrants.length > 0) { %>
    <div style="margin-bottom:var(--space-10)">
      <h2 style="font-size:28px;color:var(--text-primary);border-bottom:2px solid var(--success);padding-bottom:var(--space-2);display:inline-block;margin-bottom:var(--space-6)">🌟 New Entrants to Top 10</h2>
      <div class="grid">
        <% sections.newEntrants.forEach(biz => { %>
          <a href="/business/<%= biz.slug %>" class="card" style="text-decoration:none;display:block;padding:var(--space-4);transition:transform 0.2s;box-shadow:var(--shadow-sm);border-left:4px solid var(--success)">
            <div style="font-size:12px;color:var(--text-muted);margin-bottom:var(--space-1)"><%= biz.cat_name %> &bull; <%= biz.city_name %></div>
            <h3 style="margin:0 0 var(--space-2) 0;color:var(--text-primary);font-size:18px"><%= biz.name %></h3>
            <div style="display:flex;justify-content:space-between;align-items:center;margin-top:var(--space-4)">
              <span style="font-size:14px;font-weight:600;color:var(--success)">New at #<%= biz.current_rank %></span>
            </div>
          </a>
        <% }) %>
      </div>
    </div>
  <% } %>

  <% if (sections.cityHighlights && sections.cityHighlights.length > 0) { %>
    <div style="margin-bottom:var(--space-10)">
      <h2 style="font-size:28px;color:var(--text-primary);border-bottom:2px solid var(--gold);padding-bottom:var(--space-2);display:inline-block;margin-bottom:var(--space-6)">🏙️ City Highlights</h2>
      <% sections.cityHighlights.forEach(city => { %>
        <div class="card" style="margin-bottom:var(--space-4);padding:var(--space-6)">
          <h3 style="margin:0 0 var(--space-4) 0;font-size:20px;color:var(--text-primary)"><%= city.city_name %> Updates</h3>
          <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:var(--space-3)">
            <% city.achievements.forEach(ach => { %>
              <li style="display:flex;align-items:flex-start;gap:var(--space-3)">
                <div style="color:var(--gold);margin-top:2px"><i class="ti ti-medal"></i></div>
                <div>
                  <a href="/business/<%= ach.slug %>" style="font-weight:600;color:var(--text-primary);text-decoration:none"><%= ach.name %></a>
                  <span style="color:var(--text-secondary)"> <%= ach.description %></span>
                </div>
              </li>
            <% }) %>
          </ul>
        </div>
      <% }) %>
    </div>
  <% } %>

</div>

<script>
document.querySelectorAll('.card').forEach(card => {
  if (card.tagName.toLowerCase() === 'a') {
    card.addEventListener('mouseenter', () => {
      card.style.transform = 'translateY(-4px)';
      card.style.boxShadow = 'var(--shadow-md)';
    });
    card.addEventListener('mouseleave', () => {
      card.style.transform = 'none';
      card.style.boxShadow = 'var(--shadow-sm)';
    });
  }
});
</script>

<%- include('partials/footer') %>
