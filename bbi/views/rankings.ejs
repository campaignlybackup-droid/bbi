<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> — BBI</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css">
</head>
<body>

<nav class="nav">
  <a href="/" class="nav-logo">BBI <span>·</span> Bharat Business Index</a>
  <div class="nav-links">
    <a href="/methodology">Methodology</a>
    <a href="/admin" class="nav-cta">Admin</a>
  </div>
</nav>

<div style="background:#0D2E5E;padding:28px 40px">
  <div style="font-size:12px;color:rgba(255,255,255,.5);margin-bottom:6px"><a href="/" style="color:rgba(255,255,255,.5)">Home</a> / Rankings</div>
  <h1 style="font-size:22px;font-weight:700;color:#fff;margin-bottom:4px">Top <%= cat.name %> in <%= city.name %></h1>
  <p style="font-size:13px;color:rgba(255,255,255,.6)"><%= latest_date %> · <%= rankings.length %> businesses ranked</p>
</div>

<div class="section">

  <% if(gainers.length || decliners.length) { %>
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:28px">
    <div style="background:#fff;border:1px solid #e8ecf0;border-radius:9px;padding:16px">
      <div style="font-size:12px;font-weight:600;color:#4A5568;text-transform:uppercase;letter-spacing:.5px;margin-bottom:10px">Biggest Gainers</div>
      <% gainers.forEach(b => { %>
      <div style="display:flex;justify-content:space-between;align-items:center;padding:5px 0;border-bottom:1px solid #f5f6f8;font-size:13px">
        <a href="/business/<%= b.slug %>" style="color:#1A1A2E"><%= b.name %></a>
        <span class="move move-up">↑ +<%= b.movement.diff %></span>
      </div>
      <% }) %>
    </div>
    <div style="background:#fff;border:1px solid #e8ecf0;border-radius:9px;padding:16px">
      <div style="font-size:12px;font-weight:600;color:#4A5568;text-transform:uppercase;letter-spacing:.5px;margin-bottom:10px">Biggest Decliners</div>
      <% if(decliners.length) { decliners.forEach(b => { %>
      <div style="display:flex;justify-content:space-between;align-items:center;padding:5px 0;border-bottom:1px solid #f5f6f8;font-size:13px">
        <a href="/business/<%= b.slug %>" style="color:#1A1A2E"><%= b.name %></a>
        <span class="move move-down">↓ −<%= b.movement.diff %></span>
      </div>
      <% }) } else { %><div style="font-size:13px;color:#4A5568">No decliners this period.</div><% } %>
    </div>
  </div>
  <% } %>

  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th width="60">Rank</th>
          <th>Business</th>
          <th>Location</th>
          <th>Score</th>
          <th>Movement</th>
          <th>Badge</th>
        </tr>
      </thead>
      <tbody>
        <% rankings.forEach(b => { %>
        <tr>
          <td><strong style="color:#0D2E5E;font-size:16px">#<%= b.rank_position %></strong></td>
          <td>
            <a href="/business/<%= b.slug %>" style="font-weight:600;color:#1A1A2E"><%= b.name %></a>
            <% if(b.sponsored) { %><span class="tag-sponsored" style="margin-left:6px">Sponsored</span><% } %>
            <% if(b.verified) { %><span class="tag-verified" style="margin-left:4px">Verified</span><% } %>
          </td>
          <td style="color:#4A5568;font-size:13px"><%= b.address || '—' %></td>
          <td>
            <div style="display:flex;align-items:center;gap:8px">
              <div style="width:60px;background:#F5F6F8;border-radius:3px;height:5px;overflow:hidden"><div style="width:<%= b.final_score %>%;height:5px;background:#0D2E5E;border-radius:3px"></div></div>
              <span style="font-size:13px;font-weight:600;color:#1A1A2E"><%= Math.round(b.final_score) %></span>
            </div>
          </td>
          <td><span class="move move-<%= b.movement.direction %>"><%= b.movement.label %></span></td>
          <td><% if(b.badge) { %><span class="badge badge-gold"><%= b.badge %></span><% } %></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<footer>
  <div class="logo">BBI <span>·</span> Bharat Business Index</div>
  <div class="footer-links"><a href="/methodology">Methodology</a><a href="#">Contact</a></div>
  <div class="footer-copy">© 2026 BBI. Rankings are independent.</div>
</footer>

</body>
</html>
