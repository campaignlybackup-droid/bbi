<%- include('partials/header') %>

<div class="page-header">
  <h1>Browse All Rankings</h1>
  <p>Discover independent, transparent rankings across India's top cities and categories.</p>
</div>

<div class="section">
  <!-- Filters -->
  <div style="background:var(--card-bg);border:1px solid var(--border-light);border-radius:var(--radius-lg);padding:var(--space-4);margin-bottom:var(--space-6);display:flex;gap:var(--space-4);flex-wrap:wrap">
    <div style="flex:1;min-width:200px">
      <label style="display:block;font-size:var(--font-size-sm);font-weight:600;margin-bottom:var(--space-2)">Filter by City</label>
      <select id="cityFilter" class="form-group" style="margin-bottom:0" onchange="filterRankings()">
        <option value="">All Cities</option>
        <% cities.forEach(c => { %>
          <option value="<%= c.slug %>"><%= c.name %></option>
        <% }) %>
      </select>
    </div>
    <div style="flex:1;min-width:200px">
      <label style="display:block;font-size:var(--font-size-sm);font-weight:600;margin-bottom:var(--space-2)">Filter by Category</label>
      <select id="catFilter" class="form-group" style="margin-bottom:0" onchange="filterRankings()">
        <option value="">All Categories</option>
        <% categories.forEach(cat => { %>
          <option value="<%= cat.slug %>"><%= cat.name %></option>
        <% }) %>
      </select>
    </div>
  </div>

  <!-- Rankings Grid -->
  <div class="grid" id="rankingsGrid">
    <% if (combos.length === 0) { %>
      <div style="grid-column:1/-1;text-align:center;padding:var(--space-8);color:var(--text-muted)">
        <i class="ti ti-folder-off" style="font-size:48px;margin-bottom:var(--space-4);opacity:0.5"></i>
        <h3>No rankings available yet.</h3>
      </div>
    <% } %>

    <% combos.forEach(combo => { %>
      <a href="/rankings/<%= combo.city_slug %>/<%= combo.cat_slug %>" 
         class="card ranking-card" 
         data-city="<%= combo.city_slug %>" 
         data-cat="<%= combo.cat_slug %>"
         style="text-decoration:none;display:flex;flex-direction:column;align-items:center;text-align:center;padding:var(--space-6);transition:transform 0.2s, box-shadow 0.2s">
        
        <div style="width:64px;height:64px;border-radius:50%;background:var(--accent-light);color:var(--accent-color);display:flex;align-items:center;justify-content:center;font-size:32px;margin-bottom:var(--space-4)">
          <i class="ti <%= combo.icon || 'ti-star' %>"></i>
        </div>
        
        <h3 style="margin:0 0 var(--space-2) 0;font-size:var(--font-size-lg);color:var(--text-primary)">
          Top <%= combo.cat_name %>
        </h3>
        <p style="margin:0;color:var(--text-muted);font-weight:500">
          in <%= combo.city_name %>
        </p>
        
        <div style="margin-top:auto;padding-top:var(--space-4);color:var(--accent-color);font-weight:600;font-size:var(--font-size-sm);display:flex;align-items:center;gap:4px">
          View Rankings <i class="ti ti-arrow-right"></i>
        </div>
      </a>
    <% }) %>
  </div>
</div>

<script>
function filterRankings() {
  const city = document.getElementById('cityFilter').value;
  const cat = document.getElementById('catFilter').value;
  const cards = document.querySelectorAll('.ranking-card');
  let visibleCount = 0;

  cards.forEach(card => {
    const cardCity = card.getAttribute('data-city');
    const cardCat = card.getAttribute('data-cat');
    const matchCity = !city || cardCity === city;
    const matchCat = !cat || cardCat === cat;

    if (matchCity && matchCat) {
      card.style.display = 'flex';
      visibleCount++;
    } else {
      card.style.display = 'none';
    }
  });

  // Optional: show "No results found" if visibleCount === 0
}

// Add hover effects via JS or inline CSS
document.querySelectorAll('.ranking-card').forEach(card => {
  card.addEventListener('mouseenter', () => {
    card.style.transform = 'translateY(-4px)';
    card.style.boxShadow = 'var(--shadow-md)';
  });
  card.addEventListener('mouseleave', () => {
    card.style.transform = 'none';
    card.style.boxShadow = 'var(--shadow-sm)';
  });
});
</script>

<%- include('partials/footer') %>
