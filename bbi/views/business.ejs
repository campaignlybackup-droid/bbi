<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> — BBI</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css">
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "name": "<%= business.name %>",
    "address": "<%= business.address %>",
    "telephone": "<%= business.phone %>",
    "url": "<%= business.website %>"
  }
  </script>
</head>
<body>

<nav class="nav">
  <a href="/" class="nav-logo">BBI <span>·</span> Bharat Business Index</a>
  <div class="nav-links"><a href="/methodology">Methodology</a></div>
</nav>

<div style="background:#0D2E5E;padding:28px 40px">
  <div style="font-size:12px;color:rgba(255,255,255,.5);margin-bottom:6px">
    <a href="/" style="color:rgba(255,255,255,.5)">Home</a> /
    <a href="/rankings/<%= business.city_name.toLowerCase().replace(/ /g,'-') %>/<%= business.cat_slug %>" style="color:rgba(255,255,255,.5)"><%= business.cat_name %></a>
  </div>
  <h1 style="font-size:22px;font-weight:700;color:#fff;margin-bottom:6px"><%= business.name %></h1>
  <p style="font-size:13px;color:rgba(255,255,255,.6)"><%= business.cat_name %> · <%= business.city_name %></p>
</div>

<div class="section">

  <% if(latest) { %>
  <!-- AI search optimized statement -->
  <div style="background:#fff;border:1px solid #e8ecf0;border-radius:9px;padding:14px 18px;margin-bottom:16px;font-size:13px;color:#4A5568;line-height:1.7">
    <strong style="color:#1A1A2E"><%= business.name %></strong> is currently ranked
    <strong style="color:#0D2E5E">#<%= latest.rank_position %></strong> among <%= business.cat_name %> in <%= business.city_name %>
    according to Bharat Business Index's <%= latest.ranking_date.slice(0,7) %> rankings.
    This ranking is based on review ratings, customer feedback, online reputation, business completeness, and editorial assessment.
  </div>
  <% } %>

  <div style="display:grid;grid-template-columns:2fr 1fr;gap:16px">

    <div>
      <!-- Score breakdown -->
      <% if(scores) { %>
      <div style="background:#fff;border:1px solid #e8ecf0;border-radius:9px;padding:18px;margin-bottom:16px">
        <div style="font-size:14px;font-weight:600;color:#1A1A2E;margin-bottom:14px;padding-bottom:10px;border-bottom:1px solid #f0f2f5">
          Ranking score: <%= Math.round(scores.final_score) %> / 100
        </div>
        <% const factors = [
          ['Customer Reviews', scores.review_score, 35],
          ['Review Volume', scores.volume_score, 25],
          ['Website Quality', scores.website_score, 15],
          ['Social Presence', scores.social_score, 10],
          ['Years in Business', scores.years_score, 10],
          ['Editorial Score', scores.editorial_score, 15]
        ]; %>
        <% factors.forEach(([label, val, max]) => { %>
        <div style="display:flex;align-items:center;gap:10px;margin-bottom:8px">
          <div style="min-width:140px;font-size:12px;color:#4A5568"><%= label %></div>
          <div style="flex:1;background:#F5F6F8;border-radius:3px;height:6px;overflow:hidden">
            <div style="width:<%= max>0 ? (val/max*100) : 0 %>%;height:6px;background:#0D2E5E;border-radius:3px"></div>
          </div>
          <div style="font-size:12px;font-weight:600;color:#1A1A2E;min-width:50px;text-align:right"><%= Math.round(val) %> / <%= max %></div>
        </div>
        <% }) %>
      </div>
      <% } %>

      <!-- Why ranked -->
      <% if(reasons.length) { %>
      <div style="background:#fff;border:1px solid #e8ecf0;border-radius:9px;padding:18px;margin-bottom:16px">
        <div style="font-size:14px;font-weight:600;color:#1A1A2E;margin-bottom:12px">Why we ranked <%= business.name %> #<%= latest ? latest.rank_position : '' %></div>
        <% reasons.forEach(r => { %>
        <div style="display:flex;align-items:center;gap:8px;padding:5px 0;border-bottom:1px solid #f5f6f8;font-size:13px;color:#4A5568">
          <div style="width:6px;height:6px;border-radius:50%;background:#E8A020;flex-shrink:0"></div>
          <%= r %>
        </div>
        <% }) %>
      </div>
      <% } %>
    </div>

    <div>
      <!-- Business info -->
      <div style="background:#fff;border:1px solid #e8ecf0;border-radius:9px;padding:18px;margin-bottom:16px">
        <div style="font-size:14px;font-weight:600;color:#1A1A2E;margin-bottom:12px">Business details</div>
        <% if(business.address) { %>
        <div style="font-size:13px;color:#4A5568;margin-bottom:8px;display:flex;gap:8px"><i class="ti ti-map-pin" style="color:#0D2E5E;flex-shrink:0"></i><%= business.address %></div>
        <% } %>
        <% if(business.phone) { %>
        <div style="font-size:13px;color:#4A5568;margin-bottom:8px;display:flex;gap:8px"><i class="ti ti-phone" style="color:#0D2E5E;flex-shrink:0"></i><%= business.phone %></div>
        <% } %>
        <% if(business.website) { %>
        <div style="font-size:13px;margin-bottom:8px;display:flex;gap:8px"><i class="ti ti-world" style="color:#0D2E5E;flex-shrink:0"></i><a href="<%= business.website %>" target="_blank" style="color:#0D2E5E"><%= business.website %></a></div>
        <% } %>
        <% if(business.google_rating) { %>
        <div style="font-size:13px;color:#4A5568;display:flex;gap:8px"><i class="ti ti-star" style="color:#E8A020;flex-shrink:0"></i><%= business.google_rating %> · <%= business.google_review_count %> reviews</div>
        <% } %>
      </div>

      <!-- Ranking history timeline -->
      <% if(history.length) { %>
      <div style="background:#fff;border:1px solid #e8ecf0;border-radius:9px;padding:18px;margin-bottom:16px">
        <div style="font-size:14px;font-weight:600;color:#1A1A2E;margin-bottom:14px">Ranking history</div>
        <% history.forEach((h,i) => { %>
        <div style="display:flex;align-items:center;gap:10px;padding:5px 0;border-bottom:1px solid #f5f6f8">
          <div style="font-size:16px;font-weight:700;color:<%= i===history.length-1?'#E8A020':'#0D2E5E' %>;min-width:32px">#<%= h.rank_position %></div>
          <div>
            <div style="font-size:12px;font-weight:600;color:#1A1A2E"><%= h.ranking_date.slice(0,7) %></div>
            <div style="font-size:11px;color:#4A5568">Score <%= Math.round(h.final_score) %></div>
          </div>
        </div>
        <% }) %>
      </div>
      <% } %>

      <!-- Achievements -->
      <% if(achievements.length) { %>
      <div style="background:#fff;border:1px solid #e8ecf0;border-radius:9px;padding:18px">
        <div style="font-size:14px;font-weight:600;color:#1A1A2E;margin-bottom:12px">Achievements</div>
        <% achievements.forEach(a => { %>
        <div style="padding:5px 0;border-bottom:1px solid #f5f6f8;font-size:13px">
          <span style="color:#E8A020;font-weight:600"><%= a.achieved_at %></span>
          <span style="color:#4A5568;margin-left:8px"><%= a.title %></span>
        </div>
        <% }) %>
      </div>
      <% } %>
    </div>
  </div>
</div>

<footer>
  <div class="logo">BBI <span>·</span> Bharat Business Index</div>
  <div class="footer-links"><a href="/methodology">Methodology</a></div>
  <div class="footer-copy">© 2026 BBI. Rankings are independent.</div>
</footer>

</body>
</html>
