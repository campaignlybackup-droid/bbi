<%- include('layout-top') %>

<div class="admin-header">
  <div class="admin-header-content">
    <h1 class="admin-title">SEO Canonical Conflicts</h1>
    <p class="admin-subtitle">Detect and resolve URL collisions generated by the Programmatic SEO engine.</p>
  </div>
</div>

<% if(flash && flash.success) { %><div class="alert alert-success"><%= flash.success %></div><% } %>
<% if(flash && flash.error) { %><div class="alert alert-error"><%= flash.error %></div><% } %>

<div class="card">
  <div class="card-header">
    <h2 class="card-title">Conflict Report</h2>
  </div>
  <div class="card-body">
    <% if (conflicts.length === 0) { %>
      <div class="alert alert-success" style="margin: 0;">
        <i class="ti ti-check"></i> Great job! No URL conflicts detected across the programmatic SEO engine.
      </div>
    <% } else { %>
      <div class="alert alert-error" style="margin-bottom: var(--space-4);">
        <i class="ti ti-alert-triangle"></i> Found <%= conflicts.length %> conflicting URL(s). These need to be resolved to prevent duplicate content indexing issues.
      </div>
      <table class="table" style="width: 100%;">
        <thead>
          <tr>
            <th>Conflicting URL</th>
            <th>Involved Entities</th>
            <th>Suggested Resolution</th>
          </tr>
        </thead>
        <tbody>
          <% conflicts.forEach(conflict => { %>
            <tr>
              <td><strong style="color: var(--error);"><%= conflict.url %></strong></td>
              <td>
                <ul style="padding-left: 16px; margin: 0; font-size: 13px;">
                  <% conflict.entities.forEach(entity => { %>
                    <li><strong><%= entity.type %>:</strong> <%= entity.name %> (ID: <%= entity.id %>)</li>
                  <% }) %>
                </ul>
              </td>
              <td style="font-size: 13px; color: var(--text-muted);">
                <%= conflict.resolution %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </div>
</div>

<%- include('layout-bottom') %>
