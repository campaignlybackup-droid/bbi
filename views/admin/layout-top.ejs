<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> — BBI Admin</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css">
  <link rel="icon" href="/favicon.ico" type="image/x-icon">
</head>
<body>
<div class="admin-overlay" id="adminOverlay"></div>
<div class="admin-wrap">
  <div class="sidebar" id="adminSidebar">
    <div class="sidebar-logo">BBI <span>·</span> Admin</div>
    <nav class="sidebar-nav">
      <div class="sidebar-section">Main</div>
      <a href="/admin" class="<%= currentPath==='/admin'?'active':'' %>"><i class="ti ti-layout-dashboard"></i> Dashboard</a>
      <div class="sidebar-section">Content CMS</div>
      <a href="/admin/pages" class="<%= currentPath.startsWith('/admin/pages')?'active':'' %>"><i class="ti ti-seo"></i> SEO Pages</a>
      <a href="/admin/blog" class="<%= currentPath.startsWith('/admin/blog')?'active':'' %>"><i class="ti ti-article"></i> Blog Posts</a>
      <a href="/admin/digests" class="<%= currentPath.startsWith('/admin/digests')?'active':'' %>"><i class="ti ti-calendar-event"></i> Monthly Digests</a>
      <div class="sidebar-section">Data Management</div>
      <a href="/admin/businesses" class="<%= currentPath.startsWith('/admin/businesses')?'active':'' %>"><i class="ti ti-building-store"></i> Businesses</a>
      <a href="/admin/csv-import" class="<%= currentPath==='/admin/csv-import'?'active':'' %>"><i class="ti ti-file-import"></i> CSV Import</a>
      <a href="/admin/csv-import/history" class="<%= currentPath.startsWith('/admin/csv-import/history')?'active':'' %>"><i class="ti ti-history"></i> Import History</a>
      <a href="/admin/import" class="<%= currentPath.startsWith('/admin/import')?'active':'' %>"><i class="ti ti-cloud-download"></i> Google Import</a>
      <a href="/admin/rankings" class="<%= currentPath.startsWith('/admin/rankings')?'active':'' %>"><i class="ti ti-trophy"></i> Auto Ranks</a>
      <a href="/admin/pages" class="<%= currentPath.startsWith('/admin/pages')?'active':'' %>"><i class="ti ti-sitemap"></i> Pages & SEO</a>
      <a href="/admin/cities" class="<%= currentPath.startsWith('/admin/cities')?'active':'' %>"><i class="ti ti-map-pin"></i> Cities</a>
      <a href="/admin/categories" class="<%= currentPath.startsWith('/admin/categories')?'active':'' %>"><i class="ti ti-category"></i> Categories</a>
      <div class="sidebar-section">Workflows</div>
      <a href="/admin/inquiries" class="<%= currentPath.startsWith('/admin/inquiries')?'active':'' %>"><i class="ti ti-mail"></i> Inquiries</a>
      <a href="/admin/claims" class="<%= currentPath.startsWith('/admin/claims')?'active':'' %>"><i class="ti ti-shield-check"></i> Claims</a>
      <div class="sidebar-section">Insights</div>
      <a href="/admin/analytics" class="<%= currentPath.startsWith('/admin/analytics')?'active':'' %>"><i class="ti ti-chart-bar"></i> Analytics</a>
      <a href="/admin/audit-logs" class="<%= currentPath.startsWith('/admin/audit-logs')?'active':'' %>"><i class="ti ti-list-details"></i> Audit Logs</a>
      <a href="/admin/ai-logs" class="<%= currentPath.startsWith('/admin/ai-logs')?'active':'' %>"><i class="ti ti-robot"></i> AI Logs</a>
      <div class="sidebar-section">System</div>
      <% if(admin.adminRole === 'superadmin') { %>
      <a href="/admin/settings" class="<%= currentPath.startsWith('/admin/settings')?'active':'' %>"><i class="ti ti-settings"></i> Global Settings</a>
      <a href="/admin/admins" class="<%= currentPath.startsWith('/admin/admins')?'active':'' %>"><i class="ti ti-users"></i> Admin Users</a>
      <% } %>
      <a href="/" target="_blank"><i class="ti ti-external-link"></i> View Site</a>
      <a href="/admin/logout"><i class="ti ti-logout"></i> Logout</a>
    </nav>
  </div>
  <div class="admin-content">
    <div class="admin-topbar">
      <div style="display:flex;align-items:center">
        <button class="mobile-menu-btn" id="mobileMenuBtn"><i class="ti ti-menu-2"></i></button>
        <h1><%= title %></h1>
      </div>
      <span style="font-size:var(--font-size-sm);color:var(--text-secondary)">Logged in as <strong><%= admin.adminName %></strong></span>
    </div>
    <div class="admin-main">
    
<script>
  const mobileMenuBtn = document.getElementById('mobileMenuBtn');
  const adminSidebar = document.getElementById('adminSidebar');
  const adminOverlay = document.getElementById('adminOverlay');

  function toggleSidebar() {
    adminSidebar.classList.toggle('open');
    adminOverlay.classList.toggle('open');
  }

  mobileMenuBtn.addEventListener('click', toggleSidebar);
  adminOverlay.addEventListener('click', toggleSidebar);
</script>
