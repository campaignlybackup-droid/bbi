<%- include('layout-top') %>

<div class="row mb-4 align-items-center">
  <div class="col-md-6">
    <h1 class="h3 text-gray-800"><%= title %></h1>
  </div>
  <div class="col-md-6 text-right">
    <a href="/admin/seo-engine" class="btn btn-secondary btn-sm">Back to Dashboard</a>
  </div>
</div>

<div class="row">
  <div class="col-md-4">
    <div class="card shadow mb-4">
      <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">Add New Area/Locality</h6>
      </div>
      <div class="card-body">
        <form action="/admin/seo-engine/areas" method="POST">
          <div class="form-group">
            <label>Area Name</label>
            <input type="text" name="name" class="form-control" required placeholder="e.g. Malviya Nagar">
          </div>
          <div class="form-group">
            <label>City</label>
            <select name="city_id" class="form-control" required>
              <option value="">Select City...</option>
              <% cities.forEach(city => { %>
                <option value="<%= city.id %>"><%= city.name %></option>
              <% }) %>
            </select>
          </div>
          <button type="submit" class="btn btn-primary btn-block">Add Area</button>
        </form>
      </div>
    </div>
  </div>
  <div class="col-md-8">
    <div class="card shadow mb-4">
      <div class="card-body">
        <div class="table-responsive">
          <table class="table table-bordered table-sm" width="100%" cellspacing="0">
            <thead>
              <tr>
                <th>ID</th>
                <th>Area Name</th>
                <th>City</th>
                <th>Slug</th>
                <th>Active</th>
              </tr>
            </thead>
            <tbody>
              <% areas.forEach(area => { %>
                <tr>
                  <td><%= area.id %></td>
                  <td><%= area.name %></td>
                  <td><%= area.city_name %></td>
                  <td><%= area.slug %></td>
                  <td>
                    <span class="badge <%= area.active ? 'badge-success' : 'badge-secondary' %>">
                      <%= area.active ? 'Yes' : 'No' %>
                    </span>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('layout-bottom') %>
