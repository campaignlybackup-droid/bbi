<%- include('layout-top') %>

<% if(flash.success) { %><div class="alert alert-success"><i class="ti ti-check"></i> <%- flash.success %></div><% } %>
<% if(flash.error) { %><div class="alert alert-error"><i class="ti ti-alert-circle"></i> <%- flash.error %></div><% } %>

<!-- Import Info Header -->
<div style="background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius-lg);padding:var(--space-6);margin-bottom:var(--space-4)">
  <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:var(--space-3)">
    <div>
      <h3 style="margin:0">Import #<%= importData.id %></h3>
      <p style="color:var(--text-secondary);font-size:var(--font-size-sm);margin:var(--space-1) 0 0">
        File: <strong><%= importData.filename %></strong>
        <% if(importData.admin_name) { %> · by <strong><%= importData.admin_name %></strong><% } %>
      </p>
    </div>
    <div>
      <% if(importData.status === 'completed') { %>
        <span style="background:#dcfce7;color:#166534;padding:var(--space-1) var(--space-3);border-radius:var(--radius-full);font-size:var(--font-size-sm);font-weight:600">
          <i class="ti ti-check"></i> Completed
        </span>
      <% } else if(importData.status === 'rolled_back') { %>
        <span style="background:#fef3c7;color:#92400e;padding:var(--space-1) var(--space-3);border-radius:var(--radius-full);font-size:var(--font-size-sm);font-weight:600">
          <i class="ti ti-rotate"></i> Rolled Back
        </span>
      <% } else if(importData.status === 'failed') { %>
        <span style="background:#fee2e2;color:#991b1b;padding:var(--space-1) var(--space-3);border-radius:var(--radius-full);font-size:var(--font-size-sm);font-weight:600">
          <i class="ti ti-x"></i> Failed
        </span>
      <% } else { %>
        <span style="background:#dbeafe;color:#1e40af;padding:var(--space-1) var(--space-3);border-radius:var(--radius-full);font-size:var(--font-size-sm);font-weight:600">
          <%= importData.status %>
        </span>
      <% } %>
    </div>
  </div>

  <div class="stat-grid" style="grid-template-columns:repeat(4,1fr)">
    <div class="stat-card"><div class="stat-num"><%= importData.total_rows %></div><div class="stat-label">Total Rows</div></div>
    <div class="stat-card" style="border-left:3px solid #22c55e"><div class="stat-num"><%= importData.imported_rows %></div><div class="stat-label">Imported</div></div>
    <div class="stat-card" style="border-left:3px solid #ef4444"><div class="stat-num"><%= importData.failed_rows %></div><div class="stat-label">Failed</div></div>
    <div class="stat-card" style="border-left:3px solid #f59e0b"><div class="stat-num"><%= importData.skipped_rows %></div><div class="stat-label">Skipped</div></div>
  </div>

  <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:var(--space-4);font-size:var(--font-size-sm);margin-top:var(--space-3)">
    <div><span style="color:var(--text-secondary)">Created:</span> <strong><%= importData.created_at ? importData.created_at.slice(0,16).replace('T',' ') : '—' %></strong></div>
    <div><span style="color:var(--text-secondary)">Started:</span> <strong><%= importData.started_at ? importData.started_at.slice(0,16).replace('T',' ') : '—' %></strong></div>
    <div><span style="color:var(--text-secondary)">Completed:</span> <strong><%= importData.completed_at ? importData.completed_at.slice(0,16).replace('T',' ') : '—' %></strong></div>
  </div>
</div>

<!-- Row-by-Row Breakdown -->
<div style="background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius-lg);padding:var(--space-4)">
  <h4 style="margin:0 0 var(--space-3) 0"><i class="ti ti-list"></i> Row Details (<%= (importData.rows || []).length %> rows)</h4>
  <div class="table-wrap" style="max-height:600px;overflow:auto">
    <table style="font-size:var(--font-size-xs)">
      <thead>
        <tr><th>#</th><th>Status</th><th>Business</th><th>SEO</th><th>Content</th><th>Error</th></tr>
      </thead>
      <tbody>
        <% (importData.rows || []).forEach(row => { %>
        <%
          let rowData = {};
          try { rowData = JSON.parse(row.raw_data || '{}'); } catch(e) {}
        %>
        <tr style="<%= row.status === 'failed' ? 'background:#fef2f2' : row.status === 'skipped' ? 'background:#fffbeb' : '' %>">
          <td><%= row.row_number %></td>
          <td>
            <% if(row.status === 'imported') { %>
              <span style="color:#16a34a;font-weight:600">✓ Imported</span>
            <% } else if(row.status === 'failed') { %>
              <span style="color:#ef4444;font-weight:600">✗ Failed</span>
            <% } else if(row.status === 'skipped') { %>
              <span style="color:#f59e0b;font-weight:600">⊘ Skipped</span>
            <% } else if(row.status === 'rolled_back') { %>
              <span style="color:#6b7280;font-weight:600">↺ Rolled Back</span>
            <% } else { %>
              <span style="color:var(--text-secondary)"><%= row.status %></span>
            <% } %>
          </td>
          <td>
            <% if(row.business_name) { %>
              <a href="/admin/businesses/<%= row.business_id %>/edit" style="font-weight:600"><%= row.business_name %></a>
            <% } else if(row.business_slug) { %>
              <a href="/admin/businesses/<%= row.business_id %>/edit" style="font-weight:600"><%= row.business_slug %></a>
            <% } else { %>
              <span style="color:var(--text-secondary)"><%= rowData.business_name || '—' %></span>
            <% } %>
          </td>
          <td>
            <% if(row.seo_status === 'completed') { %>
              <span style="color:#16a34a">✓</span>
            <% } else if(row.seo_status === 'queued') { %>
              <span style="color:#f59e0b">⏳</span>
            <% } else { %>
              <span style="color:var(--text-tertiary)">—</span>
            <% } %>
          </td>
          <td>
            <% if(row.content_status === 'completed') { %>
              <span style="color:#16a34a">✓</span>
            <% } else if(row.content_status === 'queued') { %>
              <span style="color:#f59e0b">⏳</span>
            <% } else { %>
              <span style="color:var(--text-tertiary)">—</span>
            <% } %>
          </td>
          <td style="color:#ef4444;max-width:300px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="<%= row.error || '' %>">
            <%= row.error || '' %>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<!-- Actions -->
<div style="display:flex;gap:var(--space-3);margin-top:var(--space-4)">
  <% if(importData.status === 'completed') { %>
    <form action="/admin/csv-import/<%= importData.id %>/rollback" method="POST" onsubmit="return confirm('Rollback this import? All businesses from this import will be deactivated.')">
      <button type="submit" class="btn btn-outline" style="color:#ef4444;border-color:#fecaca">
        <i class="ti ti-rotate"></i> Rollback Import
      </button>
    </form>
  <% } %>
  <a href="/admin/csv-import/history" class="btn btn-outline"><i class="ti ti-arrow-left"></i> Back to History</a>
  <a href="/admin/csv-import" class="btn btn-outline"><i class="ti ti-plus"></i> New Import</a>
</div>

<%- include('layout-bottom') %>
