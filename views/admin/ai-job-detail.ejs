<%- include('layout-top') %>

<div class="header-action">
  <div>
    <h2 class="page-title">AI Job #<%= log.id %></h2>
    <p style="color:var(--text-muted);font-size:14px;margin-top:4px">Detailed view of the payload and response from the AI provider.</p>
  </div>
  <div>
    <a href="/admin/ai-logs" class="btn btn-outline"><i class="ti ti-arrow-left"></i> Back</a>
  </div>
</div>

<% if(flash && flash.success) { %><div class="alert alert-success"><i class="ti ti-check"></i> <%- flash.success %></div><% } %>
<% if(flash && flash.error) { %><div class="alert alert-error"><i class="ti ti-alert-circle"></i> <%- flash.error %></div><% } %>

<div class="grid-2" style="grid-template-columns: 1fr 350px; gap: 24px;">
  
  <div style="display:flex; flex-direction:column; gap:24px;">
    <div class="card">
      <h3 style="margin-top:0"><i class="ti ti-file-code" style="color:var(--navy);margin-right:8px"></i> Payload</h3>
      <p style="font-size:13px;color:var(--text-muted);margin-bottom:12px">The exact data sent to the AI model.</p>
      <% 
        let parsedPayload = log.payload;
        try { parsedPayload = JSON.stringify(JSON.parse(log.payload), null, 2); } catch(e) {} 
      %>
      <pre style="background:#1e1e1e;color:#d4d4d4;padding:16px;border-radius:8px;font-family:monospace;font-size:12px;overflow-x:auto;white-space:pre-wrap;"><%= parsedPayload || '{}' %></pre>
    </div>

    <div class="card">
      <h3 style="margin-top:0"><i class="ti ti-check" style="color:var(--success);margin-right:8px"></i> Result</h3>
      <p style="font-size:13px;color:var(--text-muted);margin-bottom:12px">The exact response generated by the AI model.</p>
      <% if (log.result) { %>
        <% 
          let parsedResult = log.result;
          try { parsedResult = JSON.stringify(JSON.parse(log.result), null, 2); } catch(e) {} 
        %>
        <pre style="background:#1e1e1e;color:#d4d4d4;padding:16px;border-radius:8px;font-family:monospace;font-size:12px;overflow-x:auto;white-space:pre-wrap;"><%= parsedResult %></pre>
      <% } else if (log.status === 'processing' || log.status === 'queued') { %>
        <div style="padding:24px;text-align:center;background:var(--bg);border-radius:8px;color:var(--text-muted)">
          <i class="ti ti-loader" style="font-size:32px;display:block;margin-bottom:8px"></i>
          Waiting for job to finish...
        </div>
      <% } else { %>
        <div style="padding:24px;text-align:center;background:var(--bg);border-radius:8px;color:var(--text-muted)">
          No result available.
        </div>
      <% } %>
    </div>
    
    <% if (log.error) { %>
      <div class="card" style="border-color:#fecaca;background:#fef2f2">
        <h3 style="margin-top:0;color:#dc2626"><i class="ti ti-alert-circle" style="margin-right:8px"></i> Error Log</h3>
        <pre style="background:#7f1d1d;color:#fecaca;padding:16px;border-radius:8px;font-family:monospace;font-size:12px;overflow-x:auto;white-space:pre-wrap;"><%= log.error %></pre>
      </div>
    <% } %>
  </div>

  <div style="display:flex; flex-direction:column; gap:24px;">
    <div class="card">
      <h3 style="margin-top:0">Job Details</h3>
      <div style="margin-top:16px;display:flex;flex-direction:column;gap:12px;font-size:14px">
        <div style="display:flex;justify-content:space-between;border-bottom:1px solid #eee;padding-bottom:8px">
          <strong style="color:var(--text-secondary)">Type:</strong>
          <span style="font-weight:600"><%= log.job_type %></span>
        </div>
        <div style="display:flex;justify-content:space-between;border-bottom:1px solid #eee;padding-bottom:8px">
          <strong style="color:var(--text-secondary)">Status:</strong>
          <span>
            <% if(log.status === 'completed') { %><span class="badge badge-verified">Completed</span><% } %>
            <% if(log.status === 'failed') { %><span class="badge badge-danger" style="background:#fef2f2;color:#dc2626;border:1px solid #fecaca">Failed</span><% } %>
            <% if(log.status === 'queued') { %><span class="badge badge-sponsored">Queued</span><% } %>
            <% if(log.status === 'processing') { %><span class="badge badge-blue">Processing</span><% } %>
          </span>
        </div>
        <div style="display:flex;justify-content:space-between;border-bottom:1px solid #eee;padding-bottom:8px">
          <strong style="color:var(--text-secondary)">Attempts:</strong>
          <span><%= log.attempts %> / <%= log.max_attempts %></span>
        </div>
        <div style="display:flex;justify-content:space-between;border-bottom:1px solid #eee;padding-bottom:8px">
          <strong style="color:var(--text-secondary)">Created:</strong>
          <span style="font-size:12px"><%= new Date(log.created_at).toLocaleString() %></span>
        </div>
        <% if(log.completed_at) { %>
        <div style="display:flex;justify-content:space-between;border-bottom:1px solid #eee;padding-bottom:8px">
          <strong style="color:var(--text-secondary)">Completed:</strong>
          <span style="font-size:12px"><%= new Date(log.completed_at).toLocaleString() %></span>
        </div>
        <% } %>
      </div>
    </div>
    
    <div class="card">
      <h3 style="margin-top:0">Actions</h3>
      <div style="margin-top:16px;display:flex;flex-direction:column;gap:8px">
        <form method="POST" action="/admin/ai-logs/<%= log.id %>/retry">
          <button class="btn btn-primary btn-block" style="width:100%" type="submit"><i class="ti ti-refresh"></i> Retry Job</button>
        </form>
        <form method="POST" action="/admin/ai-logs/<%= log.id %>/delete" onsubmit="return confirm('Delete this job? This cannot be undone.');">
          <button class="btn btn-danger btn-block" style="width:100%" type="submit"><i class="ti ti-trash"></i> Delete Job</button>
        </form>
      </div>
    </div>
  </div>

</div>

<%- include('layout-bottom') %>
