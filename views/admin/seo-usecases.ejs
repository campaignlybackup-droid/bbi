<%- include('../layout-top') %>

<div class="row mb-4 align-items-center">
  <div class="col-md-6">
    <h1 class="h3 text-gray-800"><%= title %></h1>
  </div>
  <div class="col-md-6 text-right">
    <a href="/admin/seo-engine" class="btn btn-secondary btn-sm">Back to Dashboard</a>
  </div>
</div>

<div class="row">
  <div class="col-md-4">
    <div class="card shadow mb-4">
      <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">Add New Use Case / Intent</h6>
      </div>
      <div class="card-body">
        <form action="/admin/seo-engine/use-cases" method="POST">
          <div class="form-group">
            <label>Use Case Intent</label>
            <input type="text" name="name" class="form-control" required placeholder="e.g. Weight Loss">
          </div>
          <div class="form-group">
            <label>Base Category</label>
            <select name="category_id" class="form-control" required>
              <option value="">Select Category...</option>
              <% categories.forEach(cat => { %>
                <option value="<%= cat.id %>"><%= cat.name %></option>
              <% }) %>
            </select>
          </div>
          <button type="submit" class="btn btn-primary btn-block">Add Use Case</button>
        </form>
      </div>
    </div>
  </div>
  <div class="col-md-8">
    <div class="card shadow mb-4">
      <div class="card-body">
        <div class="table-responsive">
          <table class="table table-bordered table-sm" width="100%" cellspacing="0">
            <thead>
              <tr>
                <th>ID</th>
                <th>Intent Name</th>
                <th>Category</th>
                <th>Slug</th>
                <th>Active</th>
              </tr>
            </thead>
            <tbody>
              <% useCases.forEach(uc => { %>
                <tr>
                  <td><%= uc.id %></td>
                  <td><%= uc.name %></td>
                  <td><%= uc.cat_name %></td>
                  <td><%= uc.slug %></td>
                  <td>
                    <span class="badge <%= uc.active ? 'badge-success' : 'badge-secondary' %>">
                      <%= uc.active ? 'Yes' : 'No' %>
                    </span>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../layout-bottom') %>
