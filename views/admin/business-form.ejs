<%- include('layout-top') %>

<% if(flash.error) { %><div class="alert alert-error"><%= flash.error %></div><% } %>

<form method="POST" action="/admin/businesses<%= business ? '/'+business.id : '' %>">
  <div style="display:grid;grid-template-columns:2fr 1fr;gap:16px">

    <div>
      <div class="form-card">
        <h3>Business Information</h3>
        <div class="form-group">
          <label style="display:flex;justify-content:space-between;align-items:center;">
            <span>Business Name *</span>
            <button type="button" class="btn btn-sm btn-outline" style="padding:2px 8px;font-size:11px;background:#E8F0FE;color:#1A73E8;border-color:#1A73E8" onclick="runGoogleMapsAutofill()" id="autofillBtn">
              <i class="ti ti-brand-google"></i> Auto-Fill from Maps
            </button>
          </label>
          <input type="text" name="name" value="<%= business ? business.name : '' %>" required>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label>City *</label>
            <select name="city_id" required>
              <option value="">Select city</option>
              <% cities.forEach(c => { %><option value="<%= c.id %>" <%= business && business.city_id==c.id ? 'selected':'' %>><%= c.name %></option><% }) %>
            </select>
          </div>
          <div class="form-group">
            <label>Category *</label>
            <select name="category_id" required>
              <option value="">Select category</option>
              <% categories.forEach(c => { %><option value="<%= c.id %>" <%= business && business.category_id==c.id ? 'selected':'' %>><%= c.name %></option><% }) %>
            </select>
          </div>
        </div>
        <div class="form-group">
          <label>Address</label>
          <input type="text" name="address" value="<%= business ? business.address||'' : '' %>">
        </div>
        <div class="form-row">
          <div class="form-group">
            <label>Phone</label>
            <input type="text" name="phone" value="<%= business ? business.phone||'' : '' %>">
          </div>
          <div class="form-group">
            <label>Website</label>
            <input type="text" name="website" value="<%= business ? business.website||'' : '' %>">
          </div>
        </div>
        <div class="form-group">
          <label>Tags (comma-separated)</label>
          <input type="text" name="tags" value="<%= business ? business.tags||'' : '' %>" placeholder="e.g., ppf, ceramic coating, detailing">
        </div>
        <div class="form-group">
          <label>Description</label>
          <textarea name="description" rows="3" style="resize:vertical"><%= business ? business.description||'' : '' %></textarea>
        </div>
      </div>

      <div class="form-card">
        <h3><i class="ti ti-tags" style="margin-right:4px"></i> Custom Attributes</h3>
        <p style="font-size:11px;color:var(--text-muted);margin-bottom:12px;line-height:1.4">Add custom key-value details for this business (e.g., "Speciality: PPF", "Price Range: ₹₹₹", "Coverage: Full body"). These appear on the business profile page.</p>
        
        <div id="attrContainer">
          <%
            let existingAttrs = [];
            if (business && business.custom_attributes) {
              try { existingAttrs = JSON.parse(business.custom_attributes); } catch(e) {}
            }
            if (existingAttrs.length) {
              existingAttrs.forEach(function(attr, idx) {
          %>
          <div class="attr-row">
            <input type="text" placeholder="Label (e.g., Speciality)" class="attr-key" value="<%= attr.key || '' %>">
            <input type="text" placeholder="Value (e.g., PPF)" class="attr-val" value="<%= attr.value || '' %>">
            <button type="button" class="attr-remove" onclick="this.parentElement.remove();syncAttrs()"><i class="ti ti-x"></i></button>
          </div>
          <% }) } %>
        </div>
        
        <button type="button" class="attr-add-btn" onclick="addAttrRow()">
          <i class="ti ti-plus"></i> Add Attribute
        </button>
        <input type="hidden" name="custom_attributes" id="customAttrsField" value='<%= business && business.custom_attributes ? business.custom_attributes : "[]" %>'>
      </div>

      <div class="form-card">
        <h3><i class="ti ti-help" style="margin-right:4px"></i> Business FAQs</h3>
        <p style="font-size:11px;color:var(--text-muted);margin-bottom:12px;line-height:1.4">Manage Frequently Asked Questions for this business.</p>
        
        <div id="faqContainer">
          <% if (typeof faqs !== 'undefined' && faqs.length) { %>
            <% faqs.forEach(function(faq, idx) { %>
            <div class="attr-row" style="flex-direction:column; align-items:stretch; gap: 8px; margin-bottom: 12px; padding-bottom: 12px; border-bottom: 1px solid var(--border-light);">
              <input type="text" placeholder="Question" class="faq-q" value="<%= faq.question || '' %>">
              <textarea placeholder="Answer" class="faq-a" rows="2" style="resize:vertical"><%= faq.answer || '' %></textarea>
              <button type="button" class="btn btn-sm btn-outline text-danger" style="align-self:flex-end;" onclick="this.parentElement.remove();syncFaqs()">Remove FAQ</button>
            </div>
            <% }) %>
          <% } %>
        </div>
        
        <button type="button" class="attr-add-btn" onclick="addFaqRow()">
          <i class="ti ti-plus"></i> Add FAQ
        </button>
        <input type="hidden" name="faqs_json" id="faqsField" value="<%= typeof faqs !== 'undefined' ? JSON.stringify(faqs) : '[]' %>">
      </div>

      <div class="form-card">
        <h3>Review Data</h3>
        <div class="form-row">
          <div class="form-group">
            <label>Google Rating (0–5)</label>
            <input type="number" name="google_rating" step="0.1" min="0" max="5" value="<%= business ? business.google_rating||'' : '' %>">
          </div>
          <div class="form-group">
            <label>Review Count</label>
            <input type="number" name="google_review_count" min="0" value="<%= business ? business.google_review_count||'' : '' %>">
          </div>
        </div>
      </div>
    </div>

    <div>
      <div class="form-card">
        <h3>Status</h3>
        <div class="form-group">
          <label style="display:flex;align-items:center;gap:8px;cursor:pointer;text-transform:none;letter-spacing:0;font-size:13px">
            <input type="checkbox" name="verified" <%= business && business.verified ? 'checked':'' %> style="width:auto">
            BBI Verified
          </label>
        </div>
        <div class="form-group">
          <label style="display:flex;align-items:center;gap:8px;cursor:pointer;text-transform:none;letter-spacing:0;font-size:13px">
            <input type="checkbox" name="sponsored" <%= business && business.sponsored ? 'checked':'' %> style="width:auto">
            Sponsored Listing
          </label>
        </div>
        <div class="form-group">
          <label style="display:flex;align-items:center;gap:8px;cursor:pointer;text-transform:none;letter-spacing:0;font-size:13px">
            <input type="checkbox" name="is_ranked" <%= (!business || business.is_ranked !== 0) ? 'checked':'' %> style="width:auto">
            Is Ranked (Show on Ranking Pages)
          </label>
        </div>
      </div>

      <div class="form-card">
        <h3>Ranking Override</h3>
        <div class="form-group">
          <label>Editorial Score (0–15)</label>
          <input type="number" name="editorial_score" step="0.5" min="0" max="15" value="<%= scores ? scores.editorial_score||0 : 0 %>">
        </div>
        <div class="form-group">
          <label>Manual Boost (0–10)</label>
          <input type="number" name="manual_boost" step="0.5" min="0" max="10" value="<%= scores ? scores.manual_boost||0 : 0 %>">
        </div>
        <div style="font-size:11px;color:#4A5568;background:#F5F6F8;padding:8px;border-radius:5px">
          Auto score is calculated from review data. Editorial and boost are added manually.
        </div>
      </div>

      <div class="ai-panel" style="margin-bottom:var(--space-4)">
        <h3><i class="ti ti-wand"></i> AI Assistant</h3>
        <p style="font-size:11px;color:var(--text-muted);margin-bottom:12px;line-height:1.4">Auto-generate optimized SEO descriptions and tags using OpenAI.</p>
        <button type="button" class="ai-btn" id="aiGenerateBtn" onclick="runAiGenerate()">
          <i class="ti ti-sparkles"></i> Generate SEO Profile
        </button>
        <button type="button" class="ai-btn" id="aiModerateBtn" onclick="runAiModerate()">
          <i class="ti ti-shield-check"></i> Check Moderation
        </button>
      </div>

      <div style="display:flex;gap:8px">
        <button type="submit" class="btn btn-primary" style="flex:1;justify-content:center">
          <%= business ? 'Save Changes' : 'Add Business' %>
        </button>
        <a href="/admin/businesses" class="btn btn-outline">Cancel</a>
      </div>
    </div>

  </div>
</form>

<script>
async function runGoogleMapsAutofill() {
  const nameInput = document.querySelector('[name=name]');
  const query = nameInput.value;
  const citySel = document.querySelector('[name=city_id]');
  const city = citySel.options[citySel.selectedIndex]?.text;
  
  if(!query) {
    return alert('Please enter a Business Name first to search.');
  }

  const btn = document.getElementById('autofillBtn');
  const originalText = btn.innerHTML;
  btn.innerHTML = '<i class="ti ti-loader"></i> Searching...';
  btn.style.opacity = '0.7';

  try {
    const res = await fetch('/admin/api/places/autofill', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ query, location: city === 'Select city' ? '' : city })
    });
    
    const data = await res.json();
    if(data.success && data.data) {
      if(data.data.address) document.querySelector('[name=address]').value = data.data.address;
      if(data.data.phone) document.querySelector('[name=phone]').value = data.data.phone;
      if(data.data.website) document.querySelector('[name=website]').value = data.data.website;
      if(data.data.rating) document.querySelector('[name=google_rating]').value = data.data.rating;
      if(data.data.review_count) document.querySelector('[name=google_review_count]').value = data.data.review_count;
      alert('✅ Successfully auto-filled details from Google Maps!');
    } else {
      alert('Failed: ' + (data.error || 'No business found.'));
    }
  } catch(e) {
    alert('Error connecting to Maps API: ' + e.message);
  } finally {
    btn.innerHTML = originalText;
    btn.style.opacity = '1';
  }
}

async function runAiGenerate() {
  const name = document.querySelector('[name=name]').value;
  const citySel = document.querySelector('[name=city_id]');
  const city = citySel.options[citySel.selectedIndex]?.text;
  const catSel = document.querySelector('[name=category_id]');
  const cat = catSel.options[catSel.selectedIndex]?.text;
  
  if(!name || !city || !cat || city==='Select city' || cat==='Select category') {
    alert('Please enter a Name, City, and Category first so the AI has context.');
    return;
  }
  
  const btn = document.getElementById('aiGenerateBtn');
  btn.classList.add('loading');
  
  try {
    const res = await fetch('/admin/api/ai/generate', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        type: 'listing',
        businessInfo: { name, city_name: city, cat_name: cat }
      })
    });
    const data = await res.json();
    if(data.success && data.data) {
      document.querySelector('[name=description]').value = data.data.summary || '';
      document.querySelector('[name=tags]').value = data.data.tags || '';
    } else {
      alert('Failed: ' + (data.error || 'Unknown error'));
    }
  } catch(e) {
    alert('Error: ' + e.message);
  } finally {
    btn.classList.remove('loading');
  }
}

async function runAiModerate() {
  const desc = document.querySelector('[name=description]').value;
  if(!desc) return alert('Description is empty.');
  
  const btn = document.getElementById('aiModerateBtn');
  btn.classList.add('loading');
  
  try {
    const res = await fetch('/admin/api/ai/moderate', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ text: desc })
    });
    const data = await res.json();
    if(data.success && data.data) {
      if(data.data.isClean) alert('✅ Content is clean! No spam or policy violations detected.');
      else alert('⚠️ Flags detected:\n' + data.data.flags.join('\n'));
    } else {
      alert('Failed: ' + data.error);
    }
  } catch(e) {
    alert('Error: ' + e.message);
  } finally {
    btn.classList.remove('loading');
  }
}

// === Custom Attributes ===
function addAttrRow(key, val) {
  var container = document.getElementById('attrContainer');
  var row = document.createElement('div');
  row.className = 'attr-row';
  row.innerHTML = '<input type="text" placeholder="Label (e.g., Speciality)" class="attr-key" value="' + (key || '') + '">' +
    '<input type="text" placeholder="Value (e.g., PPF)" class="attr-val" value="' + (val || '') + '">' +
    '<button type="button" class="attr-remove" onclick="this.parentElement.remove();syncAttrs()"><i class="ti ti-x"></i></button>';
  container.appendChild(row);
  // Focus the key input
  row.querySelector('.attr-key').focus();
  syncAttrs();
}

function syncAttrs() {
  var rows = document.querySelectorAll('#attrContainer .attr-row');
  var attrs = [];
  rows.forEach(function(row) {
    var key = row.querySelector('.attr-key').value.trim();
    var val = row.querySelector('.attr-val').value.trim();
    if (key || val) attrs.push({ key: key, value: val });
  });
  document.getElementById('customAttrsField').value = JSON.stringify(attrs);
}

// === FAQs ===
function addFaqRow(q, a) {
  var container = document.getElementById('faqContainer');
  var row = document.createElement('div');
  row.className = 'attr-row';
  row.style.cssText = 'flex-direction:column; align-items:stretch; gap: 8px; margin-bottom: 12px; padding-bottom: 12px; border-bottom: 1px solid var(--border-light);';
  row.innerHTML = '<input type="text" placeholder="Question" class="faq-q" value="' + (q || '') + '">' +
    '<textarea placeholder="Answer" class="faq-a" rows="2" style="resize:vertical">' + (a || '') + '</textarea>' +
    '<button type="button" class="btn btn-sm btn-outline text-danger" style="align-self:flex-end;" onclick="this.parentElement.remove();syncFaqs()">Remove FAQ</button>';
  container.appendChild(row);
  row.querySelector('.faq-q').focus();
  syncFaqs();
}

function syncFaqs() {
  var rows = document.querySelectorAll('#faqContainer .attr-row');
  var faqs = [];
  rows.forEach(function(row) {
    var q = row.querySelector('.faq-q').value.trim();
    var a = row.querySelector('.faq-a').value.trim();
    if (q && a) faqs.push({ question: q, answer: a });
  });
  document.getElementById('faqsField').value = JSON.stringify(faqs);
}

// Sync on input change
document.getElementById('attrContainer').addEventListener('input', syncAttrs);
document.getElementById('faqContainer').addEventListener('input', syncFaqs);

// Sync before form submit
document.querySelector('form').addEventListener('submit', function() {
  syncAttrs();
  syncFaqs();
});
</script>

<%- include('layout-bottom') %>
