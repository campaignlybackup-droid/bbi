<%- include('layout-top') %>

<% if(flash.success) { %><div class="alert alert-success"><%= flash.success %></div><% } %>
<% if(flash.error) { %><div class="alert alert-error"><%= flash.error %></div><% } %>

<div style="display:flex;gap:10px;align-items:center;margin-bottom:16px;justify-content:space-between">
  <form method="GET" style="display:flex;gap:8px;flex:1">
    <input type="text" name="search" value="<%= search %>" placeholder="Search businesses…" style="padding:8px 12px;border:1px solid #e2e6ea;border-radius:6px;font-size:13px;width:220px;outline:none">
    <select name="city" style="padding:8px 12px;border:1px solid #e2e6ea;border-radius:6px;font-size:13px;outline:none">
      <option value="">All Cities</option>
      <% cities.forEach(c => { %><option value="<%= c.id %>" <%= city_id==c.id?'selected':'' %>><%= c.name %></option><% }) %>
    </select>
    <select name="cat" style="padding:8px 12px;border:1px solid #e2e6ea;border-radius:6px;font-size:13px;outline:none">
      <option value="">All Categories</option>
      <% categories.forEach(c => { %><option value="<%= c.id %>" <%= cat_id==c.id?'selected':'' %>><%= c.name %></option><% }) %>
    </select>
    <button type="submit" class="btn btn-outline">Filter</button>
  </form>
  <a href="/admin/businesses/new" class="btn btn-primary"><i class="ti ti-plus"></i> Add Business</a>
</div>

<div class="table-wrap">
  <table>
    <thead>
      <tr><th>#</th><th>Business</th><th>City</th><th>Category</th><th>Rank</th><th>Score</th><th>Status</th><th>Actions</th></tr>
    </thead>
    <tbody>
      <% businesses.forEach(b => { %>
      <tr>
        <td style="color:#4A5568;font-size:12px"><%= b.id %></td>
        <td>
          <strong><%= b.name %></strong>
          <% if(b.sponsored) { %><span class="tag-sponsored" style="margin-left:5px">Sponsored</span><% } %>
        </td>
        <td style="font-size:13px"><%= b.city_name || '—' %></td>
        <td style="font-size:13px"><%= b.cat_name || '—' %></td>
        <td style="font-size:14px;font-weight:700;color:#0D2E5E"><%= b.current_rank ? '#'+b.current_rank : '—' %></td>
        <td style="font-size:13px;font-weight:600"><%= b.final_score ? Math.round(b.final_score) : '—' %></td>
        <td>
          <% if(b.verified) { %><span class="tag-verified">Verified</span><% } %>
          <% if(b.is_ranked === 0) { %><span style="background:#e2e8f0;color:#4a5568;padding:2px 6px;border-radius:4px;font-size:11px;font-weight:600;margin-left:4px">Unranked</span><% } %>
        </td>
        <td>
          <div style="display:flex;gap:6px">
            <button onclick="openQuickEdit(<%= b.id %>, <%= b.city_id || 'null' %>, <%= b.category_id || 'null' %>, '<%= (b.tags||'').replace(/'/g, "\\'") %>')" class="btn btn-outline btn-sm"><i class="ti ti-bolt"></i> Quick</button>
            <a href="/admin/businesses/<%= b.id %>/edit" class="btn btn-outline btn-sm"><i class="ti ti-edit"></i> Edit</a>
            <form method="POST" action="/admin/businesses/<%= b.id %>/delete" onsubmit="return confirm('Remove this business?')">
              <button type="submit" class="btn btn-danger btn-sm"><i class="ti ti-trash"></i></button>
            </form>
          </div>
        </td>
      </tr>
      <% }) %>
      <% if(!businesses.length) { %>
      <tr><td colspan="8" style="text-align:center;padding:24px;color:#4A5568">No businesses found.</td></tr>
      <% } %>
    </tbody>
  </table>
</div>

<dialog id="quickEditModal" style="border:none;border-radius:12px;box-shadow:0 10px 30px rgba(0,0,0,0.2);padding:24px;width:100%;max-width:400px">
  <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px">
    <h3 style="margin:0">Quick Edit</h3>
    <button onclick="document.getElementById('quickEditModal').close()" style="background:none;border:none;cursor:pointer;font-size:18px"><i class="ti ti-x"></i></button>
  </div>
  <form id="quickEditForm" method="POST" action="">
    <div class="form-group">
      <label>City</label>
      <select name="city_id" id="qe_city" required>
        <option value="">-- Select City --</option>
        <% cities.forEach(c => { %><option value="<%= c.id %>"><%= c.name %></option><% }) %>
      </select>
    </div>
    <div class="form-group">
      <label>Category</label>
      <select name="category_id" id="qe_cat" required>
        <option value="">-- Select Category --</option>
        <% categories.forEach(c => { %><option value="<%= c.id %>"><%= c.name %></option><% }) %>
      </select>
    </div>
    <div class="form-group">
      <label>Keywords / Tags</label>
      <input type="text" name="tags" id="qe_tags" placeholder="Comma separated keywords">
    </div>
    <button type="submit" class="btn btn-primary" style="width:100%;justify-content:center">Save Changes</button>
  </form>
</dialog>

<script>
function openQuickEdit(id, cityId, catId, tags) {
  document.getElementById('quickEditForm').action = '/admin/businesses/' + id + '/quick-edit';
  document.getElementById('qe_city').value = cityId || '';
  document.getElementById('qe_cat').value = catId || '';
  document.getElementById('qe_tags').value = tags || '';
  document.getElementById('quickEditModal').showModal();
}
</script>

<%- include('layout-bottom') %>
