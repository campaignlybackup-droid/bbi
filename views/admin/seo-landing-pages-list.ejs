<%- include('layout-top') %>

<% if(flash.success) { %><div class="alert alert-success"><%= flash.success %></div><% } %>
<% if(flash.error) { %><div class="alert alert-error"><%= flash.error %></div><% } %>

<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:24px">
  <div>
    <p style="font-size:13px;color:var(--text-muted);margin-top:4px">Create SEO/AEO-optimized landing pages for keyword-targeted traffic. Each page gets full structured data, FAQ schema, and internal linking.</p>
  </div>
  <a href="/admin/seo-landing-pages/new" class="btn btn-primary"><i class="ti ti-plus"></i> Create New Page</a>
</div>

<!-- STATS ROW -->
<div style="display:grid;grid-template-columns:repeat(auto-fill, minmax(160px, 1fr));gap:12px;margin-bottom:24px">
  <div class="form-card" style="padding:16px;text-align:center">
    <div style="font-size:24px;font-weight:700;color:var(--navy)"><%= pages.length %></div>
    <div style="font-size:11px;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.5px;margin-top:4px">Total Pages</div>
  </div>
  <div class="form-card" style="padding:16px;text-align:center">
    <div style="font-size:24px;font-weight:700;color:var(--success)"><%= pages.filter(p => p.active).length %></div>
    <div style="font-size:11px;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.5px;margin-top:4px">Active</div>
  </div>
  <div class="form-card" style="padding:16px;text-align:center">
    <div style="font-size:24px;font-weight:700;color:var(--text-secondary)"><%= pages.filter(p => !p.active).length %></div>
    <div style="font-size:11px;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.5px;margin-top:4px">Draft</div>
  </div>
  <div class="form-card" style="padding:16px;text-align:center">
    <div style="font-size:24px;font-weight:700;color:var(--gold)"><%= pages.filter(p => p.linked_city_id).length %></div>
    <div style="font-size:11px;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.5px;margin-top:4px">Linked to Rankings</div>
  </div>
</div>

<!-- PAGES TABLE -->
<div class="form-card" style="padding:0;overflow:hidden">
  <div style="padding:16px 20px;border-bottom:1px solid var(--border);background:#fafbfc;display:flex;justify-content:space-between;align-items:center">
    <h3 style="margin:0;font-size:16px"><i class="ti ti-rocket" style="color:var(--navy);margin-right:8px"></i> All SEO Landing Pages</h3>
  </div>
  
  <div style="padding:0">
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th style="width:30px">#</th>
            <th>Page Title / H1</th>
            <th>URL</th>
            <th>Linked To</th>
            <th>Keywords</th>
            <th>Status</th>
            <th style="text-align:right">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% pages.forEach((p, i) => { %>
          <tr>
            <td style="color:var(--text-muted)"><%= i + 1 %></td>
            <td>
              <strong><%= p.h1 || p.title %></strong>
              <% if(p.h1 && p.h1 !== p.title) { %>
              <div style="font-size:11px;color:var(--text-muted);margin-top:2px">Title: <%= p.title %></div>
              <% } %>
            </td>
            <td>
              <a href="/<%= p.slug %>" target="_blank" style="font-size:12px;color:#1A73E8">
                /<%= p.slug %> <i class="ti ti-external-link" style="font-size:10px"></i>
              </a>
            </td>
            <td>
              <% if(p.city_name && p.category_name) { %>
                <span style="font-size:12px;padding:2px 8px;background:var(--info-bg);color:var(--navy);border-radius:10px;border:1px solid var(--info-border)">
                  <%= p.category_name %> · <%= p.city_name %>
                </span>
              <% } else { %>
                <span style="font-size:12px;color:var(--text-muted)">Manual</span>
              <% } %>
            </td>
            <td style="max-width:150px">
              <% if(p.target_keywords) { %>
                <div style="font-size:11px;color:var(--text-secondary);overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="<%= p.target_keywords %>"><%= p.target_keywords %></div>
              <% } else { %>
                <span style="font-size:11px;color:var(--text-muted)">—</span>
              <% } %>
            </td>
            <td>
              <span style="font-size:11px;padding:2px 8px;border-radius:10px;<%= p.active ? 'background:#f0fdf4;color:#166534' : 'background:#f5f5f5;color:#666' %>">
                <%= p.active ? 'Active' : 'Draft' %>
              </span>
            </td>
            <td style="text-align:right">
              <div style="display:flex;gap:4px;justify-content:flex-end;flex-wrap:nowrap">
                <a href="/admin/seo-landing-pages/<%= p.id %>/edit" class="btn btn-outline btn-sm" title="Edit"><i class="ti ti-pencil"></i></a>
                <form method="POST" action="/admin/seo-landing-pages/<%= p.id %>/toggle" style="display:inline">
                  <button type="submit" class="btn btn-outline btn-sm" title="<%= p.active ? 'Deactivate' : 'Activate' %>">
                    <i class="ti ti-<%= p.active ? 'eye-off' : 'eye' %>"></i>
                  </button>
                </form>
                <form method="POST" action="/admin/seo-landing-pages/<%= p.id %>/duplicate" style="display:inline">
                  <button type="submit" class="btn btn-outline btn-sm" title="Duplicate"><i class="ti ti-copy"></i></button>
                </form>
                <form method="POST" action="/admin/seo-landing-pages/<%= p.id %>/delete" style="display:inline" onsubmit="return confirm('Delete this page permanently?')">
                  <button type="submit" class="btn btn-outline btn-sm" style="color:var(--error)" title="Delete"><i class="ti ti-trash"></i></button>
                </form>
              </div>
            </td>
          </tr>
          <% }) %>
          <% if(pages.length === 0) { %>
          <tr>
            <td colspan="7" style="text-align:center;padding:40px;color:#666">
              <i class="ti ti-rocket" style="font-size:32px;display:block;margin-bottom:8px;color:var(--text-muted)"></i>
              No SEO landing pages yet. <a href="/admin/seo-landing-pages/new" style="color:#1A73E8">Create your first page →</a>
            </td>
          </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('layout-bottom') %>
