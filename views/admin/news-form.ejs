<%- include('layout-top') %>

<div class="header">
  <h2><%= title %></h2>
</div>

<% if(flash.error) { %><div class="alert alert-error"><%= flash.error %></div><% } %>

<form action="/admin/news<%= newsItem ? '/' + newsItem.id : '' %>" method="POST" onsubmit="return encodeNewsContent()">
  <input type="hidden" name="content_encoded" id="contentEncoded" value="">
  <div class="card" style="max-width: 800px">
    <div class="form-group">
      <label>News Title *</label>
      <input type="text" name="title" value="<%= newsItem ? newsItem.title : '' %>" required>
    </div>
    
    <div class="form-group">
      <label>Image URL (Optional)</label>
      <input type="text" name="image" value="<%= newsItem ? newsItem.image : '' %>">
    </div>
    
    <div class="form-group">
      <label>Content *</label>
      <textarea id="newsContent" rows="15" style="resize:vertical" required><%= newsItem ? newsItem.content : '' %></textarea>
      <div style="font-size:11px;color:#4A5568;margin-top:4px">HTML is supported for formatting (e.g., &lt;p&gt;, &lt;strong&gt;, &lt;h3&gt;).</div>
    </div>
    
    <div class="form-group">
      <label style="display:flex;align-items:center;gap:8px;cursor:pointer;text-transform:none;letter-spacing:0;font-size:13px">
        <input type="checkbox" name="active" <%= !newsItem || newsItem.active ? 'checked' : '' %> style="width:auto">
        Publish immediately (Active)
      </label>
    </div>

    <div style="display:flex;gap:8px;margin-top:24px">
      <button type="submit" class="btn btn-primary"><%= newsItem ? 'Save Changes' : 'Create News' %></button>
      <a href="/admin/news" class="btn btn-outline">Cancel</a>
    </div>
  </div>
</form>

<script>
function encodeNewsContent() {
  const content = document.getElementById('newsContent').value;
  document.getElementById('contentEncoded').value = btoa(unescape(encodeURIComponent(content)));
  return true;
}
</script>

<%- include('layout-bottom') %>

