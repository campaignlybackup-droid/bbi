<%- include('layout-top') %>

<div class="header">
  <h2>Manage News</h2>
  <a href="/admin/news/new" class="btn btn-primary"><i class="ti ti-plus"></i> Add News</a>
</div>

<% if(flash.success) { %><div class="alert alert-success"><%= flash.success %></div><% } %>

<div class="card">
  <% if(newsList.length === 0) { %>
    <p class="text-muted">No news articles found.</p>
  <% } else { %>
    <table class="table">
      <thead>
        <tr>
          <th>Title</th>
          <th>Created At</th>
          <th>Status</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% newsList.forEach(item => { %>
          <tr>
            <td><strong><%= item.title %></strong></td>
            <td class="text-muted"><%= new Date(item.created_at).toLocaleDateString() %></td>
            <td>
              <form action="/admin/news/<%= item.id %>/toggle" method="POST" style="display:inline">
                <% if(item.active) { %>
                  <button class="btn btn-sm" style="background:#E6F4EA;color:#137333;border:none"><i class="ti ti-check"></i> Active</button>
                <% } else { %>
                  <button class="btn btn-sm" style="background:#FCE8E6;color:#C5221F;border:none">Hidden</button>
                <% } %>
              </form>
            </td>
            <td>
              <a href="/admin/news/<%= item.id %>/edit" class="btn btn-sm btn-outline"><i class="ti ti-edit"></i> Edit</a>
              <form action="/admin/news/<%= item.id %>/delete" method="POST" style="display:inline" onsubmit="return confirm('Delete this article?');">
                <button class="btn btn-sm btn-outline text-danger"><i class="ti ti-trash"></i></button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>

<%- include('layout-bottom') %>
