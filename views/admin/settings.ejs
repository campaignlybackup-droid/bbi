<%- include('layout-top', { title: 'Global Settings & SEO', admin: admin, flash: flash }) %>

<div class="header-action">
  <div>
    <h2 class="page-title">Global Settings & SEO</h2>
    <p style="color:var(--text-muted);font-size:14px;margin-top:4px">Manage global configuration, SEO defaults, and view live PageSpeed Insights.</p>
  </div>
</div>

<div class="grid-2" style="grid-template-columns: 2fr 1fr; gap: 24px;">
  
  <div class="card">
    <h3 style="margin-top:0"><i class="ti ti-settings" style="color:var(--navy);margin-right:8px"></i> Configuration</h3>
    <form action="/admin/settings" method="POST">
      <div class="form-group">
        <label for="site_title">Global Site Title</label>
        <input type="text" id="site_title" name="site_title" value="<%= settings.site_title || '' %>" placeholder="e.g. BBI — Bharat Business Index">
        <small>The default title appended to pages without a specific title.</small>
      </div>

      <div class="form-group">
        <label for="default_meta_description">Global Meta Description</label>
        <textarea id="default_meta_description" name="default_meta_description" rows="3" placeholder="Default SEO meta description..."><%= settings.default_meta_description || '' %></textarea>
        <small>Fallback meta description if a specific page doesn't have one.</small>
      </div>

      <div class="form-group">
        <label for="contact_email">Support / Contact Email</label>
        <input type="email" id="contact_email" name="contact_email" value="<%= settings.contact_email || '' %>" placeholder="e.g. support@bharatbusinessindex.com">
      </div>

      <h4 style="margin-top:24px;border-bottom:1px solid #eee;padding-bottom:8px">Social Links</h4>
      
      <div class="form-group">
        <label for="facebook_url">Facebook URL</label>
        <input type="url" id="facebook_url" name="facebook_url" value="<%= settings.facebook_url || '' %>">
      </div>
      <div class="form-group">
        <label for="twitter_url">Twitter (X) URL</label>
        <input type="url" id="twitter_url" name="twitter_url" value="<%= settings.twitter_url || '' %>">
      </div>
      <div class="form-group">
        <label for="linkedin_url">LinkedIn URL</label>
        <input type="url" id="linkedin_url" name="linkedin_url" value="<%= settings.linkedin_url || '' %>">
      </div>

      <h4 style="margin-top:24px;border-bottom:1px solid #eee;padding-bottom:8px">Google SEO Automation</h4>
      <div class="form-group" style="display:flex;align-items:center;gap:10px;">
        <input type="checkbox" id="auto_ping_indexing" name="auto_ping_indexing" value="true" <%= settings.auto_ping_indexing === 'true' ? 'checked' : '' %>>
        <label for="auto_ping_indexing" style="margin:0;font-weight:normal;">Auto-Ping Google Indexing API on new business creation</label>
      </div>
      <p style="font-size:12px;color:var(--text-muted);margin-top:4px;">Requires a valid Google Cloud Service Account credentials file (`config/google-credentials.json`).</p>

      <button type="submit" class="btn" style="margin-top:16px;">Save Settings</button>
    </form>
  </div>

  <div style="display:flex; flex-direction:column; gap:24px;">
    
    <!-- Google Search Console Widget -->
    <div class="card">
      <h3 style="margin-top:0"><i class="ti ti-chart-line" style="color:#0F9D58;margin-right:8px"></i> Google Search Console</h3>
      <p style="font-size:13px;color:var(--text-muted);line-height:1.5">View your actual Google Search clicks and impressions over the last 30 days.</p>
      
      <% if (gscData && gscData.timeline) { %>
        <% 
          let totalClicks = 0;
          let totalImpressions = 0;
          gscData.timeline.forEach(row => {
            totalClicks += row.clicks;
            totalImpressions += row.impressions;
          });
        %>
        <div style="margin:24px 0;">
          <div style="display:flex;justify-content:space-between;margin-bottom:12px;align-items:center;">
            <strong style="font-size:14px">Total Clicks (30d):</strong>
            <span class="badge badge-verified" style="font-size:16px;padding:4px 8px;"><%= totalClicks.toLocaleString() %></span>
          </div>
          <div style="display:flex;justify-content:space-between;margin-bottom:12px;align-items:center;">
            <strong style="font-size:14px">Total Impressions (30d):</strong>
            <span class="badge badge-sponsored" style="font-size:16px;padding:4px 8px;"><%= totalImpressions.toLocaleString() %></span>
          </div>

          <% if (gscData.topQueries && gscData.topQueries.length > 0) { %>
          <div style="margin-top:24px;border-top:1px solid #eee;padding-top:16px;">
            <strong style="font-size:14px;display:block;margin-bottom:12px;">Top Search Queries</strong>
            <ul style="list-style:none;padding:0;margin:0;">
              <% gscData.topQueries.forEach(q => { %>
                <li style="display:flex;justify-content:space-between;font-size:13px;margin-bottom:8px;padding-bottom:8px;border-bottom:1px dashed #eee;">
                  <span style="color:var(--text-primary)"><%= q.keys[0] %></span>
                  <span style="color:var(--text-muted)"><%= q.clicks %> clicks</span>
                </li>
              <% }) %>
            </ul>
          </div>
          <% } %>
        </div>
        <a href="/admin/settings" class="btn btn-outline" style="width:100%;text-align:center;">Clear Results</a>
      <% } else { %>
        <div style="margin-top:24px;">
          <a href="/admin/settings?run_gsc=true" class="btn" style="width:100%;text-align:center;background-color:#0F9D58;">Fetch Live Search Data</a>
        </div>
      <% } %>
    </div>

    <!-- Google PageSpeed Widget -->
    <div class="card">
      <h3 style="margin-top:0"><i class="ti ti-brand-google" style="color:#4285F4;margin-right:8px"></i> Google PageSpeed API</h3>
      <p style="font-size:13px;color:var(--text-muted);line-height:1.5">Check your site's live SEO and Performance scores directly via Google's PageSpeed API.</p>
    
    <% if (pageSpeedData && pageSpeedData.lighthouseResult) { %>
      <% 
        const categories = pageSpeedData.lighthouseResult.categories;
        const seoScore = Math.round(categories.seo.score * 100);
        const perfScore = Math.round(categories.performance.score * 100);
      %>
      <div style="margin:24px 0;">
        <div style="display:flex;justify-content:space-between;margin-bottom:12px;align-items:center;">
          <strong style="font-size:14px">SEO Score:</strong>
          <span class="badge <%= seoScore >= 90 ? 'badge-verified' : (seoScore >= 50 ? 'badge-sponsored' : 'badge-danger') %>" style="font-size:16px;padding:4px 8px;"><%= seoScore %>/100</span>
        </div>
        <div style="display:flex;justify-content:space-between;margin-bottom:12px;align-items:center;">
          <strong style="font-size:14px">Performance:</strong>
          <span class="badge <%= perfScore >= 90 ? 'badge-verified' : (perfScore >= 50 ? 'badge-sponsored' : 'badge-danger') %>" style="font-size:16px;padding:4px 8px;"><%= perfScore %>/100</span>
        </div>
      </div>
      <a href="/admin/settings" class="btn btn-outline" style="width:100%;text-align:center;">Clear Results</a>
    <% } else { %>
      <div style="margin-top:24px;">
        <a href="/admin/settings?run_pagespeed=true" class="btn" style="width:100%;text-align:center;">Run SEO Analysis</a>
      </div>
    <% } %>
    </div>
  </div>

</div>

<%- include('layout-bottom') %>
