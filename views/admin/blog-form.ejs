<%- include('layout-top') %>

<div class="header">
  <h2><%= title %></h2>
  <a href="/admin/blog" class="btn btn-outline"><i class="ti ti-arrow-left"></i> Back to Blog</a>
</div>

<form action="<%= post ? '/admin/blog/'+post.id : '/admin/blog' %>" method="POST" id="blogForm" onsubmit="return encodeBlogContent()">
  <input type="hidden" name="content_encoded" id="contentEncoded" value="">
  <div style="display:grid;grid-template-columns:2fr 1fr;gap:16px">

    <div>
      <div class="form-card">
        <h3>Post Details</h3>
        <div class="form-group">
          <label>Title *</label>
          <input type="text" name="title" id="blogTitle" value="<%= post ? post.title : '' %>" required>
        </div>
        
        <div class="form-row">
          <div class="form-group">
            <label>Category</label>
            <input type="text" name="category" value="<%= post ? post.category : '' %>" placeholder="e.g. SEO, Business Tips">
          </div>
          <div class="form-group">
            <label>Tags (comma separated)</label>
            <input type="text" name="tags" value="<%= post ? post.tags : '' %>">
          </div>
        </div>

        <div class="form-group">
          <label>Featured Image URL</label>
          <input type="url" name="featured_image" value="<%= post ? post.featured_image : '' %>" placeholder="https://...">
        </div>
      </div>

      <div class="form-card">
        <h3>Content</h3>
        <div class="form-group">
          <label>Excerpt</label>
          <textarea name="excerpt" id="blogExcerpt" rows="3"><%= post ? post.excerpt : '' %></textarea>
        </div>
        
        <div class="form-group">
          <label>Meta Description (SEO)</label>
          <textarea name="meta_description" id="blogMeta" rows="2"><%= post ? post.meta_description : '' %></textarea>
        </div>

        <div class="form-group">
          <label>Content (HTML) *</label>
          <textarea id="blogContent" rows="15" required style="font-family:monospace;resize:vertical"><%= post ? post.content : '' %></textarea>
        </div>
      </div>
    </div>

    <div>
      <div class="ai-panel" style="margin-bottom:var(--space-4)">
        <h3><i class="ti ti-wand"></i> AI Writer Assistant</h3>
        <p style="font-size:11px;color:var(--text-muted);margin-bottom:12px;line-height:1.4">Auto-generate blog posts and summaries based on the Title.</p>
        
        <button type="button" class="ai-btn" id="aiDraftBtn" onclick="generateBlogDraft()">
          <i class="ti ti-article"></i> Draft Article from Title
        </button>
        <button type="button" class="ai-btn" id="aiSummaryBtn" onclick="generateBlogSummary()">
          <i class="ti ti-align-left"></i> Generate Excerpt & SEO Meta
        </button>
      </div>

      <div style="display:flex;gap:8px">
        <button type="submit" class="btn btn-primary" style="flex:1;justify-content:center">Save Post</button>
        <a href="/admin/blog" class="btn btn-outline">Cancel</a>
      </div>
    </div>

  </div>
</form>

<script>
// Encode HTML content as Base64 before form submission to bypass WAF
function encodeBlogContent() {
  const content = document.getElementById('blogContent').value;
  document.getElementById('contentEncoded').value = btoa(unescape(encodeURIComponent(content)));
  return true;
}

async function generateBlogDraft() {
  const title = document.getElementById('blogTitle').value;
  if(!title) return alert('Please enter a Title first.');
  
  const btn = document.getElementById('aiDraftBtn');
  btn.classList.add('loading');
  try {
    const res = await fetch('/admin/api/ai/generate', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ type: 'blog_draft', businessInfo: { title } })
    });
    const data = await res.json();
    if(data.success && data.data) {
      document.getElementById('blogContent').value = data.data.content || '';
    } else {
      alert('Failed: ' + data.error);
    }
  } catch(e) {
    alert('Error: ' + e.message);
  } finally {
    btn.classList.remove('loading');
  }
}

async function generateBlogSummary() {
  const content = document.getElementById('blogContent').value;
  if(!content) return alert('Please enter or generate Content first.');
  
  const btn = document.getElementById('aiSummaryBtn');
  btn.classList.add('loading');
  try {
    const res = await fetch('/admin/api/ai/generate', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ type: 'blog_summary', businessInfo: { content } })
    });
    const data = await res.json();
    if(data.success && data.data) {
      document.getElementById('blogExcerpt').value = data.data.excerpt || '';
      document.getElementById('blogMeta').value = data.data.meta_description || '';
    } else {
      alert('Failed: ' + data.error);
    }
  } catch(e) {
    alert('Error: ' + e.message);
  } finally {
    btn.classList.remove('loading');
  }
}
</script>

<%- include('layout-bottom') %>
