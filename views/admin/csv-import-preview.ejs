<%- include('layout-top') %>

<% if(flash.error) { %><div class="alert alert-error"><i class="ti ti-alert-circle"></i> <%- flash.error %></div><% } %>

<%
  const report = importData.validation_report || {};
  const isValid = report.valid !== false;
  const errors = report.errors || [];
  const warnings = report.warnings || [];
  const stats = report.stats || {};
  const duplicates = report.duplicates || [];
%>

<!-- Validation Summary -->
<div style="background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius-lg);padding:var(--space-6);margin-bottom:var(--space-4)">
  <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:var(--space-4)">
    <div>
      <h3 style="margin:0"><i class="ti ti-file-analytics"></i> Validation Report</h3>
      <p style="color:var(--text-secondary);font-size:var(--font-size-sm);margin:var(--space-1) 0 0 0">
        File: <strong><%= importData.filename %></strong>
      </p>
    </div>
    <div>
      <% if(isValid && importData.status === 'validated') { %>
        <span style="background:#dcfce7;color:#166534;padding:var(--space-1) var(--space-3);border-radius:var(--radius-full);font-size:var(--font-size-sm);font-weight:600">
          <i class="ti ti-check"></i> Ready to Import
        </span>
      <% } else { %>
        <span style="background:#fee2e2;color:#991b1b;padding:var(--space-1) var(--space-3);border-radius:var(--radius-full);font-size:var(--font-size-sm);font-weight:600">
          <i class="ti ti-x"></i> Validation Failed
        </span>
      <% } %>
    </div>
  </div>

  <div class="stat-grid" style="grid-template-columns:repeat(4,1fr)">
    <div class="stat-card"><div class="stat-num"><%= stats.total || 0 %></div><div class="stat-label">Total Rows</div></div>
    <div class="stat-card" style="border-left:3px solid #22c55e"><div class="stat-num"><%= stats.valid || 0 %></div><div class="stat-label">Valid</div></div>
    <div class="stat-card" style="border-left:3px solid #ef4444"><div class="stat-num"><%= stats.invalid || 0 %></div><div class="stat-label">Invalid</div></div>
    <div class="stat-card" style="border-left:3px solid #f59e0b"><div class="stat-num"><%= stats.duplicate || 0 %></div><div class="stat-label">Duplicates</div></div>
  </div>
</div>

<!-- Errors -->
<% if(errors.length > 0) { %>
<div style="background:#fef2f2;border:1px solid #fecaca;border-radius:var(--radius-lg);padding:var(--space-4);margin-bottom:var(--space-4)">
  <h4 style="color:#991b1b;margin:0 0 var(--space-2) 0"><i class="ti ti-alert-circle"></i> Errors (<%= errors.length %>)</h4>
  <div style="max-height:300px;overflow-y:auto">
    <% errors.forEach(err => { %>
    <div style="padding:var(--space-1) 0;font-size:var(--font-size-sm);border-bottom:1px solid #fecaca">
      <% if(err.row > 0) { %>
        <strong style="color:#991b1b">Row <%= err.row %></strong> ·
        <span style="color:#b91c1c;font-weight:500"><%= err.field %></span>:
      <% } %>
      <%= err.message %>
    </div>
    <% }) %>
  </div>
</div>
<% } %>

<!-- Warnings -->
<% if(warnings.length > 0) { %>
<div style="background:#fffbeb;border:1px solid #fed7aa;border-radius:var(--radius-lg);padding:var(--space-4);margin-bottom:var(--space-4)">
  <h4 style="color:#92400e;margin:0 0 var(--space-2) 0"><i class="ti ti-alert-triangle"></i> Warnings (<%= warnings.length %>)</h4>
  <div style="max-height:200px;overflow-y:auto">
    <% warnings.forEach(warn => { %>
    <div style="padding:var(--space-1) 0;font-size:var(--font-size-sm);border-bottom:1px solid #fed7aa">
      <strong style="color:#92400e">Row <%= warn.row %></strong> ·
      <span style="font-weight:500"><%= warn.field %></span>:
      <%= warn.message %>
    </div>
    <% }) %>
  </div>
</div>
<% } %>

<!-- Duplicates -->
<% if(duplicates.length > 0) { %>
<div style="background:#fff7ed;border:1px solid #fdba74;border-radius:var(--radius-lg);padding:var(--space-4);margin-bottom:var(--space-4)">
  <h4 style="color:#9a3412;margin:0 0 var(--space-2) 0"><i class="ti ti-copy"></i> Duplicate Entries (<%= duplicates.length %>)</h4>
  <% duplicates.forEach(dup => { %>
  <div style="padding:var(--space-1) 0;font-size:var(--font-size-sm)">
    Row <%= dup.row %>: <strong><%= dup.business_name %></strong> (<%= dup.city %>) — duplicate of row <%= dup.firstSeen %>
  </div>
  <% }) %>
</div>
<% } %>

<!-- Data Preview -->
<div style="background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius-lg);padding:var(--space-4);margin-bottom:var(--space-4)">
  <h4 style="margin:0 0 var(--space-3) 0"><i class="ti ti-table"></i> Data Preview (first 50 rows)</h4>
  <div class="table-wrap" style="max-height:400px;overflow:auto">
    <table style="font-size:var(--font-size-xs)">
      <thead>
        <tr>
          <th>#</th><th>Status</th><th>Business Name</th><th>Category</th><th>City</th><th>State</th><th>Rating</th><th>Reviews</th><th>Slug</th>
        </tr>
      </thead>
      <tbody>
        <% (importData.rows || []).slice(0, 50).forEach(row => { %>
        <%
          let rowData = {};
          try { rowData = JSON.parse(row.raw_data || '{}'); } catch(e) {}
          const hasErrors = row.status === 'failed';
        %>
        <tr style="<%= hasErrors ? 'background:#fef2f2' : '' %>">
          <td><%= row.row_number %></td>
          <td>
            <% if(hasErrors) { %>
              <span style="color:#ef4444;font-weight:600">✗</span>
            <% } else { %>
              <span style="color:#22c55e;font-weight:600">✓</span>
            <% } %>
          </td>
          <td><strong><%= rowData.business_name || '—' %></strong></td>
          <td><%= rowData.category || '—' %></td>
          <td><%= rowData.city || '—' %></td>
          <td><%= rowData.state || '—' %></td>
          <td><%= rowData.google_rating || '—' %></td>
          <td><%= rowData.review_count || '—' %></td>
          <td style="color:var(--text-tertiary);font-size:10px;max-width:150px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">
            <%= (rowData.business_name || '').toLowerCase().replace(/[^a-z0-9]+/g, '-') + '-' + (rowData.city || '').toLowerCase().replace(/[^a-z0-9]+/g, '-') %>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<!-- Actions -->
<div style="display:flex;gap:var(--space-3);align-items:center">
  <% if(isValid && importData.status === 'validated') { %>
    <form action="/admin/csv-import/<%= importData.id %>/start" method="POST" onsubmit="return confirm('Start importing <%= stats.valid %> businesses? This will create new listings, calculate scores, and queue AI content generation.')">
      <button type="submit" class="btn btn-primary">
        <i class="ti ti-rocket"></i> Start Import (<%= stats.valid %> rows)
      </button>
    </form>
  <% } %>
  <a href="/admin/csv-import" class="btn btn-outline">
    <i class="ti ti-arrow-left"></i> Upload Different File
  </a>
</div>

<%- include('layout-bottom') %>
