<%- include('partials/header') %>

<% if (articleSchema) { %>
  <script type="application/ld+json">
    <%- JSON.stringify(articleSchema) %>
  </script>
<% } %>

<div class="section" style="max-width:800px;margin:0 auto">
  <!-- Article Header -->
  <header style="margin-bottom:var(--space-8);text-align:center">
    <div style="font-size:var(--font-size-sm);color:var(--accent-color);font-weight:600;margin-bottom:var(--space-4);text-transform:uppercase;letter-spacing:1px">
      <a href="/blog?category=<%= encodeURIComponent(post.category) %>" style="color:inherit;text-decoration:none"><%= post.category %></a>
    </div>
    
    <h1 style="font-size:42px;color:var(--text-primary);margin:0 0 var(--space-4) 0;line-height:1.2"><%= post.title %></h1>
    
    <div style="display:flex;align-items:center;justify-content:center;gap:var(--space-4);color:var(--text-secondary);font-size:var(--font-size-sm);flex-wrap:wrap">
      <div style="display:flex;align-items:center;gap:var(--space-2)">
        <div style="width:32px;height:32px;border-radius:50%;background:var(--navy);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:bold">
          <%= (post.author_name || 'BBI').charAt(0) %>
        </div>
        <span>By <strong><%= post.author_name || 'BBI Editorial Team' %></strong></span>
      </div>
      <span style="color:var(--border)">&bull;</span>
      <span>Published <%= new Date(post.published_at).toLocaleDateString('en-US', { month:'short', day:'numeric', year:'numeric' }) %></span>
      <% if (post.updated_at && new Date(post.updated_at).getTime() - new Date(post.published_at).getTime() > 86400000) { %>
        <span style="color:var(--border)">&bull;</span>
        <span>Updated <%= new Date(post.updated_at).toLocaleDateString('en-US', { month:'short', day:'numeric', year:'numeric' }) %></span>
      <% } %>
      <span style="color:var(--border)">&bull;</span>
      <% 
        const wordCount = post.content ? post.content.replace(/<[^>]*>?/gm, '').split(/\s+/).length : 0;
        const readTime = Math.max(1, Math.ceil(wordCount / 225));
      %>
      <span><i class="ti ti-clock" style="vertical-align:middle;margin-right:4px"></i><%= readTime %> min read</span>
    </div>
    
    <!-- Share Buttons -->
    <div style="display:flex;justify-content:center;gap:var(--space-2);margin-top:var(--space-4)">
      <a href="https://twitter.com/intent/tweet?url=<%= encodeURIComponent('https://bharatbusinessindex.com/blog/' + post.slug) %>&text=<%= encodeURIComponent(post.title) %>" target="_blank" rel="noopener" style="display:flex;align-items:center;justify-content:center;width:36px;height:36px;border-radius:50%;background:#f5f6f8;color:var(--text-secondary);transition:all 0.2s" aria-label="Share on Twitter" onmouseover="this.style.background='#1da1f2';this.style.color='#fff'" onmouseout="this.style.background='#f5f6f8';this.style.color='var(--text-secondary)'"><i class="ti ti-brand-twitter"></i></a>
      <a href="https://www.linkedin.com/shareArticle?mini=true&url=<%= encodeURIComponent('https://bharatbusinessindex.com/blog/' + post.slug) %>" target="_blank" rel="noopener" style="display:flex;align-items:center;justify-content:center;width:36px;height:36px;border-radius:50%;background:#f5f6f8;color:var(--text-secondary);transition:all 0.2s" aria-label="Share on LinkedIn" onmouseover="this.style.background='#0077b5';this.style.color='#fff'" onmouseout="this.style.background='#f5f6f8';this.style.color='var(--text-secondary)'"><i class="ti ti-brand-linkedin"></i></a>
      <a href="https://www.facebook.com/sharer/sharer.php?u=<%= encodeURIComponent('https://bharatbusinessindex.com/blog/' + post.slug) %>" target="_blank" rel="noopener" style="display:flex;align-items:center;justify-content:center;width:36px;height:36px;border-radius:50%;background:#f5f6f8;color:var(--text-secondary);transition:all 0.2s" aria-label="Share on Facebook" onmouseover="this.style.background='#1877f2';this.style.color='#fff'" onmouseout="this.style.background='#f5f6f8';this.style.color='var(--text-secondary)'"><i class="ti ti-brand-facebook"></i></a>
    </div>
  </header>

  <% if (post.featured_image) { %>
    <div style="border-radius:var(--radius-lg);overflow:hidden;margin-bottom:var(--space-8);box-shadow:var(--shadow-md)">
      <img src="<%= post.featured_image %>" alt="<%= post.title %>" style="width:100%;height:auto;display:block">
    </div>
  <% } %>

  <!-- Article Content -->
  <div class="content" style="font-size:18px;line-height:1.8;color:var(--text-primary);margin-bottom:var(--space-8)">
    <%- post.content %>
  </div>

  <!-- Tags -->
  <% if (post.tags) { %>
    <div style="display:flex;gap:var(--space-2);flex-wrap:wrap;margin-bottom:var(--space-8);padding-top:var(--space-4);border-top:1px solid var(--border-light)">
      <% post.tags.split(',').map(tag => tag.trim()).forEach(tag => { %>
        <span style="background:var(--bg-color);padding:4px 12px;border-radius:16px;font-size:var(--font-size-sm);color:var(--text-secondary)">#<%= tag %></span>
      <% }) %>
    </div>
  <% } %>

  <!-- Related Posts -->
  <% if (relatedPosts && relatedPosts.length > 0) { %>
    <div style="padding-top:var(--space-8);border-top:1px solid var(--border-light)">
      <h3 style="margin-top:0;margin-bottom:var(--space-6);font-size:24px">Related Articles</h3>
      <div class="grid">
        <% relatedPosts.forEach(rp => { %>
          <a href="/blog/<%= rp.slug %>" class="card" style="text-decoration:none;color:inherit;transition:transform 0.2s">
            <% if (rp.featured_image) { %>
              <div style="height:140px;border-radius:var(--radius-md) var(--radius-md) 0 0;overflow:hidden;margin:-var(--space-4) -var(--space-4) var(--space-4) -var(--space-4)">
                <img src="<%= rp.featured_image %>" alt="<%= rp.title %>" style="width:100%;height:100%;object-fit:cover">
              </div>
            <% } %>
            <div style="font-size:12px;color:var(--accent-color);font-weight:600;margin-bottom:var(--space-2)">
              <%= rp.category || 'Uncategorized' %>
            </div>
            <h4 style="margin:0 0 var(--space-2) 0;color:var(--text-primary)"><%= rp.title %></h4>
            <p style="margin:0;font-size:var(--font-size-sm);color:var(--text-secondary);display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden"><%= rp.excerpt %></p>
          </a>
        <% }) %>
      </div>
    </div>
  <% } %>
</div>

<script>
document.querySelectorAll('.card').forEach(card => {
  card.addEventListener('mouseenter', () => {
    card.style.transform = 'translateY(-4px)';
    card.style.boxShadow = 'var(--shadow-md)';
  });
  card.addEventListener('mouseleave', () => {
    card.style.transform = 'none';
    card.style.boxShadow = 'var(--shadow-sm)';
  });
});
</script>

<%- include('partials/footer') %>
