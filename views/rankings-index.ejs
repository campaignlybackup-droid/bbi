<%- include('partials/header') %>

<div class="page-header">
  <h1>Browse All Rankings</h1>
  <p>Independent, transparent business rankings across India's top cities and categories.</p>
</div>

<%- include('partials/trust-banner') %>

<div class="section">
  <% if(typeof customRankings !== 'undefined' && customRankings.length) { %>
  <div style="margin-bottom:var(--space-8)">
    <div class="section-label">Custom Rankings</div>
    <div class="section-title" style="margin-bottom:var(--space-4)">Featured curated lists</div>
    <div class="related-grid" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
      <% customRankings.forEach(cr => { %>
      <a href="/best/<%= cr.slug %>" class="rpc-card" style="display:flex;align-items:center;padding:16px;background:white;border:1px solid var(--border-light);border-radius:12px;text-decoration:none;color:var(--text-primary);transition:all 0.2s">
        <div style="flex:1">
          <div style="font-weight:600;font-size:15px;margin-bottom:4px"><%= cr.title %></div>
        </div>
        <i class="ti ti-chevron-right rpc-arrow" style="color:var(--text-muted)"></i>
      </a>
      <% }) %>
    </div>
  </div>
  <% } %>

  <div class="section-title" style="margin-bottom:var(--space-4)">City & Category Rankings</div>

  <!-- Filters -->
  <div class="search-filters">
    <select id="cityFilter" onchange="filterRankings()">
      <option value="">All Cities</option>
      <% cities.forEach(c => { %>
        <option value="<%= c.slug %>"><%= c.name %></option>
      <% }) %>
    </select>
    <select id="catFilter" onchange="filterRankings()">
      <option value="">All Categories</option>
      <% categories.forEach(cat => { %>
        <option value="<%= cat.slug %>"><%= cat.name %></option>
      <% }) %>
    </select>
  </div>

  <div class="rankings-count" id="rankingsCount"><%= combos.length %> ranking<%= combos.length !== 1 ? 's' : '' %> available</div>

  <% if (combos.length === 0) { %>
    <div class="rankings-empty">
      <i class="ti ti-folder-off"></i>
      <h3 style="font-weight:700;color:var(--text-primary);margin-bottom:var(--space-2)">No rankings available yet</h3>
      <p style="font-size:var(--font-size-sm)">Rankings will appear here as businesses are added and reviewed.</p>
    </div>
  <% } else { %>

  <%
    // Group combos by city
    const grouped = {};
    combos.forEach(combo => {
      if (!grouped[combo.city_slug]) {
        grouped[combo.city_slug] = { name: combo.city_name, slug: combo.city_slug, items: [] };
      }
      grouped[combo.city_slug].items.push(combo);
    });
    const cityGroups = Object.values(grouped);
  %>

  <div id="rankingsContainer">
    <% cityGroups.forEach(group => { %>
    <div class="rankings-list-group" data-city="<%= group.slug %>">
      <div class="rankings-list-group-title">
        <i class="ti ti-map-pin"></i>
        <a href="/city/<%= group.slug %>" style="color:inherit"><%= group.name %></a>
      </div>
      <div class="rankings-list-items">
        <% group.items.forEach(combo => { %>
        <a href="/rankings/<%= combo.city_slug %>/<%= combo.cat_slug %>" 
           class="ranking-page-card ranking-item" 
           data-city="<%= combo.city_slug %>" 
           data-cat="<%= combo.cat_slug %>">
          <div class="rpc-icon">
            <i class="ti <%= combo.icon || 'ti-star' %>"></i>
          </div>
          <div class="rpc-info">
            <div class="rpc-title">Top <%= combo.cat_name %></div>
            <div class="rpc-meta">in <%= combo.city_name %></div>
          </div>
          <i class="ti ti-chevron-right rpc-arrow"></i>
        </a>
        <% }) %>
      </div>
    </div>
    <% }) %>
  </div>

  <!-- No results message (hidden by default) -->
  <div class="rankings-empty" id="noResults" style="display:none">
    <i class="ti ti-search-off"></i>
    <h3 style="font-weight:700;color:var(--text-primary);margin-bottom:var(--space-2)">No rankings match your filters</h3>
    <p style="font-size:var(--font-size-sm)">Try adjusting your city or category selection.</p>
  </div>

  <% } %>
</div>

<script>
function filterRankings() {
  var city = document.getElementById('cityFilter').value;
  var cat = document.getElementById('catFilter').value;
  var items = document.querySelectorAll('.ranking-item');
  var groups = document.querySelectorAll('.rankings-list-group');
  var noResults = document.getElementById('noResults');
  var countEl = document.getElementById('rankingsCount');
  var visibleCount = 0;

  // Show/hide individual items
  items.forEach(function(item) {
    var itemCity = item.getAttribute('data-city');
    var itemCat = item.getAttribute('data-cat');
    var matchCity = !city || itemCity === city;
    var matchCat = !cat || itemCat === cat;

    if (matchCity && matchCat) {
      item.style.display = 'flex';
      visibleCount++;
    } else {
      item.style.display = 'none';
    }
  });

  // Show/hide city groups based on whether they have visible items
  groups.forEach(function(group) {
    var groupCity = group.getAttribute('data-city');
    if (city && groupCity !== city) {
      group.style.display = 'none';
    } else {
      var hasVisible = group.querySelectorAll('.ranking-item[style*="display: flex"], .ranking-item:not([style*="display: none"])').length > 0;
      // Re-check: count visible children
      var visibleChildren = 0;
      group.querySelectorAll('.ranking-item').forEach(function(item) {
        if (item.style.display !== 'none') visibleChildren++;
      });
      group.style.display = visibleChildren > 0 ? 'block' : 'none';
    }
  });

  // Update count and no-results
  if (countEl) countEl.textContent = visibleCount + ' ranking' + (visibleCount !== 1 ? 's' : '') + ' found';
  if (noResults) noResults.style.display = visibleCount === 0 ? 'block' : 'none';
}
</script>

<%- include('partials/footer') %>
