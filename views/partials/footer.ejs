<%# BBI — Shared Footer Partial %>

</main>
<footer>
  <div class="footer-inner">

    <%# === LATEST NEWS SECTION === %>
    <% if(typeof latestNews !== 'undefined' && latestNews.length > 0) { %>
    <div style="padding:var(--space-6) 0;border-bottom:1px solid rgba(255,255,255,0.08)">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:var(--space-4)">
        <div style="display:flex;align-items:center;gap:8px">
          <i class="ti ti-news" style="color:var(--gold);font-size:18px"></i>
          <span style="font-size:var(--font-size-sm);font-weight:700;color:white;text-transform:uppercase;letter-spacing:1px">Latest News & Updates</span>
        </div>
        <a href="/news" style="font-size:var(--font-size-xs);color:var(--gold);font-weight:600;display:flex;align-items:center;gap:4px">
          View All <i class="ti ti-arrow-right" style="font-size:12px"></i>
        </a>
      </div>
      <div style="display:grid;grid-template-columns:repeat(auto-fill, minmax(220px, 1fr));gap:12px">
        <% latestNews.forEach(news => { %>
        <a href="/news/<%= news.slug %>" style="display:block;padding:12px 16px;background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.06);border-radius:8px;transition:all 0.2s">
          <div style="font-size:var(--font-size-sm);color:rgba(255,255,255,0.9);font-weight:600;margin-bottom:4px;line-height:1.4;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden"><%= news.title %></div>
          <div style="font-size:var(--font-size-xs);color:rgba(255,255,255,0.4)">
            <i class="ti ti-clock" style="font-size:11px;margin-right:2px"></i>
            <% 
              const newsDate = new Date(news.created_at);
              const now = new Date();
              const diffMs = now - newsDate;
              const diffDays = Math.floor(diffMs / (1000 * 60 * 60 * 24));
              let timeAgo = '';
              if(diffDays === 0) timeAgo = 'Today';
              else if(diffDays === 1) timeAgo = 'Yesterday';
              else if(diffDays < 7) timeAgo = diffDays + ' days ago';
              else if(diffDays < 30) timeAgo = Math.floor(diffDays/7) + 'w ago';
              else timeAgo = newsDate.toLocaleDateString('en-IN', { day: 'numeric', month: 'short' });
            %>
            <%= timeAgo %>
          </div>
        </a>
        <% }) %>
      </div>
    </div>
    <% } %>

    <div class="footer-top">
      <div class="footer-brand">
        <div class="logo">BBI <span>·</span> Bharat Business Index</div>
        <p>India's trusted, independent business rankings. Updated monthly based on verified reviews and transparent methodology.</p>
      </div>
      <div class="footer-col">
        <div class="footer-col-title">Platform</div>
        <a href="/rankings">Rankings</a>
        <a href="/search">Search</a>
        <a href="/blog">Blog</a>
        <a href="/digest">Monthly Digest</a>
      </div>
      <div class="footer-col">
        <div class="footer-col-title">Company</div>
        <a href="/about">About Us</a>
        <a href="/methodology">Methodology</a>
        <a href="/get-listed">Get Listed</a>
      </div>
      <div class="footer-col">
        <div class="footer-col-title">Legal</div>
        <a href="/privacy-policy">Privacy Policy</a>
        <a href="/legal">Terms of Service</a>
      </div>
      <div class="footer-col">
        <div class="footer-col-title">Cities</div>
        <a href="/city/jaipur">Jaipur</a>
        <a href="/city/delhi">Delhi</a>
        <a href="/city/mumbai">Mumbai</a>
        <a href="/city/bangalore">Bangalore</a>
      </div>
    </div>
    <div class="footer-bottom">
      <div class="footer-copy">© <%= new Date().getFullYear() %> Bharat Business Index. Rankings are independent and never influenced by payments.</div>
      <div class="footer-legal">
        <a href="/privacy-policy">Privacy</a>
        <a href="/legal">Terms</a>
        <a href="/methodology">Methodology</a>
      </div>
    </div>
  </div>
</footer>

<%- include('mobile-nav') %>

<!-- Cookie Consent Banner -->
<div id="cookie-consent-banner" style="display:none;position:fixed;bottom:0;left:0;right:0;z-index:9999;background:#0D2E5E;color:#fff;padding:16px 20px;box-shadow:0 -4px 20px rgba(0,0,0,0.15);font-size:14px;line-height:1.5">
  <div style="max-width:1100px;margin:0 auto;display:flex;align-items:center;gap:16px;flex-wrap:wrap">
    <div style="flex:1;min-width:280px">
      <strong style="display:block;margin-bottom:4px">🍪 We value your privacy</strong>
      We use cookies for essential site functionality, analytics (Google Analytics), and to display relevant advertisements (Google AdSense). Advertising never affects our business rankings.
      <a href="/privacy-policy#cookies" style="color:#E8A020;margin-left:4px;text-decoration:underline">Learn more</a>
    </div>
    <div style="display:flex;gap:8px;flex-shrink:0">
      <button onclick="window.__bbiConsent.reject()" style="background:transparent;border:1px solid rgba(255,255,255,0.4);color:#fff;padding:8px 20px;border-radius:6px;cursor:pointer;font-size:14px;font-weight:600">Reject</button>
      <button onclick="window.__bbiConsent.accept()" style="background:#E8A020;border:none;color:#0D2E5E;padding:8px 20px;border-radius:6px;cursor:pointer;font-size:14px;font-weight:700">Accept All</button>
    </div>
  </div>
</div>
<script>
  // Show banner only if no consent has been recorded
  if (!window.__bbiConsent.hasConsented()) {
    document.getElementById('cookie-consent-banner').style.display = 'block';
  }
</script>

</body>
</html>
