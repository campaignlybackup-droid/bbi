<%# BBI — Shared Header Partial %>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title><%= typeof title !== 'undefined' ? title : (typeof globalSettings !== 'undefined' && globalSettings.site_title ? globalSettings.site_title : 'BBI — Bharat Business Index') %></title>
  <% if(typeof metaDescription !== 'undefined' && metaDescription) { %>
    <meta name="description" content="<%= metaDescription %>">
  <% } else if(typeof globalSettings !== 'undefined' && globalSettings.default_meta_description) { %>
    <meta name="description" content="<%= globalSettings.default_meta_description %>">
  <% } %>
  <% if(typeof canonicalUrl !== 'undefined') { %><link rel="canonical" href="<%= canonicalUrl %>"><% } %>

  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-YP8QCHTR1B"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', 'G-YP8QCHTR1B');
  </script>  <!-- Open Graph -->
  <meta property="og:title" content="<%= typeof title !== 'undefined' ? title : 'BBI' %>">
  <% if(typeof metaDescription !== 'undefined') { %><meta property="og:description" content="<%= metaDescription %>"><% } %>
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Bharat Business Index">
  <% if(typeof canonicalUrl !== 'undefined') { %><meta property="og:url" content="<%= canonicalUrl %>"><% } %>
  <% if(typeof ogImage !== 'undefined' && ogImage) { %>
  <meta property="og:image" content="<%= ogImage %>">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <% } %>

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= typeof title !== 'undefined' ? title : 'BBI' %>">
  <% if(typeof metaDescription !== 'undefined') { %><meta name="twitter:description" content="<%= metaDescription %>"><% } %>
  <% if(typeof ogImage !== 'undefined' && ogImage) { %><meta name="twitter:image" content="<%= ogImage %>"><% } %>

  <!-- Preconnect -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preconnect" href="https://cdn.jsdelivr.net">

  <link rel="stylesheet" href="/css/style.css">
  <link rel="preload" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css" as="style" onload="this.onload=null;this.rel='stylesheet'">
  <noscript><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css"></noscript>
  <link rel="icon" href="/favicon.ico" type="image/x-icon">
  <link rel="icon" href="/favicon.png" type="image/png">
</head>
<body>

<nav class="nav">
  <a href="/" class="nav-logo">BBI <span>·</span> Bharat Business Index</a>
  <button class="nav-toggle" id="nav-toggle-btn" aria-label="Menu" aria-expanded="false" aria-controls="nav-links">
    <i class="ti ti-menu-2" id="nav-toggle-icon"></i>
  </button>
  <div class="nav-links" id="nav-links" role="navigation">
    <a href="/rankings" <%= typeof currentPath !== 'undefined' && currentPath.startsWith('/rankings') ? 'aria-current="page"' : '' %>>Rankings</a>
    <a href="/city" <%= typeof currentPath !== 'undefined' && currentPath.startsWith('/city') ? 'aria-current="page"' : '' %>>Cities</a>
    <a href="/blog" <%= typeof currentPath !== 'undefined' && currentPath.startsWith('/blog') ? 'aria-current="page"' : '' %>>Blog</a>
    <a href="/get-listed" class="nav-cta" <%= typeof currentPath !== 'undefined' && currentPath === '/get-listed' ? 'aria-current="page"' : '' %>>Get Listed</a>
  </div>
</nav>

<main id="main-content">
<script>
  (function() {
    var btn = document.getElementById('nav-toggle-btn');
    var links = document.getElementById('nav-links');
    var icon = document.getElementById('nav-toggle-icon');
    if (!btn || !links) return;

    btn.addEventListener('click', function(e) {
      e.stopPropagation();
      var isOpen = links.classList.toggle('open');
      btn.setAttribute('aria-expanded', isOpen);
      icon.className = isOpen ? 'ti ti-x' : 'ti ti-menu-2';
    });

    // Close when clicking outside
    document.addEventListener('click', function(e) {
      if (!links.contains(e.target) && e.target !== btn) {
        links.classList.remove('open');
        btn.setAttribute('aria-expanded', 'false');
        icon.className = 'ti ti-menu-2';
      }
    });

    // Close on Escape key
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && links.classList.contains('open')) {
        links.classList.remove('open');
        btn.setAttribute('aria-expanded', 'false');
        icon.className = 'ti ti-menu-2';
        btn.focus();
      }
    });
  })();
</script>

