<%- include('partials/header') %>

<div class="section" style="max-width: 800px; margin: 0 auto; padding: var(--space-8) var(--space-4);">
  
  <article class="card" style="padding: var(--space-8); border-top: 4px solid var(--accent-color);">
    <div style="font-size:var(--font-size-sm);color:var(--accent-color);font-weight:600;margin-bottom:var(--space-2)">
      Published on <%= new Date(newsItem.created_at).toLocaleDateString('en-US', { month:'long', day:'numeric', year:'numeric' }) %>
    </div>
    
    <h1 style="margin:0 0 var(--space-6) 0;font-size:42px;line-height:1.2;color:var(--text-primary)"><%= newsItem.title %></h1>
    
    <% if (newsItem.image) { %>
      <div style="width:100%;border-radius:var(--radius-lg);overflow:hidden;margin-bottom:var(--space-6);background:var(--bg-color)">
        <img src="<%= newsItem.image %>" alt="<%= newsItem.title %>" style="width:100%;height:auto;display:block">
      </div>
    <% } %>
    
    <div class="content-body" style="font-size:var(--font-size-lg);line-height:1.8;color:var(--text-secondary)">
      <%- newsItem.content %>
    </div>
  </article>
  
  <% if (relatedNews && relatedNews.length > 0) { %>
    <div style="padding-top:var(--space-8);border-top:1px solid var(--border-light);margin-top:var(--space-8)">
      <h3 style="margin-top:0;margin-bottom:var(--space-6);font-size:24px">Related News</h3>
      <div class="grid">
        <% relatedNews.forEach(rn => { %>
          <a href="/news/<%= rn.slug %>" class="card" style="text-decoration:none;color:inherit;transition:transform 0.2s">
            <% if (rn.image) { %>
              <div style="height:140px;border-radius:var(--radius-md) var(--radius-md) 0 0;overflow:hidden;margin:-var(--space-4) -var(--space-4) var(--space-4) -var(--space-4)">
                <img src="<%= rn.image %>" alt="<%= rn.title %>" style="width:100%;height:100%;object-fit:cover">
              </div>
            <% } %>
            <div style="font-size:var(--font-size-xs);color:var(--text-muted);margin-bottom:var(--space-2)">
              <%= new Date(rn.created_at).toLocaleDateString('en-US', { month:'short', day:'numeric', year:'numeric' }) %>
            </div>
            <h4 style="margin:0;font-size:var(--font-size-md);color:var(--text-primary);line-height:1.4"><%= rn.title %></h4>
          </a>
        <% }) %>
      </div>
    </div>
  <% } %>

  <div style="margin-top:var(--space-8);text-align:center">
    <a href="/news" class="btn btn-outline"><i class="ti ti-arrow-left"></i> Back to News</a>
  </div>

</div>

<%- include('partials/footer') %>
