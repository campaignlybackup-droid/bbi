<%- include('partials/header') %>
<script type="application/ld+json"><%- JSON.stringify(breadcrumbSchema) %></script>

<div class="page-header">
  <div class="breadcrumb"><a href="/">Home</a> <span>/</span> <%= cat.name %></div>
  <h1>Best <%= cat.name %> in India</h1>
  <p>Rankings across <%= cityRankings.length %> cities</p>
</div>

<div class="section">
  <% if(cityRankings.length) { %>
  <div class="section-label">Browse by city</div>
  <div class="section-title" style="margin-bottom:var(--space-4)"><%= cat.name %> rankings</div>
  <div class="city-row">
    <% cityRankings.forEach(city => { %>
    <a href="/rankings/<%= city.slug || city.name.toLowerCase().replace(/ /g,'-') %>/<%= cat.slug %>" class="city-pill">
      <i class="ti ti-map-pin" style="font-size:14px;margin-right:4px;color:var(--navy)"></i>
      <%= city.name %> <span style="color:var(--text-muted);margin-left:4px">(<%= city.biz_count %>)</span>
    </a>
    <% }) %>
  </div>
  <% } %>

  <% if(topBusinesses.length) { %>
  <div style="margin-top:var(--space-6)">
    <div class="section-label">Top across India</div>
    <div class="section-title" style="margin-bottom:var(--space-4)">Highest ranked <%= cat.name %></div>
    <div class="rank-grid" style="grid-template-columns:1fr">
      <% topBusinesses.forEach(b => { %>
      <a href="/business/<%= b.slug %>" class="rcard">
        <div style="display:flex;justify-content:space-between;align-items:flex-start">
          <div>
            <div class="biz-name"><%= b.name %></div>
            <div class="biz-loc"><%= b.city_name %></div>
          </div>
          <div style="text-align:right">
            <% if(b.current_rank) { %><span class="rank-num" style="font-size:18px">#<%= b.current_rank %></span><% } %>
          </div>
        </div>
        <% if(b.google_rating) { %>
        <div style="font-size:var(--font-size-xs);color:var(--text-secondary);margin-top:var(--space-2)">
          <i class="ti ti-star-filled" style="color:var(--gold)"></i> <%= b.google_rating %> · <%= b.google_review_count %> reviews
        </div>
        <% } %>
      </a>
      <% }) %>
    </div>
  </div>
  <% } %>
</div>

<%- include('partials/footer') %>
