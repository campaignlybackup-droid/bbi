<%- include('partials/header') %>

<div class="hero" style="background: var(--navy); padding: var(--space-10) var(--space-4) var(--space-12); text-align: center; color: white;">
  <h1 style="font-size: var(--font-size-3xl); font-weight: 800; margin-bottom: var(--space-3); color: white;">Get Your Business Ranked</h1>
  <p style="font-size: var(--font-size-lg); color: rgba(255,255,255,0.85); max-width: 600px; margin: 0 auto;">Join thousands of businesses discovered by customers through India's most trusted independent ranking platform.</p>
</div>

<div class="section" style="max-width: 900px; margin-top: -60px; position: relative; z-index: 10;">
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: var(--space-4); margin-bottom: var(--space-8);">
    <div style="background: var(--bg-card); border-radius: var(--radius-lg); padding: var(--space-6); text-align: center; box-shadow: var(--shadow-md); border: 1px solid var(--border);">
      <div style="width: 48px; height: 48px; background: #eef2f8; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto var(--space-3);">
        <i class="ti ti-shield-check" style="color: var(--navy); font-size: 24px;"></i>
      </div>
      <h3 style="font-size: var(--font-size-md); font-weight: 700; margin-bottom: var(--space-2); color: var(--text-primary);">Verified Authority</h3>
      <p style="font-size: var(--font-size-sm); color: var(--text-secondary);">Earn a verified BBI Score that proves your credibility to customers.</p>
    </div>
    <div style="background: var(--bg-card); border-radius: var(--radius-lg); padding: var(--space-6); text-align: center; box-shadow: var(--shadow-md); border: 1px solid var(--border);">
      <div style="width: 48px; height: 48px; background: #eef2f8; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto var(--space-3);">
        <i class="ti ti-users" style="color: var(--navy); font-size: 24px;"></i>
      </div>
      <h3 style="font-size: var(--font-size-md); font-weight: 700; margin-bottom: var(--space-2); color: var(--text-primary);">Quality Leads</h3>
      <p style="font-size: var(--font-size-sm); color: var(--text-secondary);">Reach high-intent customers actively searching for the best businesses in your city and category.</p>
    </div>
    <div style="background: var(--bg-card); border-radius: var(--radius-lg); padding: var(--space-6); text-align: center; box-shadow: var(--shadow-md); border: 1px solid var(--border);">
      <div style="width: 48px; height: 48px; background: #eef2f8; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto var(--space-3);">
        <i class="ti ti-rocket" style="color: var(--navy); font-size: 24px;"></i>
      </div>
      <h3 style="font-size: var(--font-size-md); font-weight: 700; margin-bottom: var(--space-2); color: var(--text-primary);">SEO Value</h3>
      <p style="font-size: var(--font-size-sm); color: var(--text-secondary);">Get a dedicated, SEO-optimized profile indexed by Google, driving long-term organic traffic.</p>
    </div>
  </div>

  <div style="background: var(--info-bg); border: 1px solid var(--info-border); border-radius: var(--radius-md); padding: var(--space-4); margin-bottom: var(--space-8); display: flex; align-items: center; gap: var(--space-4);">
    <i class="ti ti-clock" style="font-size: 24px; color: var(--navy);"></i>
    <div>
      <strong style="color: var(--navy); font-size: var(--font-size-sm);">Timeline:</strong>
      <span style="font-size: var(--font-size-sm); color: var(--text-secondary);">Your profile will be reviewed within 24 hours. Once approved, it is indexed by Google within 48 hours. Your first BBI Rank will be calculated on the 1st of the next month.</span>
    </div>
  </div>

  <div style="max-width: 600px; margin: 0 auto;">
  <% if(typeof success !== 'undefined' && success && success.length) { %><div class="alert alert-success"><i class="ti ti-check"></i> <%= success %></div><% } %>
  <% if(typeof error !== 'undefined' && error && error.length) { %><div class="alert alert-error"><i class="ti ti-alert-circle"></i> <%= error %></div><% } %>

  <div class="form-card">
    <h3>Business Information</h3>
    <form method="POST" action="/get-listed">
      <div class="form-group">
        <label>Business Name *</label>
        <input type="text" name="business_name" required placeholder="e.g., ABC Auto Services" minlength="2">
      </div>
      <div class="form-row">
        <div class="form-group">
          <label>City *</label>
          <select name="city_id" required>
            <option value="">Select city</option>
            <% cities.forEach(c => { %><option value="<%= c.id %>"><%= c.name %></option><% }) %>
          </select>
        </div>
        <div class="form-group">
          <label>Category *</label>
          <select name="category_id" required>
            <option value="">Select category</option>
            <% categories.forEach(c => { %><option value="<%= c.id %>"><%= c.name %></option><% }) %>
          </select>
        </div>
      </div>
      <div class="form-group">
        <label>Website (optional)</label>
        <input type="url" name="website" placeholder="https://yourbusiness.com">
      </div>
      <div class="form-group">
        <label>Description (optional)</label>
        <textarea name="description" rows="3" placeholder="Brief description of your business" style="resize:vertical"></textarea>
      </div>

      <!-- Honeypot field for spam protection -->
      <div style="display:none;" aria-hidden="true">
        <label>Website Confirm (Do not fill this out)</label>
        <input type="text" name="website_confirm" tabindex="-1" autocomplete="off">
      </div>

      <h3 style="font-size:var(--font-size-sm);font-weight:700;color:var(--text-primary);margin-top:var(--space-6);padding-top:var(--space-4);border-top:1px solid var(--border-light);margin-bottom:var(--space-4)">Your Contact Details</h3>
      <div class="form-row">
        <div class="form-group">
          <label>Your Name *</label>
          <input type="text" name="contact_name" required placeholder="Full name" minlength="2">
        </div>
        <div class="form-group">
          <label>Phone *</label>
          <input type="tel" name="contact_phone" required placeholder="10-digit mobile" minlength="10">
        </div>
      </div>
      <div class="form-group">
        <label>Email *</label>
        <input type="email" name="contact_email" required placeholder="you@email.com">
      </div>

      <button type="submit" class="btn btn-accent btn-lg btn-block" style="margin-top:var(--space-4)">
        <i class="ti ti-send"></i> Submit for Review
      </button>
    </form>
  </div>

  <div style="background:var(--warn-bg);border:1px solid var(--warn-border);border-radius:var(--radius-md);padding:14px 18px;font-size:var(--font-size-sm);color:var(--warn-text);display:flex;gap:10px;align-items:center;margin-top:var(--space-4)">
    <i class="ti ti-info-circle" style="font-size:18px;flex-shrink:0"></i>
    Our team will review your business and add it to the index. Rankings are calculated independently — submitting a business does not guarantee any specific rank.
  </div>
</div>
</div>

<%- include('partials/footer') %>
