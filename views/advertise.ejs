<%- include('partials/header') %>

<div class="hero" style="background: var(--navy); padding: var(--space-10) var(--space-4) var(--space-12); text-align: center; color: white;">
  <h1 style="font-size: var(--font-size-3xl); font-weight: 800; margin-bottom: var(--space-3); color: white;">Advertise with BBI</h1>
  <p style="font-size: var(--font-size-lg); color: rgba(255,255,255,0.85); max-width: 600px; margin: 0 auto;">Reach high-intent customers actively searching for the best businesses in your city.</p>
</div>

<div class="section" style="max-width: 900px; margin-top: -60px; position: relative; z-index: 10;">
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: var(--space-4); margin-bottom: var(--space-8);">
    <div style="background: var(--bg-card); border-radius: var(--radius-lg); padding: var(--space-6); text-align: center; box-shadow: var(--shadow-md); border: 1px solid var(--border);">
      <div style="font-size: 36px; font-weight: 800; color: var(--gold); margin-bottom: var(--space-1);">100k+</div>
      <div style="font-size: var(--font-size-sm); color: var(--text-secondary); font-weight: 600; text-transform: uppercase;">Monthly Searches</div>
    </div>
    <div style="background: var(--bg-card); border-radius: var(--radius-lg); padding: var(--space-6); text-align: center; box-shadow: var(--shadow-md); border: 1px solid var(--border);">
      <div style="font-size: 36px; font-weight: 800; color: var(--gold); margin-bottom: var(--space-1);">250+</div>
      <div style="font-size: var(--font-size-sm); color: var(--text-secondary); font-weight: 600; text-transform: uppercase;">Cities Covered</div>
    </div>
    <div style="background: var(--bg-card); border-radius: var(--radius-lg); padding: var(--space-6); text-align: center; box-shadow: var(--shadow-md); border: 1px solid var(--border);">
      <div style="font-size: 36px; font-weight: 800; color: var(--gold); margin-bottom: var(--space-1);">High</div>
      <div style="font-size: var(--font-size-sm); color: var(--text-secondary); font-weight: 600; text-transform: uppercase;">Buyer Intent</div>
    </div>
  </div>

  <div style="text-align: center; margin-bottom: var(--space-8);">
    <h2 style="font-size: var(--font-size-2xl); font-weight: 800; color: var(--text-primary); margin-bottom: var(--space-2);">Sponsorship Placements</h2>
    <p style="font-size: var(--font-size-base); color: var(--text-secondary); max-width: 600px; margin: 0 auto;">We offer highly targeted sponsored placements to help you gain visibility among highly qualified buyers.</p>
  </div>

  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: var(--space-6); margin-bottom: var(--space-10);">
    <div style="background: var(--bg-card); border-radius: var(--radius-lg); padding: var(--space-8); border: 1px solid var(--border); position: relative; overflow: hidden;">
      <h3 style="font-size: var(--font-size-xl); font-weight: 800; color: var(--text-primary); margin-bottom: var(--space-2);">City Sponsor</h3>
      <div style="font-size: 32px; font-weight: 800; color: var(--navy); margin-bottom: var(--space-4);">Custom <span style="font-size: var(--font-size-sm); color: var(--text-secondary); font-weight: 400;">/ month</span></div>
      <ul style="list-style: none; padding: 0; margin: 0 0 var(--space-6); color: var(--text-secondary); font-size: var(--font-size-sm); line-height: 2;">
        <li><i class="ti ti-check" style="color: var(--success); margin-right: 8px;"></i> Sidebar placement on city pages</li>
        <li><i class="ti ti-check" style="color: var(--success); margin-right: 8px;"></i> Visible across all categories in the city</li>
        <li><i class="ti ti-check" style="color: var(--success); margin-right: 8px;"></i> Guaranteed impressions</li>
      </ul>
      <a href="#contact" class="btn btn-outline btn-block">Inquire</a>
    </div>

    <div style="background: var(--navy-dark); border-radius: var(--radius-lg); padding: var(--space-8); border: 1px solid var(--navy); color: white; position: relative; overflow: hidden; box-shadow: var(--shadow-lg);">
      <div style="position: absolute; top: 16px; right: -30px; background: var(--gold); color: white; font-size: 10px; font-weight: 800; text-transform: uppercase; padding: 4px 30px; transform: rotate(45deg);">Most Popular</div>
      <h3 style="font-size: var(--font-size-xl); font-weight: 800; margin-bottom: var(--space-2);">Category Sponsor</h3>
      <div style="font-size: 32px; font-weight: 800; color: var(--gold); margin-bottom: var(--space-4);">Custom <span style="font-size: var(--font-size-sm); color: rgba(255,255,255,0.7); font-weight: 400;">/ month</span></div>
      <ul style="list-style: none; padding: 0; margin: 0 0 var(--space-6); color: rgba(255,255,255,0.9); font-size: var(--font-size-sm); line-height: 2;">
        <li><i class="ti ti-check" style="color: var(--gold); margin-right: 8px;"></i> Premium placement above rankings</li>
        <li><i class="ti ti-check" style="color: var(--gold); margin-right: 8px;"></i> Highly targeted to user intent</li>
        <li><i class="ti ti-check" style="color: var(--gold); margin-right: 8px;"></i> Performance analytics included</li>
      </ul>
      <a href="#contact" class="btn btn-accent btn-block">Inquire</a>
    </div>
  </div>

  <div id="contact" style="background: var(--bg-card); border-radius: var(--radius-lg); padding: var(--space-8); box-shadow: var(--shadow-sm); border: 1px solid var(--border); max-width: 600px; margin: 0 auto;">
    <h3 style="font-size: var(--font-size-lg); font-weight: 800; color: var(--text-primary); margin-bottom: var(--space-4); text-align: center;">Contact Our Sales Team</h3>
    
    <% if(typeof success !== 'undefined' && success && success.length) { %><div class="alert alert-success"><i class="ti ti-check"></i> <%= success %></div><% } %>
    
    <form method="POST" action="/advertise">
      <div class="form-group">
        <label>Your Name *</label>
        <input type="text" name="name" required placeholder="Full name">
      </div>
      <div class="form-group">
        <label>Business Name *</label>
        <input type="text" name="business" required placeholder="Your company">
      </div>
      <div class="form-row">
        <div class="form-group">
          <label>Email *</label>
          <input type="email" name="email" required placeholder="you@company.com">
        </div>
        <div class="form-group">
          <label>Phone *</label>
          <input type="tel" name="phone" required placeholder="Phone number">
        </div>
      </div>
      <div class="form-group">
        <label>Target City & Category</label>
        <input type="text" name="target" placeholder="e.g. Restaurants in Mumbai">
      </div>
      <button type="submit" class="btn btn-primary btn-block btn-lg" style="margin-top: var(--space-2);">Submit Inquiry</button>
    </form>
  </div>
</div>

<%- include('partials/footer') %>
