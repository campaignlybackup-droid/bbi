<%- include('partials/header') %>
<% if (typeof organizationSchema !== 'undefined') { %>
<script type="application/ld+json"><%- JSON.stringify(organizationSchema) %></script>
<% } %>

<%- include('partials/trust-banner') %>

<%# === 1. HERO === %>
<div class="hero">
  <h1>India's most trusted<br>business rankings</h1>
  <p>Built to help customers choose with confidence.</p>
  <div style="display: flex; justify-content: center; margin-top: var(--space-6);">
    <a href="/rankings" class="btn btn-primary btn-lg"><i class="ti ti-search" style="font-size: 24px; margin-right: 8px;"></i> Search Rankings</a>
  </div>
</div>

<%# === 1B. LIVE STATS STRIP === %>
<% if(typeof globalStats !== 'undefined') { %>
<div style="background: var(--navy-dark); border-top: 1px solid rgba(255,255,255,0.05); padding: var(--space-4); text-align: center; color: var(--text-light); font-size: var(--font-size-sm); font-weight: 500; letter-spacing: 0.5px;">
  Live Data: <strong style="color: var(--gold);"><%= globalStats.businesses.toLocaleString() %></strong> businesses ranked across <strong style="color: var(--gold);"><%= globalStats.cities.toLocaleString() %></strong> cities
</div>
<% } %>

<%# === 1C. HOW SCORING WORKS === %>
<div class="section" style="padding-top: var(--space-10); padding-bottom: var(--space-4);">
  <div class="section-label" style="text-align: center;">Transparent Methodology</div>
  <h2 class="section-title" style="text-align: center; margin-bottom: var(--space-8);">How BBI scoring works</h2>
  <div class="trust-grid" style="text-align: left;">
    <div style="display: flex; gap: var(--space-4); align-items: flex-start;">
      <div style="background: #eef2f8; color: var(--navy); width: 48px; height: 48px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 24px; font-weight: 800; flex-shrink: 0;">1</div>
      <div>
        <h3 style="font-size: var(--font-size-md); font-weight: 700; color: var(--text-primary); margin-bottom: var(--space-1);">We aggregate data</h3>
        <p style="font-size: var(--font-size-sm); color: var(--text-secondary);">Our algorithm pulls Google reviews, ratings, and profile completeness points automatically.</p>
      </div>
    </div>
    <div style="display: flex; gap: var(--space-4); align-items: flex-start;">
      <div style="background: #eef2f8; color: var(--navy); width: 48px; height: 48px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 24px; font-weight: 800; flex-shrink: 0;">2</div>
      <div>
        <h3 style="font-size: var(--font-size-md); font-weight: 700; color: var(--text-primary); margin-bottom: var(--space-1);">We calculate scores</h3>
        <p style="font-size: var(--font-size-sm); color: var(--text-secondary);">Businesses are scored out of 100 based on a strict, mathematical formula.</p>
      </div>
    </div>
    <div style="display: flex; gap: var(--space-4); align-items: flex-start;">
      <div style="background: #eef2f8; color: var(--navy); width: 48px; height: 48px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 24px; font-weight: 800; flex-shrink: 0;">3</div>
      <div>
        <h3 style="font-size: var(--font-size-md); font-weight: 700; color: var(--text-primary); margin-bottom: var(--space-1);">We rank independently</h3>
        <p style="font-size: var(--font-size-sm); color: var(--text-secondary);">The highest scores rank at the top. Our editorial team ensures strict quality control.</p>
      </div>
    </div>
  </div>
</div>

<%# === 2. POPULAR CATEGORIES === %>
<% if(topCategories && topCategories.length) { %>
<div class="section">
  <div class="section-label">Browse by category</div>
  <h2 class="section-title" style="margin-bottom:var(--space-5)">Popular categories</h2>
  <div class="cat-grid">
    <% topCategories.slice(0, 8).forEach(cat => { %>
    <a href="/category/<%= cat.slug %>" class="cat-card">
      <div class="cat-icon"><i class="ti <%= cat.icon %>"></i></div>
      <div class="cat-name"><%= cat.name %></div>
      <% if(cat.biz_count) { %><div class="cat-count"><%= cat.biz_count %> businesses</div><% } %>
    </a>
    <% }) %>
  </div>
</div>
<% } %>

<%# === 3. FEATURED RANKINGS === %>
<% if(featuredRankings && featuredRankings.length) { %>
<div class="section section-lazy">
  <div class="section-label">Featured rankings</div>
  <h2 class="section-title" style="margin-bottom:var(--space-5)">Top ranking pages</h2>
  <div class="rank-grid">
    <% featuredRankings.slice(0, 6).forEach(r => { %>
    <a href="/rankings/<%= r.city_slug %>/<%= r.cat_slug %>" class="ranking-page-card">
      <div class="rpc-icon"><i class="ti <%= r.cat_icon || 'ti-trophy' %>"></i></div>
      <div class="rpc-info">
        <div class="rpc-title"><%= r.cat_name %> in <%= r.city_name %></div>
        <div class="rpc-meta"><%= r.biz_count %> businesses ranked</div>
      </div>
      <i class="ti ti-chevron-right rpc-arrow"></i>
    </a>
    <% }) %>
  </div>
</div>
<% } %>

<%# === 3B. CUSTOM RANKINGS === %>
<% if(typeof customRankings !== 'undefined' && customRankings.length) { %>
<div class="section section-lazy">
  <div class="section-label">Custom Rankings</div>
  <h2 class="section-title" style="margin-bottom:var(--space-5)">Featured lists</h2>
  <div class="related-grid" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
    <% customRankings.forEach(cr => { %>
    <a href="/best/<%= cr.slug %>" class="rpc-card" style="display:flex;align-items:center;padding:16px;background:white;border:1px solid var(--border-light);border-radius:12px;text-decoration:none;color:var(--text-primary);transition:all 0.2s">
      <div style="flex:1">
        <div style="font-weight:600;font-size:15px;margin-bottom:4px"><%= cr.title %></div>
        <div style="font-size:13px;color:var(--text-secondary)"><%= cr.description ? cr.description.substring(0, 50) + '...' : 'View rankings' %></div>
      </div>
      <i class="ti ti-chevron-right rpc-arrow" style="color:var(--text-muted)"></i>
    </a>
    <% }) %>
  </div>
</div>
<% } %>

<%# === 4. WHY TRUST BBI === %>
<div class="section section-lazy">
  <div class="section-label">Why trust BBI</div>
  <h2 class="section-title" style="margin-bottom:var(--space-5)">How we ensure ranking integrity</h2>
  <div class="trust-grid">
    <div class="trust-card">
      <i class="ti ti-shield-check"></i>
      <h3>Independent Rankings</h3>
      <p>Rankings are never influenced by payments. Sponsored listings are clearly labeled and never affect positions.</p>
    </div>
    <div class="trust-card">
      <i class="ti ti-chart-bar"></i>
      <h3>Transparent Methodology</h3>
      <p>Our scoring system is fully published. Every business can see exactly how their ranking is calculated.</p>
    </div>
    <div class="trust-card">
      <i class="ti ti-refresh"></i>
      <h3>Updated Monthly</h3>
      <p>Fresh rankings on the 1st of every month based on the latest verified reviews and quality metrics.</p>
    </div>
  </div>
</div>

<%# === 5. CITIES WE COVER === %>
<% if(topCities && topCities.length) { %>
<div class="section section-lazy">
  <div class="section-label">Cities we cover</div>
  <h2 class="section-title" style="margin-bottom:var(--space-5)">Top cities</h2>
  <div class="city-grid">
    <% topCities.slice(0, 8).forEach(city => { %>
    <a href="/city/<%= city.slug || city.name.toLowerCase().replace(/ /g,'-') %>" class="city-card">
      <div class="city-card-name"><%= city.name %></div>
      <div class="city-card-state"><%= city.state %></div>
      <% if(city.biz_count) { %><div class="city-card-count"><%= city.biz_count %> businesses</div><% } %>
    </a>
    <% }) %>
  </div>
</div>
<% } %>

<%# === 6. GET LISTED CTA === %>
<div class="cta-section">
  <h2>Get your business ranked</h2>
  <p>Submit your business for inclusion in Bharat Business Index. Free listing, independent rankings.</p>
  <a href="/get-listed" class="cta-btn"><i class="ti ti-plus"></i> Get Listed </a>
</div>

<%# === 7. FOOTER === %>
<%- include('partials/footer') %>
