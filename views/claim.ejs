<%- include('partials/header') %>

<div class="page-header">
  <h1>Claim <%= business.name %></h1>
  <p><%= business.cat_name %> · <%= business.city_name %></p>
</div>

<div class="section" style="max-width:600px">
  <% if(typeof success !== 'undefined' && success && success.length) { %>
    <div class="alert alert-success"><i class="ti ti-check"></i> <%= success %></div>
    
    <!-- Upsell Message -->
    <div style="background: var(--navy); color: white; border-radius: var(--radius-lg); padding: var(--space-6); margin-top: var(--space-6); text-align: center;">
      <h3 style="font-size: var(--font-size-lg); font-weight: 800; margin-bottom: var(--space-2);">Want to guarantee visibility?</h3>
      <p style="font-size: var(--font-size-sm); color: rgba(255,255,255,0.85); margin-bottom: var(--space-4);">While you wait for your claim to be verified, explore our sponsorship options to get premium placement in <%= business.city_name %>.</p>
      <a href="/advertise" class="btn btn-accent">View Sponsorship Options</a>
    </div>
  <% } else { %>
  <% if(typeof error !== 'undefined' && error && error.length) { %><div class="alert alert-error"><i class="ti ti-alert-circle"></i> <%= error %></div><% } %>

  <div class="form-card">
    <h3>Verify Your Ownership</h3>
    <p style="font-size:var(--font-size-sm);color:var(--text-secondary);margin-bottom:var(--space-4)">
      Claiming your business allows you to manage your listing details. Our team will verify your identity before approving the claim.
    </p>
    <form method="POST" action="/business/<%= business.slug %>/claim">
      <div class="form-row">
        <div class="form-group">
          <label>Your Name *</label>
          <input type="text" name="contact_name" required placeholder="Full name" minlength="2">
        </div>
        <div class="form-group">
          <label>Phone *</label>
          <input type="tel" name="contact_phone" required placeholder="10-digit mobile" minlength="10">
        </div>
      </div>
      <div class="form-group">
        <label>Email *</label>
        <input type="email" name="contact_email" required placeholder="your@email.com">
      </div>
      <div class="form-group">
        <label>How can we verify you own this business? *</label>
        <textarea name="verification_details" rows="3" required placeholder="e.g., I am the owner and can be reached at the business phone number, or I can provide registration documents." style="resize:vertical" minlength="10"></textarea>
      </div>
      <button type="submit" class="btn btn-accent btn-lg btn-block">
        <i class="ti ti-shield-check"></i> Submit Claim
      </button>
    </form>
  </div>
  <% } %>
</div>

<%- include('partials/footer') %>
