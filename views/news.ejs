<%- include('partials/header') %>

<div class="page-header" style="background:var(--card-bg);padding:var(--space-8) var(--space-4);text-align:center;border-bottom:1px solid var(--border-light)">
  <h1 style="margin:0 0 var(--space-2) 0;font-size:36px;color:var(--text-primary)">Daily News</h1>
  <p style="margin:0;color:var(--text-muted);font-size:var(--font-size-lg)">The latest news and updates from Bharat Business Index.</p>
</div>

<div class="section" style="max-width: 800px; margin: 0 auto; padding: var(--space-8) var(--space-4);">
  
  <% if (newsList.length === 0) { %>
    <div style="text-align:center;padding:var(--space-8);color:var(--text-muted);background:var(--card-bg);border-radius:var(--radius-lg)">
      <i class="ti ti-news" style="font-size:48px;margin-bottom:var(--space-4);opacity:0.5"></i>
      <h3>No news articles yet.</h3>
      <p>Check back soon for the latest updates.</p>
    </div>
  <% } else { %>
    <div style="display:flex;flex-direction:column;gap:var(--space-6)">
      <% newsList.forEach(item => { %>
        <article class="card" style="display:flex;flex-direction:column;gap:var(--space-4);padding:var(--space-6);transition:transform 0.2s">
          <% if (item.image) { %>
            <div style="width:100%;height:300px;border-radius:var(--radius-md);overflow:hidden;background:var(--bg-color);margin-bottom:var(--space-2)">
              <img src="<%= item.image %>" alt="<%= item.title %>" style="width:100%;height:100%;object-fit:cover">
            </div>
          <% } %>
          <div style="display:flex;flex-direction:column;">
            <div style="font-size:var(--font-size-sm);color:var(--accent-color);font-weight:600;margin-bottom:var(--space-2)">
              <%= new Date(item.created_at).toLocaleDateString('en-US', { month:'short', day:'numeric', year:'numeric' }) %>
            </div>
            <h2 style="margin:0 0 var(--space-2) 0;font-size:var(--font-size-xl)">
              <a href="/news/<%= item.slug %>" style="color:var(--text-primary);text-decoration:none"><%= item.title %></a>
            </h2>
            <p style="margin:0 0 var(--space-4) 0;color:var(--text-secondary);line-height:1.5">
              <%= item.content.replace(/<[^>]+>/g, '').substring(0, 150) %>...
            </p>
            <div style="margin-top:auto">
              <a href="/news/<%= item.slug %>" style="color:var(--accent-color);font-weight:600;text-decoration:none;display:inline-flex;align-items:center;gap:4px">
                Read More <i class="ti ti-arrow-right"></i>
              </a>
            </div>
          </div>
        </article>
      <% }) %>
    </div>
  <% } %>

</div>

<script>
document.querySelectorAll('article.card').forEach(card => {
  card.addEventListener('mouseenter', () => {
    card.style.transform = 'translateY(-4px)';
    card.style.boxShadow = 'var(--shadow-md)';
  });
  card.addEventListener('mouseleave', () => {
    card.style.transform = 'none';
    card.style.boxShadow = 'var(--shadow-sm)';
  });
});
</script>

<%- include('partials/footer') %>
