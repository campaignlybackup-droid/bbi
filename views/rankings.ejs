<%- include('partials/header') %>

<script type="application/ld+json"><%- JSON.stringify(itemListSchema) %></script>
<script type="application/ld+json"><%- JSON.stringify(breadcrumbSchema) %></script>
<% if(typeof faqSchema !== 'undefined' && faqSchema) { %>
<script type="application/ld+json"><%- JSON.stringify(faqSchema) %></script>
<% } %>

<div class="page-header">
  <div class="breadcrumb">
    <a href="/">Home</a> <span>/</span>
    <a href="/city/<%= city.slug || city.name.toLowerCase().replace(/ /g,'-') %>"><%= city.name %></a> <span>/</span>
    <%= cat.name %>
  </div>
  <h1>Top <%= cat.name %> in <%= city.name %></h1>
  <p><%= latest_date || 'Latest' %> · <%= rankings.length %> businesses ranked · Updated monthly</p>
</div>

<div class="section">

  <% if(gainers.length || decliners.length) { %>
  <div style="display:grid;grid-template-columns:1fr;gap:var(--space-3);margin-bottom:var(--space-6)" class="movers-grid">
    <% if(gainers.length) { %>
    <div class="profile-card" style="margin-bottom:0">
      <div class="profile-card-title" style="color:var(--success)"><i class="ti ti-trending-up"></i> Biggest Gainers</div>
      <% gainers.forEach(b => { %>
      <div style="display:flex;justify-content:space-between;align-items:center;padding:8px 0;border-bottom:1px solid var(--border-light);font-size:13px">
        <a href="/business/<%= b.slug %>" style="color:var(--text-primary);font-weight:600"><%= b.name %></a>
        <span class="move move-up">↑ +<%= b.movement.diff %></span>
      </div>
      <% }) %>
    </div>
    <% } %>
    <% if(decliners.length) { %>
    <div class="profile-card" style="margin-bottom:0">
      <div class="profile-card-title" style="color:var(--error)"><i class="ti ti-trending-down"></i> Biggest Decliners</div>
      <% decliners.forEach(b => { %>
      <div style="display:flex;justify-content:space-between;align-items:center;padding:8px 0;border-bottom:1px solid var(--border-light);font-size:13px">
        <a href="/business/<%= b.slug %>" style="color:var(--text-primary);font-weight:600"><%= b.name %></a>
        <span class="move move-down">↓ −<%= b.movement.diff %></span>
      </div>
      <% }) %>
    </div>
    <% } %>
  </div>
  <% } %>

  <!-- Rankings list as cards on mobile -->
  <div class="rank-grid" style="grid-template-columns:1fr">
    <% rankings.forEach(b => { %>
    <article>
    <a href="/business/<%= b.slug %>" class="rcard">
      <div class="rcard-top">
        <div class="rank-num">#<%= b.rank_position %></div>
        <div style="display:flex;gap:var(--space-2);align-items:center;flex-wrap:wrap">
          <span class="move move-<%= b.movement.direction %>"><%= b.movement.label %></span>
          <% if(b.badge) { %><span class="badge badge-gold"><%= b.badge %></span><% } %>
        </div>
      </div>
      <h2 class="biz-name" style="margin:0;font-size:inherit;font-weight:inherit;line-height:inherit;">
        <%= b.name %>
        <% if(b.sponsored) { %><span class="tag-sponsored" style="margin-left:6px">Sponsored</span><% } %>
        <% if(b.verified) { %><span class="tag-verified" style="margin-left:4px">Verified</span><% } %>
      </h2>
      <div class="biz-loc"><%= b.address || city.name %></div>
      <% if(b.google_rating) { %>
      <div style="font-size:12px;color:var(--text-secondary);margin-bottom:8px">
        <i class="ti ti-star-filled" style="color:var(--gold);font-size:14px"></i> <%= b.google_rating %> · <%= b.google_review_count %> reviews
      </div>
      <% } %>
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:5px">
        <span class="score-label">Ranking score</span>
        <span class="score-val"><%= Math.round(b.final_score) %> / 100</span>
      </div>
      <div class="score-track"><div class="score-fill score-fill-navy" style="width:<%= b.final_score %>%"></div></div>
    </a>
    </article>
    <% }) %>
  </div>

  <% if(!rankings.length) { %>
  <div class="profile-card text-center" style="padding:var(--space-10)">
    <i class="ti ti-mood-empty" style="font-size:36px;color:var(--text-muted)"></i>
    <div style="font-size:var(--font-size-base);font-weight:600;color:var(--text-primary);margin-top:var(--space-3)">No rankings yet</div>
    <div style="font-size:var(--font-size-sm);color:var(--text-secondary);margin-top:var(--space-1)">Rankings for this category in <%= city.name %> will appear after the next monthly update.</div>
  </div>
  </div>
  <% } %>

  <!-- Editorial Content & FAQs -->
  <div style="margin-top:var(--space-8); background: #f9fbfd; padding: var(--space-6); border-radius: 16px; border: 1px solid var(--border-light);">
    <% if(typeof seoContent !== 'undefined' && seoContent && seoContent.editorial_content) { %>
      <div class="article-content" style="line-height: 1.7; color: var(--text-secondary);">
        <%- seoContent.editorial_content %>
      </div>
    <% } else if (rankings && rankings.length > 0) { %>
      <% 
        const avgScore = Math.round(rankings.reduce((sum, r) => sum + r.final_score, 0) / rankings.length);
        const totalReviews = rankings.reduce((sum, r) => sum + (r.google_review_count || 0), 0);
        const avgRating = rankings.reduce((sum, r) => sum + (r.google_rating || 0), 0) / rankings.filter(r => r.google_rating).length;
      %>
      <div class="article-content" style="line-height: 1.7; color: var(--text-secondary);">
        <h3 style="margin-top: 0; color: var(--text-primary); font-size: 20px;">About the <%= city.name %> <%= cat.name %> Rankings</h3>
        <p style="margin-bottom: 12px;">Bharat Business Index has evaluated <strong><%= rankings.length %></strong> top <%= cat.name.toLowerCase() %> in <%= city.name %> for our latest monthly update. The businesses featured in this ranking maintain an average BBI score of <strong><%= avgScore %>/100</strong>.</p>
        <% if (totalReviews > 0) { %>
        <p style="margin-bottom: 12px;">Our scoring methodology analyzes real customer experiences. For this category, we processed over <strong><%= totalReviews.toLocaleString() %></strong> verified customer reviews, with ranked businesses maintaining an average Google rating of <strong><%= isNaN(avgRating) ? '4.0' : avgRating.toFixed(1) %> stars</strong>.</p>
        <% } %>
        <h4 style="margin-top: 16px; margin-bottom: 8px; font-size: 16px; color: var(--text-primary);">How we rank businesses</h4>
        <p style="margin-bottom: 0;">Unlike directories that allow paid placements, BBI rankings are strictly independent and data-driven. Every business is scored across six weighted metrics: Customer Reviews (35%), Review Volume (25%), Website & Online Presence (15%), Verification Status (10%), Profile Completeness (10%), and Editorial Assessment (15%). No business can purchase a higher rank.</p>
      </div>
    <% } else { %>
      <div class="article-content" style="line-height: 1.7; color: var(--text-secondary);">
        <h3 style="margin-top: 0; color: var(--text-primary); font-size: 20px;">About the <%= city.name %> <%= cat.name %> Rankings</h3>
        <p style="margin-bottom: 12px;">Bharat Business Index evaluates <%= cat.name.toLowerCase() %> across <%= city.name %> using a strict, independent scoring methodology. We analyze customer reviews, digital presence, and profile completeness to generate our monthly rankings.</p>
        <p style="margin-bottom: 0;">Unlike directories that allow paid placements, BBI rankings are strictly independent and data-driven. Every business is scored across six weighted metrics, ensuring that rankings cannot be purchased.</p>
      </div>
    <% } %>
  </div>

  <% if(typeof seoContent !== 'undefined' && seoContent && seoContent.faqs && seoContent.faqs.length > 0) { %>
  <div style="margin-top:var(--space-8);">
    <h2 style="font-size: 24px; font-weight: 700; color: var(--navy); margin-bottom: var(--space-4);">Frequently Asked Questions</h2>
    <div class="faq-accordion">
      <% seoContent.faqs.forEach(faq => { %>
        <div class="faq-item" style="border-bottom: 1px solid var(--border-light); padding: var(--space-3) 0;">
          <h3 style="font-size: 16px; font-weight: 600; color: var(--text-primary); margin: 0 0 8px 0;"><%= faq.question %></h3>
          <p style="font-size: 15px; color: var(--text-secondary); margin: 0; line-height: 1.5;"><%= faq.answer %></p>
        </div>
      <% }) %>
    </div>
  </div>
  <% } %>

  <!-- Related Rankings -->
  <% if(typeof relatedRankings !== 'undefined' && relatedRankings.length) { %>
  <div style="margin-top:var(--space-8)">
    <div class="section-label">Related rankings</div>
    <div class="section-title" style="margin-bottom:var(--space-4)">More rankings to explore</div>
    <div class="related-grid">
      <% relatedRankings.forEach(r => { %>
      <a href="/rankings/<%= r.city_slug %>/<%= r.cat_slug %>" class="cat-card" style="text-align:left;padding:var(--space-4)">
        <div class="cat-name"><%= r.cat_name %></div>
        <div class="cat-count"><%= r.city_name %> · <%= r.biz_count %> businesses</div>
      </a>
      <% }) %>
    </div>
  </div>
  <% } %>

</div>

<%- include('partials/footer') %>
